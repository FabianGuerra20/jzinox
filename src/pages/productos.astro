---
/**
 * PROPUESTA (rama B): /productos se fusiona con /catalogo.
 *
 * Las dos páginas recorrían el mismo array con las mismas categorías y los
 * mismos 15 ítems; /catalogo además traía precio, etiqueta y navegación por
 * anclas. Mantener ambas significa que dos URLs propias compiten por las mismas
 * búsquedas y se quitan relevancia, y que cada cambio de producto hay que
 * hacerlo dos veces.
 *
 * La URL se conserva como redirección para no romper enlaces entrantes ni lo
 * que Google ya tenga indexado. La redirección es de servidor cuando hay uno;
 * el meta refresh es el respaldo para la maqueta abierta con file://, donde no
 * hay servidor que emita el 301.
 */
import Layout from "../layouts/Layout.astro";
---

<Layout
	title="Productos"
	description="El catálogo de productos de JZINOX vive ahora en una sola página."
	noindex
>
	<meta http-equiv="refresh" content="0; url=/catalogo" slot="head" />

	<section class="section page-hero">
		<div class="container">
			<h1>El catálogo se mudó</h1>
			<p>
				Ahora todo lo que fabricamos está en una sola página, con sus valores
				referenciales. Si no te redirige solo, entra desde aquí.
			</p>
			<p style="margin-top:1.5rem">
				<a href="/catalogo" class="btn btn--primary">Ir al catálogo</a>
			</p>
		</div>
	</section>
</Layout>
