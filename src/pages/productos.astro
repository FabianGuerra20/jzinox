---
import Layout from "../layouts/Layout.astro";
import { catalog, catalogCategories } from "../data/catalog.js";
import { site } from "../data/site.js";

const categories = catalogCategories
	.filter((category) => category !== "Todos")
	.map((category) => ({
		name: category,
		items: catalog.filter((item) => item.category === category),
	}))
	.filter((group) => group.items.length > 0);
---

<Layout
	title="Productos"
	description="Mesones, lavaplatos, campanas de extracción, estanterías y estructuras en acero inoxidable, fabricados a medida en Santiago."
>
	<section class="section page-hero">
		<div class="container">
			<span class="eyebrow">Productos</span>
			<h1>Todo lo que fabricamos en acero inoxidable</h1>
			<p>
				Cada pieza se fabrica sobre el levantamiento de tu espacio. Si lo que necesitas no
				está en la lista, lo hacemos igual: mándanos el plano o las medidas.
			</p>
		</div>
	</section>

	{
		categories.map((group, index) => (
			<section class:list={["section", { "section--alt": index % 2 === 0 }]}>
				<div class="container">
					<div class="group-head">
						<h2>{group.name}</h2>
						<a
							href="/catalogo"
							class="group-head__link"
							aria-label={`Ver precios referenciales de ${group.name}`}
						>
							Ver precios referenciales
						</a>
					</div>

					<div class="bento bento--3">
						{group.items.map((item) => (
							<article class="bento__cell bento__cell--hover product-card">
								<h3>{item.name}</h3>
								<p>{item.description}</p>
								<a
									href={`https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent(`Hola JZINOX, me interesa cotizar: ${item.name}`)}`}
									target="_blank"
									rel="noopener noreferrer"
									class="product-card__cta"
									aria-label={`Cotizar por WhatsApp: ${item.name}`}
								>
									Cotizar por WhatsApp
								</a>
							</article>
						))}
					</div>
				</div>
			</section>
		))
	}

	<section class="section section--steel cta-band">
		<div class="container cta-band__inner">
			<div>
				<h2>¿No está en la lista?</h2>
				<p>Fabricamos a medida según tus planos o el levantamiento que hagamos en terreno.</p>
			</div>
			<div class="cta-band__actions">
				<a href="/contacto" class="btn btn--primary">Cotizar Proyecto</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	.group-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.6rem;
		margin-bottom: 1.8rem;
		padding-bottom: 0.8rem;
		border-bottom: 1px solid var(--color-border);
	}

	.group-head h2 {
		margin-bottom: 0;
	}

	.group-head__link {
		display: inline-flex;
		align-items: center;
		min-height: var(--tap);
		font-size: 0.88rem;
		font-weight: 600;
		color: var(--color-accent);
	}

	.group-head__link:hover {
		text-decoration: underline;
	}

	.product-card {
		display: flex;
		flex-direction: column;
	}

	.product-card h3 {
		font-size: 1.05rem;
	}

	/* flex-grow (no `flex: 1`) para empujar el CTA al pie de la placa: con
	   flex-basis 0 el párrafo deja de aportar su altura al cálculo intrínseco
	   de la fila del grid y el texto se comprime en la celda más alta. */
	.product-card p {
		font-size: 0.92rem;
		flex-grow: 1;
		/* La celda del último renglón puede ocupar 2 o 3 columnas (ver abajo).
		   Sin tope, la descripción llegaría a ~150 caracteres por línea. 62ch
		   es la misma medida que .page-hero p. */
		max-width: 62ch;
	}

	/* =========================================================
	   El último renglón siempre completa la placa
	   ---------------------------------------------------------
	   La junta del bento es el fondo del contenedor asomando por el
	   `gap`. Con un número variable de productos por categoría (2, 3 y 4
	   en el catálogo actual) el último renglón dejaba columnas vacías, y
	   esas columnas se pintaban como bloques grises dentro de la placa:
	   un agujero, no un ensamblaje. Que el último producto ocupe las
	   columnas libres cierra la placa y es, además, el gesto propio de un
	   bento: celdas de distinto ancho, nunca huecos.
	   ========================================================= */
	@media (min-width: 640px) and (max-width: 1023.98px) {
		/* 2 columnas: si el último producto queda solo, toma el renglón */
		.product-card:nth-child(odd):last-child {
			grid-column: span 2;
		}
	}

	@media (min-width: 1024px) {
		/* 3 columnas: sobra 1 hueco → span 2; sobran 2 → span 3 */
		.product-card:nth-child(3n + 2):last-child {
			grid-column: span 2;
		}

		.product-card:nth-child(3n + 1):last-child {
			grid-column: span 3;
		}
	}

	/* Es el CTA de conversión de la página: tiene que ser un objetivo táctil
	   real de 44px, no las ~22px que daba el line-height solo. */
	.product-card__cta {
		display: inline-flex;
		align-items: center;
		align-self: flex-start; /* si no, se estira a todo el ancho de la placa */
		min-height: var(--tap);
		font-size: 0.88rem;
		font-weight: 600;
		color: var(--color-accent);
	}

	.product-card__cta:hover {
		text-decoration: underline;
	}
</style>
