---
import Layout from "../layouts/Layout.astro";
import { catalog, catalogCategories } from "../data/catalog.js";
import { site } from "../data/site.js";

const categories = catalogCategories
	.filter((category) => category !== "Todos")
	.map((category) => ({
		name: category,
		items: catalog.filter((item) => item.category === category),
	}))
	.filter((group) => group.items.length > 0);
---

<Layout
	title="Productos"
	description="Mesones, lavaplatos, campanas de extracción, estanterías y estructuras en acero inoxidable fabricadas a medida por JZINOX."
>
	<section class="section page-hero">
		<div class="container">
			<span class="eyebrow">Productos</span>
			<h1>Todo lo que fabricamos en acero inoxidable</h1>
			<p>
				Cada pieza se fabrica a medida sobre el levantamiento de tu cocina. Si no ves lo que
				necesitas, lo hacemos igual: envíanos el plano o las medidas.
			</p>
		</div>
	</section>

	{
		categories.map((group, index) => (
			<section class:list={["section", { "section--alt": index % 2 === 0 }]}>
				<div class="container">
					<div class="group-head">
						<h2>{group.name}</h2>
						<a href="/catalogo" class="group-head__link">Ver precios referenciales</a>
					</div>

					<div class="bento bento--3">
						{group.items.map((item) => (
							<article class="bento__cell bento__cell--hover product-card">
								<h3>{item.name}</h3>
								<p>{item.description}</p>
								<a
									href={`https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent(`Hola JZINOX, me interesa cotizar: ${item.name}`)}`}
									target="_blank"
									rel="noopener noreferrer"
									class="product-card__cta"
								>
									Cotizar por WhatsApp
								</a>
							</article>
						))}
					</div>
				</div>
			</section>
		))
	}

	<section class="section--steel cta-band">
		<div class="container cta-band__inner">
			<div>
				<h2>¿Necesitas algo que no está en la lista?</h2>
				<p>Fabricamos a medida según tus planos o el levantamiento que hagamos en terreno.</p>
			</div>
			<div class="cta-band__actions">
				<a href="/contacto" class="btn btn--primary">Cotizar Proyecto</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	.group-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.6rem;
		margin-bottom: 1.8rem;
		padding-bottom: 0.8rem;
		border-bottom: 1px solid var(--color-border);
	}

	.group-head h2 {
		margin-bottom: 0;
	}

	.group-head__link {
		font-size: 0.88rem;
		font-weight: 600;
		color: var(--color-accent);
	}

	.group-head__link:hover {
		text-decoration: underline;
	}

	.product-card {
		display: flex;
		flex-direction: column;
	}

	.product-card h3 {
		font-size: 1.05rem;
	}

	.product-card p {
		font-size: 0.92rem;
		flex: 1;
	}

	.product-card__cta {
		font-size: 0.88rem;
		font-weight: 600;
		color: var(--color-accent);
	}

	.product-card__cta:hover {
		text-decoration: underline;
	}

	.cta-band {
		padding: 3rem 0;
	}
</style>
