---
import Layout from "../layouts/Layout.astro";
import ServiceIcon from "../components/ServiceIcon.astro";
import { site } from "../data/site.js";

const applications = [
	{
		title: "Uniones sanitarias",
		text: "Cordones continuos y pulidos en mesones, lavaplatos y estanques, sin ranuras donde se acumule materia orgánica.",
	},
	{
		title: "Cañería y estanques",
		text: "Soldadura de cañerías y estanques de proceso, con control de penetración y respaldo de gas cuando el trabajo lo exige.",
	},
	{
		title: "Reparación en terreno",
		text: "Intervenimos equipamiento ya instalado sin tener que desmontar la línea completa de la cocina.",
	},
	{
		title: "Piezas de espesor fino",
		text: "El TIG permite trabajar planchas delgadas sin perforarlas ni deformar la superficie visible.",
	},
];
---

<Layout
	title="Soldadura TIG"
	description="Soldadura TIG en acero inoxidable: cordones limpios, sin salpicaduras y con pulido posterior, apta para superficies en contacto con alimentos."
>
	<section class="section page-hero">
		<div class="container tig-hero">
			<div>
				<span class="eyebrow">Soldadura TIG</span>
				<h1>Cordones limpios, pulidos y aptos para contacto con alimentos</h1>
				<p>
					El TIG (GTAW) es el proceso que usamos en prácticamente todo lo que sale de nuestro
					taller. Da un cordón preciso, sin salpicaduras y con muy poca deformación, que
					después se pule hasta dejar la superficie continua.
				</p>
			</div>
			<div class="tig-hero__icon" aria-hidden="true">
				<ServiceIcon name="tig" />
			</div>
		</div>
	</section>

	<section class="section section--alt">
		<div class="container">
			<div class="section-head">
				<span class="eyebrow">Por qué TIG</span>
				<h2>La diferencia se nota al limpiar</h2>
				<p>
					Una unión mal ejecutada deja poros y ranuras. En una cocina, eso es exactamente
					donde se acumula la suciedad que después no sale.
				</p>
			</div>

			<div class="bento bento--2">
				{applications.map((item) => (
					<article class="bento__cell bento__cell--hover">
						<h3>{item.title}</h3>
						<p>{item.text}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="bento tig-specs">
				<div class="bento__cell tig-specs__main">
					<h2>Qué incluye el trabajo</h2>
					<ul class="check-list">
						<li>Preparación y limpieza previa del material</li>
						<li>Soldadura TIG con aporte compatible al inoxidable</li>
						<li>Pulido y decapado del cordón terminado</li>
						<li>Revisión visual de la unión antes de entregar</li>
					</ul>
				</div>

				<div class="bento__cell bento__cell--accent tig-specs__aside">
					<h3>¿Tienes una reparación urgente?</h3>
					<p>
						Si se rompió un mesón, una cuba o un ducto en plena operación, escríbenos y
						coordinamos la visita.
					</p>
					<a
						href={`https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent("Hola JZINOX, necesito una reparación con soldadura TIG.")}`}
						target="_blank"
						rel="noopener noreferrer"
						class="btn btn--primary"
					>
						Escríbenos por WhatsApp
					</a>
				</div>
			</div>
		</div>
	</section>

	<section class="section section--alt cta-band">
		<div class="container cta-band__inner">
			<div>
				<h2>Cotiza tu trabajo de soldadura</h2>
				<p>Cuéntanos qué necesitas soldar y te respondemos con un presupuesto.</p>
			</div>
			<div class="cta-band__actions">
				<a href="/contacto" class="btn btn--primary">Cotizar Proyecto</a>
				<a href="/servicios" class="btn btn--ghost">Ver todos los servicios</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	.tig-hero {
		display: grid;
		gap: 2rem;
		grid-template-columns: 1fr;
		align-items: center;
	}

	@media (min-width: 900px) {
		.tig-hero {
			grid-template-columns: 1.6fr auto;
		}
	}

	.tig-hero__icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 120px;
		height: 120px;
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		background-color: var(--color-bg-alt);
		color: var(--color-accent);
	}

	.tig-hero__icon :global(svg) {
		width: 52px;
		height: 52px;
	}

	@media (min-width: 900px) {
		.tig-specs {
			grid-template-columns: 1.3fr 1fr;
		}
	}

	.tig-specs__main {
		padding: 2.5rem 2rem;
	}

	.tig-specs__aside {
		padding: 2.5rem 2rem;
	}

	.tig-specs__aside .btn {
		width: 100%;
	}
</style>
