---
import Layout from "../layouts/Layout.astro";
import { pageHero, history, mission, valuesSection, values, facts } from "../data/company.js";

const otherFacts = facts.slice(1);
---

<Layout
	title="Taller de acero inoxidable a medida en Santiago"
	description="Taller de acero inoxidable en Santiago con más de 20 años de oficio. Conoce cómo trabajamos y por qué fabricamos cada pieza a medida."
>
	<section class="section page-hero about" aria-labelledby="nosotros-titulo">
		<div class="container about__grid">
			<h1 id="nosotros-titulo" class="about__title">
				<span class="about__lead">{pageHero.titleLead}</span>
				{" "}
				<span class="about__rest">{pageHero.titleRest}</span>
			</h1>

			<div class="about__story">
				{history.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
			</div>

			<dl class="about__facts">
				{
					otherFacts.map((fact) => (
						<div class="about__fact">
							<dt>{fact.label}</dt>
							<dd>
								{fact.href ? (
									<a class="fact-link link-press" href={fact.href} target="_blank" rel="noopener noreferrer">
										{fact.value}
										<span class="visually-hidden"> (abre Google Maps)</span>
									</a>
								) : (
									fact.value
								)}
							</dd>
						</div>
					))
				}
			</dl>
		</div>
	</section>

	<section class="section section--alt" aria-labelledby="nosotros-mision">
		<div class="container">
			<div class="section-head" data-reveal>
				<h2 id="nosotros-mision">{mission.title}</h2>
			</div>

			<div class="rows">
				{
					mission.items.map((item) => (
						<article class="rows__row" data-reveal>
							<h3>{item.title}</h3>
							<p>{item.description}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="nosotros-valores">
		<div class="container">
			<div class="section-head" data-reveal>
				<h2 id="nosotros-valores">{valuesSection.title}</h2>
			</div>

			<div class="rows">
				{
					values.map((value) => (
						<article class="rows__row" data-reveal>
							<h3>{value.title}</h3>
							<p>{value.description}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="section section--tight section--alt cta-band" aria-labelledby="nosotros-cierre">
		<div class="container cta-band__inner" data-reveal>
			<div class="cta-band__text">
				<h2 id="nosotros-cierre">¿Necesitas una pieza a medida?</h2>
				<p>Cuéntanos qué necesitas y te respondemos con medidas, materiales y plazos.</p>
			</div>
			<div class="cta-band__actions">
				<a href="/contacto" class="btn btn--primary">Cotizar proyecto</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	.about__grid {
		display: grid;
		gap: 1.5rem clamp(2rem, 5vw, 4rem);
	}

	.page-hero .about__title {
		max-width: none;
		margin: 0;
		font-size: clamp(2rem, 3.6vw, 3rem);
		line-height: 1.08;
	}

	.about__lead {
		display: block;
		font-size: 1.35em;
		line-height: 1;
		margin-bottom: 0.2em;
		color: var(--color-text);
	}

	.about__rest {
		color: var(--color-text-muted);
	}

	.page-hero .about__story p {
		max-width: 60ch;
		font-size: 1.0625rem;
		line-height: 1.65;
		margin: 0 0 1em;
	}

	.page-hero .about__story p:last-child {
		margin-bottom: 0;
	}

	.about__facts {
		display: grid;
		gap: 1px;
		margin: clamp(1rem, 3vw, 2rem) 0 0;
		background-color: var(--color-border);
		border-block: 1px solid var(--color-border);
	}

	.about__fact {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 1.25rem 0;
		background-color: var(--color-bg);
	}

	.about__fact dt {
		font-size: 0.75rem;
		font-weight: 500;
		line-height: 1.3;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.about__fact dd {
		margin: 0;
		font-family: var(--font-heading);
		font-size: clamp(1.125rem, 1.6vw, 1.375rem);
		font-weight: 600;
		line-height: 1.2;
		color: var(--color-text);
	}

	@media (min-width: 640px) {
		.about__facts {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		.about__fact:not(:first-child) {
			padding-left: var(--gutter);
		}
	}

	@media (min-width: 1024px) {
		.about__grid {
			grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
			align-items: center;
		}

		.about__facts {
			grid-column: 1 / -1;
		}
	}

	.rows {
		border-bottom: 1px solid var(--color-border);
	}

	.rows__row {
		display: grid;
		gap: 0.5rem;
		padding: clamp(1.25rem, 2.6vw, 1.75rem) 0;
		border-top: 1px solid var(--color-border);
	}

	@media (min-width: 768px) {
		.rows__row {
			grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
			gap: var(--gutter);
			align-items: baseline;
		}
	}

	.rows__row h3 {
		font-size: clamp(1.25rem, 1.8vw, 1.5rem);
		margin: 0;
	}

	.rows__row p {
		max-width: 68ch;
		font-size: 1.0625rem;
		margin: 0;
	}
</style>
