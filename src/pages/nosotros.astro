---
/**
 * Nosotros: historia, misión/visión y valores de JZINOX.
 *
 * Todo el copy es placeholder localizable (NOSOTROS 1..5, VALOR 1..4,
 * DATO 1..4) a la espera del texto definitivo del cliente. La estructura
 * semántica y el SEO técnico sí son definitivos.
 */
import Layout from "../layouts/Layout.astro";
import { history, mission, valuesSection, values, stats } from "../data/company.js";
---

<Layout
	title="Nosotros"
	description="Conoce la historia, la misión y los valores de JZINOX, taller de equipamiento gastronómico en acero inoxidable."
>
	{/* --- NOSOTROS 1: encabezado --- */}
	<section class="section page-hero" aria-labelledby="nosotros-titulo">
		<div class="container">
			<span class="eyebrow">Nosotros</span>
			<h1 id="nosotros-titulo">NOSOTROS 1</h1>
			<p>
				Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor
				incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud
				exercitation ullamco laboris.
			</p>
		</div>
	</section>

	{/* --- NOSOTROS 2: historia + cifras --- */}
	<section class="section section--alt history" aria-labelledby="nosotros-historia">
		<div class="container history__grid">
			<div class="history__text">
				<span class="eyebrow">{history.eyebrow}</span>
				<h2 id="nosotros-historia">{history.title}</h2>
				{history.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
			</div>

			{/*
				Las cifras son una lista de descripción, no cuatro divs sueltos: cada
				número es el VALOR de su etiqueta. El orden del DOM es etiqueta → valor
				porque <dl> lo exige; la inversión visual la hace el CSS.
			*/}
			<dl class="bento history__stats">
				{
					stats.map((stat) => (
						<div class="bento__cell history__stat">
							<dt>{stat.label}</dt>
							<dd>{stat.value}</dd>
						</div>
					))
				}
			</dl>
		</div>
	</section>

	{/* --- NOSOTROS 3: misión y visión --- */}
	<section class="section" aria-labelledby="nosotros-mision">
		<div class="container">
			<div class="section-head">
				<span class="eyebrow">{mission.eyebrow}</span>
				<h2 id="nosotros-mision">{mission.title}</h2>
			</div>

			<div class="bento bento--2">
				{
					mission.items.map((item) => (
						<article class="bento__cell">
							<h3>{item.title}</h3>
							<p>{item.description}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	{/* --- NOSOTROS 4: valores --- */}
	<section class="section section--alt" aria-labelledby="nosotros-valores">
		<div class="container">
			<div class="section-head">
				<span class="eyebrow">{valuesSection.eyebrow}</span>
				<h2 id="nosotros-valores">{valuesSection.title}</h2>
			</div>

			<div class="bento bento--4">
				{
					values.map((value) => (
						<article class="bento__cell bento__cell--hover value-card">
							<h3>{value.title}</h3>
							<p>{value.description}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	{/* --- NOSOTROS 5: cierre --- */}
	<section class="section" aria-labelledby="nosotros-cierre">
		<div class="container">
			<div class="cta-plate">
				<div class="cta-plate__text">
					<h2 id="nosotros-cierre">NOSOTROS 5</h2>
					<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor.</p>
				</div>
				<a href="/contacto" class="btn btn--primary">Cotizar Proyecto</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	.history__grid {
		display: grid;
		gap: 3rem;
	}

	@media (min-width: 1024px) {
		.history__grid {
			grid-template-columns: 1.4fr 1fr;
		}
	}

	.history__text p {
		font-size: 0.98rem;
		/* Con el contenedor de 1440px la columna de texto mide ~737px: sin tope,
		   la línea se va a ~95 caracteres. 62ch es la medida de lectura del
		   sistema (la misma de .page-hero p y del Inicio). */
		max-width: 62ch;
	}

	/* Una columna en teléfonos angostos: dos cifras de 1.9rem lado a lado no
	   caben a 320px sin apretujarse.
	   `align-self: start` es necesario: sin él la placa se estira hasta igualar
	   la altura de la columna de texto y asoma el fondo gris del bento bajo la
	   última fila de cifras. */
	.history__stats {
		grid-template-columns: 1fr;
		align-content: start;
		align-self: start;
		/* <dl> llega con margen de agente de usuario: descuadraría la placa
		   respecto al inicio de la columna de texto. */
		margin: 0;
	}

	@media (min-width: 420px) {
		.history__stats {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	/* `column-reverse` deja la cifra arriba y su etiqueta debajo sin alterar el
	   orden semántico dt → dd que lee el navegador. */
	.history__stat {
		display: flex;
		flex-direction: column-reverse;
		gap: 0.35rem;
		padding: 1.4rem;
		text-align: center;
	}

	.history__stat dd {
		margin: 0; /* el sangrado por defecto de <dd> descentraría la cifra */
		font-family: var(--font-heading);
		font-size: clamp(1.5rem, 4vw, 1.9rem);
		font-weight: 700;
		line-height: 1.15;
		color: var(--color-accent);
	}

	/* 0.75rem es el piso de tamaño de etiqueta del sistema (.eyebrow,
	   .bento__index). A 0.72rem quedaban 11,5px en versalitas espaciadas. */
	.history__stat dt {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		line-height: 1.3;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--color-text-muted);
	}

	.value-card p {
		font-size: 0.92rem;
		margin-bottom: 0;
	}

	/* La placa de cierre es flex: sin tope, el párrafo se estira a lo ancho de
	   los 1.312px útiles del contenedor nuevo. */
	.cta-plate__text {
		max-width: 62ch;
	}
</style>
