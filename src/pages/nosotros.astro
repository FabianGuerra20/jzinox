---
import Layout from "../layouts/Layout.astro";
import ClientLogos from "../components/ClientLogos.astro";
import WhatsAppIcon from "../components/WhatsAppIcon.astro";
import { site } from "../data/site.js";
import MediaPair from "../components/MediaPair.astro";
import { photoFill, srcset } from "../utils/img.js";
import { pageHero, history, mission, valuesSection, values, facts, clients, recentProjects } from "../data/company.js";

const otherFacts = facts.slice(1);
const whatsappHref = `https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent(site.whatsappDefaultMessage)}`;
const workshopPhoto = { src: "/img/taller-estanteria.webp", alt: "Estantería de acero inoxidable con repisas blancas en el taller de JZ INOX" };
const missionMedia = [
	{ video: "/video/plegado-1.mp4", poster: "/video/plegado-1.webp", alt: "Video: plegadora doblando una plancha de acero inoxidable en el taller" },
	{ src: "/img/piezas-cortadas.webp", alt: "Piezas de acero inoxidable recién cortadas y plegadas en el taller" },
];
---

<Layout
	title="Taller de acero inoxidable a medida en Santiago"
	description="Taller de acero inoxidable en San Miguel, Santiago, con más de 20 años de oficio. Conoce a nuestros clientes y por qué fabricamos cada pieza a medida."
	breadcrumb="Nosotros"
>
	<section class="section page-hero about" aria-labelledby="nosotros-titulo">
		<div class="container about__grid">
			<div class="about__copy">
				<h1 id="nosotros-titulo" class="about__title">
					<span class="about__lead">{pageHero.titleLead}</span>
					{" "}
					<span class="about__rest">{pageHero.titleRest}</span>
				</h1>

				<div class="about__story">
					{history.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
				</div>
			</div>

			<figure class="about__photo media-frame photo-fill" style={photoFill(workshopPhoto.src)}>
				<img src={workshopPhoto.src} srcset={srcset(workshopPhoto.src)} sizes="(min-width: 1024px) 40vw, 92vw" alt={workshopPhoto.alt} width="1600" height="1189" fetchpriority="high" decoding="async" />
			</figure>

			<dl class="fact-card about__facts">
				{
					otherFacts.map((fact) => (
						<div>
							<dt>{fact.label}</dt>
							<dd>
								{fact.href ? (
									<a class="fact-link link-press" href={fact.href} target="_blank" rel="noopener noreferrer">
										{fact.value}
										<span class="visually-hidden"> (abre Google Maps)</span>
									</a>
								) : (
									fact.value
								)}
							</dd>
						</div>
					))
				}
			</dl>
		</div>
	</section>

	<section class="section section--alt" aria-labelledby="nosotros-clientes">
		<div class="container">
			<div class="section-head" data-reveal>
				<h2 id="nosotros-clientes">{clients.title}</h2>
				<p>{clients.paragraph}</p>
			</div>

			<div data-reveal="fade">
				<ClientLogos />
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="nosotros-proyectos">
		<div class="container">
			<div class="section-head" data-reveal>
				<h2 id="nosotros-proyectos">{recentProjects.title}</h2>
			</div>

			<div class="rows">
				{
					recentProjects.items.map((project) => (
						<article class="rows__row" data-reveal>
							<h3>{project.client}</h3>
							<p>{project.work}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="section section--alt" aria-labelledby="nosotros-mision">
		<div class="container">
			<div class="mission" data-reveal>
				<div class="mission__head">
					<h2 id="nosotros-mision">{mission.title}</h2>
					<MediaPair media={missionMedia} sizes="(min-width: 1024px) 16vw, 46vw" />
				</div>
				<p>{mission.description}</p>
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="nosotros-valores">
		<div class="container">
			<div class="section-head" data-reveal>
				<h2 id="nosotros-valores">{valuesSection.title}</h2>
			</div>

			<div class="rows">
				{
					values.map((value) => (
						<article class="rows__row" data-reveal>
							<h3>{value.title}</h3>
							<p>{value.description}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="section section--tight section--alt cta-band" aria-labelledby="nosotros-cierre">
		<div class="container">
			<div class="cta-band__inner" data-reveal>
			<div class="cta-band__text">
				<h2 id="nosotros-cierre">¿Necesitas una pieza a medida?</h2>
				<p>Cuéntanos qué necesitas y te respondemos con medidas, materiales y plazos.</p>
			</div>
			<div class="cta-band__actions">
				<a href="/contacto" class="btn btn--primary">Cotizar proyecto</a>
				<a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="btn btn--whatsapp">
					<WhatsAppIcon size={18} />
					Hablar con un asesor
				</a>
			</div>
		</div>
		</div>
	</section>
</Layout>

<style>
	.mission {
		display: grid;
		gap: 1.5rem var(--gutter);
	}

	.mission h2 {
		margin: 0;
	}

	.mission p {
		max-width: 60ch;
		margin: 0;
		font-size: clamp(1.125rem, 1.6vw, 1.3125rem);
		line-height: 1.55;
	}

	@media (min-width: 1024px) {
		.mission {
			grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
			align-items: start;
		}
	}

	.about__grid {
		display: grid;
		gap: 1.5rem clamp(2rem, 5vw, 4rem);
	}

	.about__grid {
		display: grid;
		gap: clamp(1.75rem, 4vw, 2.5rem) var(--gutter);
	}

	.page-hero .about__title {
		max-width: none;
		margin: 0 0 1.5rem;
		font-size: clamp(2.25rem, 4.2vw, 3.5rem);
		line-height: 1.08;
	}

	.about__lead {
		display: block;
		font-size: min(1.35em, 4.25rem);
		line-height: 1;
		margin-bottom: 0.2em;
		color: var(--color-text);
	}

	.about__rest {
		color: var(--color-text-muted);
		text-transform: none;
		letter-spacing: -0.01em;
	}

	.page-hero .about__story p {
		max-width: 60ch;
		font-size: 1.0625rem;
		line-height: 1.65;
		margin: 0 0 1em;
	}

	.page-hero .about__story p:last-child {
		margin-bottom: 0;
	}

	.about__photo {
		margin: 0;
		aspect-ratio: 4 / 3;
		border-radius: var(--radius-card);
		box-shadow: var(--shadow-card);
	}

	.about__photo img {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	@media (min-width: 1024px) {
		.about__grid {
			grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
			align-items: center;
		}

		.about__facts {
			grid-column: 1 / -1;
		}
	}

	.mission__head {
		display: grid;
		gap: 1.5rem;
		align-content: start;
	}
</style>
