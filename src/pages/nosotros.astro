---
import Layout from "../layouts/Layout.astro";
import { pageHero, history, mission, valuesSection, values, stats, facts } from "../data/company.js";

const confirmedStats = stats.filter((stat) => !stat.pending);

const otherFacts = facts.slice(1);
---

<Layout
	title="Taller de acero inoxidable a medida en Santiago"
	description="Taller de acero inoxidable en Santiago con más de 20 años de oficio. Conoce cómo trabajamos y por qué fabricamos cada pieza a medida."
>
	<section class="section page-hero page-hero--split" aria-labelledby="nosotros-titulo">
		<div class="container">
			<h1 id="nosotros-titulo">{pageHero.title}</h1>
		</div>
	</section>

	<section class="section section--alt" aria-labelledby="nosotros-historia">
		<div class="container history">
			<dl class="history__stats" data-reveal>
				{
					confirmedStats.map((stat) => (
						<div class="history__stat">
							<dt>{stat.label}</dt>
							<dd>{stat.value}</dd>
						</div>
					))
				}
				{
					otherFacts.map((fact) => (
						<div class="history__fact">
							<dt>{fact.label}</dt>
							<dd>
								{fact.href ? (
								<a class="fact-link link-press" href={fact.href} target="_blank" rel="noopener noreferrer">
									{fact.value}
									<span class="visually-hidden"> (abre Google Maps)</span>
								</a>
							) : (
								fact.value
							)}
							</dd>
						</div>
					))
				}
			</dl>

			<div class="history__text" data-reveal style="--i: 1">
				<h2 id="nosotros-historia">{history.title}</h2>
				{history.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="nosotros-mision">
		<div class="container">
			<div class="section-head" data-reveal>
				<h2 id="nosotros-mision">{mission.title}</h2>
			</div>

			<div class="creed">
				{
					mission.items.map((item, i) => (
						<article class="creed__item" data-reveal style={`--i: ${i}`}>
							<h3>{item.title}</h3>
							<p>{item.description}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="section section--alt" aria-labelledby="nosotros-valores">
		<div class="container values">
			<div class="values__head" data-reveal>
				<h2 id="nosotros-valores">{valuesSection.title}</h2>
			</div>

			<div class="values__list">
				{
					values.map((value) => (
						<article class="values__row" data-reveal>
							<h3>{value.title}</h3>
							<p>{value.description}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="section section--tight cta-band cta-band--dark" aria-labelledby="nosotros-cierre">
		<div class="container cta-band__inner" data-reveal>
			<div class="cta-band__text">
				<h2 id="nosotros-cierre">¿Necesitas una pieza a medida?</h2>
				<p>Cuéntanos qué necesitas y te respondemos con medidas, materiales y plazos.</p>
			</div>
			<div class="cta-band__actions">
				<a href="/contacto" class="btn btn--primary">Cotizar proyecto</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	.history {
		display: grid;
		gap: clamp(2rem, 5vw, 4rem);
	}

	@media (min-width: 1024px) {
		.history {
			grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
			align-items: start;
		}
	}

	.history__stats {
		display: grid;
		gap: 0;
		margin: 0;
	}

	.history__stat {
		display: flex;
		flex-direction: column-reverse;
		gap: 0.9rem;
		padding-bottom: 1.25rem;
		border-bottom: 1px solid var(--color-border);
	}

	.history__stat dd {
		margin: 0;
		font-family: var(--font-heading);
		font-size: clamp(5.5rem, 15vw, 11rem);
		font-weight: 800;
		line-height: 0.82;
		letter-spacing: -0.05em;
		color: var(--color-text);
	}

	.history__stat dt {
		font-family: var(--font-body);
		font-size: 0.75rem;
		font-weight: 500;
		line-height: 1.3;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: var(--color-text-muted);
	}

	.history__fact {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.9rem 0;
		border-bottom: 1px solid var(--color-border);
	}

	.history__fact dt {
		font-size: 0.75rem;
		font-weight: 500;
		line-height: 1.3;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.history__fact dd {
		margin: 0;
		font-family: var(--font-heading);
		font-size: 1.125rem;
		font-weight: 600;
		text-align: right;
		color: var(--color-text);
	}

	.history__text p {
		font-size: 1.0625rem;
		max-width: 62ch;
	}

	.history__text p:last-child {
		margin-bottom: 0;
	}

	.creed {
		display: grid;
		gap: 2.5rem var(--gutter);
	}

	@media (min-width: 900px) {
		.creed {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: clamp(2rem, 6vw, 5rem);
		}
	}

	.creed__item {
		padding-top: 1.5rem;
		border-top: 1px solid var(--color-border);
	}

	.creed__item h3 {
		margin-bottom: 0.75rem;
	}

	.creed__item p {
		font-size: 1.0625rem;
		max-width: 54ch;
		margin-bottom: 0;
	}

	.values {
		display: grid;
		gap: clamp(1.75rem, 4vw, 3rem);
	}

	.values__head h2 {
		margin: 0;
	}

	@media (min-width: 1024px) {
		.values {
			grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
			align-items: start;
		}

		.values__head {
			position: sticky;
			top: calc(var(--header-height) + 2rem);
		}
	}

	.values__list {
		border-bottom: 1px solid var(--color-border);
	}

	.values__row {
		display: grid;
		gap: 0.5rem;
		padding: clamp(1.25rem, 2.6vw, 1.75rem) 0;
		border-top: 1px solid var(--color-border);
	}

	@media (min-width: 640px) {
		.values__row {
			grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
			gap: var(--gutter);
			align-items: baseline;
		}
	}

	.values__row h3,
	.values__row p {
		margin: 0;
	}

</style>
