---
/**
 * Nosotros: historia, misión/visión y valores de JZINOX.
 *
 * El copy sale del PDF del cliente. Los bloques marcados [PROPUESTA] en
 * `company.js` los redactamos nosotros y esperan validación.
 *
 * Sin tarjetas: la cifra confirmada va como numeral a gran tamaño, misión y
 * visión como dos columnas de texto, y los cuatro puntos clave como renglones.
 */
import Layout from "../layouts/Layout.astro";
import { pageHero, history, mission, valuesSection, values, stats } from "../data/company.js";

// Solo se publican las cifras confirmadas por el cliente. Las `pending` siguen
// en `company.js` como recordatorio de lo que falta pedir.
const confirmedStats = stats.filter((stat) => !stat.pending);
---

<Layout
	title="Nosotros"
	description="Más de 20 años fabricando estructuras en acero inoxidable 100% a medida en Santiago. Manufactura nacional para restaurantes, comida rápida e industria alimentaria."
>
	{/* --- Encabezado --- */}
	<section class="section page-hero page-hero--split" aria-labelledby="nosotros-titulo">
		<div class="container">
			<span class="eyebrow">{pageHero.eyebrow}</span>
			<h1 id="nosotros-titulo">{pageHero.title}</h1>
			<p>{pageHero.lead}</p>
		</div>
	</section>

	{/* --- Historia + cifra --- */}
	<section class="section section--alt" aria-labelledby="nosotros-historia">
		<div class="container history">
			{/*
				Las cifras son una lista de descripción: cada número es el VALOR de su
				etiqueta. El orden del DOM es etiqueta → valor porque <dl> lo exige; la
				inversión visual la hace el CSS.
			*/}
			<dl class="history__stats" data-reveal>
				{
					confirmedStats.map((stat) => (
						<div class="history__stat">
							<dt>{stat.label}</dt>
							<dd>{stat.value}</dd>
						</div>
					))
				}
			</dl>

			<div class="history__text" data-reveal style="--i: 1">
				<span class="eyebrow">{history.eyebrow}</span>
				<h2 id="nosotros-historia">{history.title}</h2>
				{history.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
			</div>
		</div>
	</section>

	{/* --- Misión y visión --- */}
	<section class="section" aria-labelledby="nosotros-mision">
		<div class="container">
			<div class="section-head" data-reveal>
				<span class="eyebrow">{mission.eyebrow}</span>
				<h2 id="nosotros-mision">{mission.title}</h2>
			</div>

			<div class="creed">
				{
					mission.items.map((item, i) => (
						<article class="creed__item" data-reveal style={`--i: ${i}`}>
							<h3>{item.title}</h3>
							<p>{item.description}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	{/* --- Puntos clave --- */}
	<section class="section section--alt" aria-labelledby="nosotros-valores">
		<div class="container values">
			<div class="values__head" data-reveal>
				<h2 id="nosotros-valores">{valuesSection.title}</h2>
			</div>

			<div class="values__list">
				{
					values.map((value) => (
						<article class="values__row" data-reveal>
							<h3>{value.title}</h3>
							<p>{value.description}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	{/* --- Cierre --- */}
	<section class="section section--tight" aria-labelledby="nosotros-cierre">
		<div class="container">
			<div class="cta-plate" data-reveal>
				<div class="cta-plate__text">
					<h2 id="nosotros-cierre">¿Tienes un proyecto en mente?</h2>
					<p>Medimos tu espacio, te mostramos la propuesta y recién ahí fabricamos.</p>
				</div>
				<a href="/contacto" class="btn btn--primary">Cotizar Proyecto</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	/* =========================================================
	   Historia: el numeral manda
	   ---------------------------------------------------------
	   "20+" es el único dato duro confirmado. Va a 11rem, sin caja,
	   apoyado en una junta: ocupa el lugar de la foto que no hay.
	   ========================================================= */
	.history {
		display: grid;
		gap: clamp(2rem, 5vw, 4rem);
	}

	@media (min-width: 1024px) {
		.history {
			grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
			align-items: start;
		}
	}

	.history__stats {
		display: grid;
		gap: 2rem;
		/* <dl> llega con margen de agente de usuario */
		margin: 0;
	}

	/* `column-reverse` deja la cifra arriba y su etiqueta debajo sin alterar el
	   orden semántico dt → dd que lee el navegador. */
	.history__stat {
		display: flex;
		flex-direction: column-reverse;
		gap: 0.9rem;
		padding-bottom: 1.25rem;
		border-bottom: 1px solid var(--color-border);
	}

	.history__stat dd {
		margin: 0; /* el sangrado por defecto de <dd> descentraría la cifra */
		font-family: var(--font-heading);
		font-size: clamp(5.5rem, 15vw, 11rem);
		font-weight: 800;
		line-height: 0.82;
		letter-spacing: -0.05em;
		color: var(--color-text);
	}

	.history__stat dt {
		font-family: var(--font-body);
		font-size: 0.75rem;
		font-weight: 500;
		line-height: 1.3;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: var(--color-text-muted);
	}

	.history__text p {
		font-size: 1.0625rem;
		max-width: 62ch;
	}

	.history__text p:last-child {
		margin-bottom: 0;
	}

	/* =========================================================
	   Misión y visión: dos columnas de texto, sin caja
	   ========================================================= */
	.creed {
		display: grid;
		gap: 2.5rem var(--gutter);
	}

	@media (min-width: 900px) {
		.creed {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: clamp(2rem, 6vw, 5rem);
		}
	}

	.creed__item {
		padding-top: 1.5rem;
		border-top: 1px solid var(--color-border);
	}

	.creed__item h3 {
		margin-bottom: 0.75rem;
	}

	.creed__item p {
		font-size: 1.0625rem;
		max-width: 54ch;
		margin-bottom: 0;
	}

	/* =========================================================
	   Puntos clave: título fijo a la izquierda, renglones a la derecha
	   ========================================================= */
	.values {
		display: grid;
		gap: clamp(1.75rem, 4vw, 3rem);
	}

	.values__head h2 {
		margin: 0;
	}

	@media (min-width: 1024px) {
		.values {
			grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
			align-items: start;
		}

		.values__head {
			position: sticky;
			top: calc(var(--header-height) + 2rem);
		}
	}

	.values__list {
		border-bottom: 1px solid var(--color-border);
	}

	.values__row {
		display: grid;
		gap: 0.5rem;
		padding: clamp(1.25rem, 2.6vw, 1.75rem) 0;
		border-top: 1px solid var(--color-border);
	}

	@media (min-width: 640px) {
		.values__row {
			grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
			gap: var(--gutter);
			align-items: baseline;
		}
	}

	.values__row h3,
	.values__row p {
		margin: 0;
	}

	/* La placa de cierre es flex: sin tope, el párrafo se estira a lo ancho de
	   los 1.312px útiles del contenedor. */
	.cta-plate__text {
		max-width: 62ch;
	}
</style>
