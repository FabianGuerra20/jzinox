---
import Layout from "../layouts/Layout.astro";
import WhatsAppIcon from "../components/WhatsAppIcon.astro";
import { site } from "../data/site.js";

const whatsappHref = `https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent(`Hola ${site.name}, acabo de enviar una consulta por la web.`)}`;
---

<Layout title="Gracias" description={`Gracias por contactar a ${site.name}.`} noindex>
	<section class="section thanks" aria-labelledby="gracias-titulo">
		<div class="container thanks__inner">
			<span class="eyebrow">Consulta enviada</span>
			<h1 id="gracias-titulo">¡Gracias por escribirnos!</h1>
			<p>
				Recibimos tu consulta y te respondemos <strong>en horario de taller</strong>: {site.hours}.
				Si necesitas una respuesta ahora, escríbenos por WhatsApp.
			</p>
			<div class="thanks__actions">
				<a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="btn btn--whatsapp">
					<WhatsAppIcon size={18} />
					Escríbenos por WhatsApp
				</a>
				<a href="/" class="btn btn--ghost">Volver al inicio</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	.thanks {
		display: flex;
		align-items: center;
		min-height: calc(100vh - var(--header-height));
		min-height: calc(100svh - var(--header-height));
		padding-block: clamp(3rem, 8vw, 4.5rem);
		text-align: center;
	}

	.thanks__inner {
		max-width: calc(600px + var(--margin-mobile) * 2);
		margin: 0 auto;
	}

	@media (min-width: 1024px) {
		.thanks__inner {
			padding-inline: var(--margin-mobile);
		}
	}

	.thanks h1 {
		font-size: clamp(2.5rem, 4.5vw, 3rem);
	}

	.thanks p {
		font-size: 1.125rem;
		margin-bottom: 0;
	}

	.thanks__actions {
		display: flex;
		align-items: center;
		justify-content: center;
		flex-wrap: wrap;
		gap: 1rem;
		margin-top: 2rem;
	}
</style>
