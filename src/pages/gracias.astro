---
import Layout from "../layouts/Layout.astro";
import WhatsAppIcon from "../components/WhatsAppIcon.astro";
import { site } from "../data/site.js";

const whatsappHref = `https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent(`Hola ${site.name}, acabo de enviar una consulta por la web.`)}`;
---

<Layout title="Gracias" description={`Gracias por contactar a ${site.name}.`} noindex>
	<section class="section page-hero status-page" aria-labelledby="gracias-titulo">
		<div class="container">
			<svg class="status-page__check" viewBox="0 0 48 48" width="56" height="56" aria-hidden="true">
				<circle cx="24" cy="24" r="22" />
				<path d="M14 24.5 21 31.5 34 17" />
			</svg>
			<h1 id="gracias-titulo">¡Gracias por escribirnos!</h1>
			<p>
				Recibimos tu consulta y te respondemos <strong>en horario de taller</strong>: {site.hours}.
				Si necesitas una respuesta ahora, escríbenos por WhatsApp.
			</p>
			<div class="status-page__actions">
				<a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="btn btn--whatsapp">
					<WhatsAppIcon size={18} />
					Hablar con un asesor
				</a>
				<a href="/" class="btn btn--ghost">Volver al inicio</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	.status-page {
		display: flex;
		align-items: center;
		min-height: calc(100svh - var(--header-height) - 12rem);
	}

	.status-page p {
		max-width: 52ch;
		font-size: 1.125rem;
	}

	.status-page__check {
		display: block;
		margin-bottom: 1.5rem;
		fill: none;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.status-page__check circle {
		fill: color-mix(in srgb, var(--color-ok) 14%, transparent);
		stroke: none;
	}

	.status-page__check path {
		stroke: var(--color-ok);
		stroke-width: 3.5;
	}

	@media (prefers-reduced-motion: no-preference) {
		.status-page__check {
			animation: check-draw 0.6s var(--ease-in-out) 0.15s both;
		}
	}

	@keyframes check-draw {
		from {
			clip-path: inset(0 100% 0 0);
		}
		to {
			clip-path: inset(0 0 0 0);
		}
	}

	.status-page__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2rem;
	}

	:global(body:has(.status-page) .fab) {
		display: none;
	}
</style>
