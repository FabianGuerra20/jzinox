---
import Layout from "../layouts/Layout.astro";
import ClientLogos from "../components/ClientLogos.astro";
import WhatsAppIcon from "../components/WhatsAppIcon.astro";
import {
	weldingHero,
	weldingProcesses,
	weldingJobs,
	weldingClients,
	weldingLocation,
	weldingFaqs,
	weldingCta,
} from "../data/welding.js";
import { site } from "../data/site.js";
import { photoFill, srcset } from "../utils/img.js";
import { faqSchema } from "../utils/schema.js";

const description =
	"Taller de soldadura en San Miguel, Santiago: TIG en acero inoxidable, MIG en acero carbono y aluminio. Fabricación a medida y reparación. Cotiza por WhatsApp.";

const whatsappHref = `https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent(weldingHero.whatsappMessage)}`;
const pageUrl = `${site.siteUrl}/soldadura-santiago`;

const serviceLd = {
	"@context": "https://schema.org",
	"@type": "Service",
	"@id": `${pageUrl}#servicio`,
	name: weldingHero.title,
	serviceType: "Soldadura",
	description,
	url: pageUrl,
	provider: { "@id": `${site.siteUrl}/#negocio` },
	areaServed: [
		{ "@type": "City", name: "Santiago" },
		{ "@type": "AdministrativeArea", name: site.region },
	],
	hasOfferCatalog: {
		"@type": "OfferCatalog",
		name: "Procesos de soldadura",
		itemListElement: weldingProcesses.items.map((process) => ({
			"@type": "Offer",
			itemOffered: { "@type": "Service", name: process.title, description: process.summary },
		})),
	},
};

const pageLd = JSON.stringify([serviceLd, faqSchema(weldingFaqs)]);
---

<Layout
	title="Soldadura en Santiago: TIG, MIG y aluminio"
	description={description}
	breadcrumb="Soldadura en Santiago"
	jsonLd={pageLd}
>
	<section class="section page-hero page-hero--split" aria-labelledby="soldadura-titulo">
		<div class="container">
			<h1 id="soldadura-titulo">{weldingHero.title}</h1>
			<p>{weldingHero.lead}</p>
			<div class="weld-hero__actions">
				<a href="/contacto" class="btn btn--primary btn--lg">Cotizar proyecto</a>
				<a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="btn btn--whatsapp btn--lg">
					<WhatsAppIcon size={18} />
					Escríbenos por WhatsApp
				</a>
			</div>
		</div>
	</section>

	<section class="section section--alt" aria-labelledby="soldadura-procesos">
		<div class="container">
			<div class="section-head" data-reveal>
				<h2 id="soldadura-procesos">{weldingProcesses.title}</h2>
				<p>{weldingProcesses.lead}</p>
			</div>

			<div class="ledger">
				{
					weldingProcesses.items.map((process) => (
						<article class="ledger__row" id={process.slug} data-reveal>
							<h3>{process.title}</h3>
							<p>{process.summary}</p>
							<ul class="check-list">
								{process.details.map((detail) => <li>{detail}</li>)}
							</ul>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="soldadura-trabajos">
		<div class="container weld-jobs">
			<figure class="weld-jobs__photo media-frame photo-fill" style={photoFill(weldingJobs.photo.src)} data-reveal="cut">
				<img
					src={weldingJobs.photo.src}
					srcset={srcset(weldingJobs.photo.src)}
					sizes="(min-width: 1024px) 38vw, 92vw"
					alt={weldingJobs.photo.alt}
					width="904"
					height="1600"
					loading="lazy"
					decoding="async"
				/>
			</figure>

			<div class="weld-jobs__body">
				<h2 id="soldadura-trabajos" data-reveal>{weldingJobs.title}</h2>

				<ul class="weld-jobs__list" role="list">
					{
						weldingJobs.items.map((job, i) => (
							<li class="weld-jobs__item" data-reveal style={`--i: ${i}`}>
								<h3>{job.title}</h3>
								<p>{job.description}</p>
								{job.href && (
									<a href={job.href} class="arrow-link link-press">
										{job.linkLabel}
										<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
											<path d="M5 12h14M13 6l6 6-6 6" />
										</svg>
									</a>
								)}
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</section>

	<section class="section section--alt" aria-labelledby="soldadura-clientes">
		<div class="container">
			<div class="section-head" data-reveal>
				<h2 id="soldadura-clientes">{weldingClients.title}</h2>
				<p>{weldingClients.lead}</p>
			</div>

			<div data-reveal="fade">
				<ClientLogos />
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="soldadura-taller">
		<div class="container">
			<div class="section-head" data-reveal>
				<h2 id="soldadura-taller">{weldingLocation.title}</h2>
				<p>{weldingLocation.lead}</p>
			</div>

			<dl class="weld-facts" data-reveal>
				{
					weldingLocation.facts.map((fact) => (
						<div class="weld-facts__cell">
							<dt>{fact.label}</dt>
							<dd>
								{fact.href ? (
									<a
										class="weld-facts__link link-press"
										href={fact.href}
										target={fact.hint ? "_blank" : undefined}
										rel={fact.hint ? "noopener noreferrer" : undefined}
									>
										{fact.lines.map((line) => <span class="weld-facts__line">{line}</span>)}
										{fact.hint && <span class="visually-hidden">{fact.hint}</span>}
									</a>
								) : (
									fact.lines.map((line) => <span class="weld-facts__line">{line}</span>)
								)}
							</dd>
						</div>
					))
				}
			</dl>

			<div class="weld-maps" data-reveal>
				<a href={site.mapsHref} target="_blank" rel="noopener noreferrer" class="btn btn--ghost">Abrir en Google Maps</a>
				<a href={site.wazeHref} target="_blank" rel="noopener noreferrer" class="btn btn--ghost">Abrir en Waze</a>
			</div>
		</div>
	</section>

	<section class="section section--alt" aria-labelledby="soldadura-preguntas">
		<div class="container faq-layout">
			<div class="faq-layout__head" data-reveal>
				<h2 id="soldadura-preguntas">Preguntas sobre soldadura</h2>
				<p>¿No está la tuya? Escríbenos y te respondemos en horario de taller.</p>
				<a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="btn btn--whatsapp">
					<WhatsAppIcon size={18} />
					Escríbenos por WhatsApp
				</a>
			</div>

			<div class="faq" data-reveal>
				{
					weldingFaqs.map((faq) => (
						<details class="faq__item">
							<summary>{faq.question}</summary>
							<p>{faq.answer}</p>
						</details>
					))
				}
			</div>
		</div>
	</section>

	<section class="section section--tight cta-band cta-band--dark" aria-labelledby="soldadura-cierre">
		<div class="container cta-band__inner">
			<div class="cta-band__text">
				<h2 id="soldadura-cierre">{weldingCta.title}</h2>
				<p>{weldingCta.lead}</p>
			</div>
			<div class="cta-band__actions">
				<a href="/contacto" class="btn btn--primary">Cotizar proyecto</a>
				<a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="btn btn--whatsapp">
					<WhatsAppIcon size={18} />
					Escríbenos por WhatsApp
				</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	.weld-hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1rem;
		margin-top: clamp(1.5rem, 3vw, 2.25rem);
	}

	.weld-jobs {
		display: grid;
		gap: clamp(2rem, 5vw, 4rem);
	}

	.weld-jobs__photo {
		margin: 0;
		aspect-ratio: 4 / 3;
		border: 1px solid var(--color-border);
	}

	.weld-jobs__photo img {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.weld-jobs__body h2 {
		margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
	}

	.weld-jobs__list {
		margin: 0;
		padding: 0;
		border-bottom: 1px solid var(--color-border);
	}

	.weld-jobs__item {
		padding: clamp(1.25rem, 2.8vw, 2rem) 0;
		border-top: 1px solid var(--color-border);
	}

	.weld-jobs__item h3 {
		font-size: clamp(1.25rem, 1.9vw, 1.5rem);
		line-height: 1.2;
		font-weight: 700;
		margin-bottom: 0.5rem;
	}

	.weld-jobs__item p {
		max-width: 56ch;
		font-size: 1.0625rem;
		margin-bottom: 0;
	}

	.weld-jobs__item .arrow-link {
		margin-top: 0.5rem;
	}

	@media (min-width: 1024px) {
		.weld-jobs {
			grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
			align-items: start;
		}

		.weld-jobs__photo {
			position: sticky;
			top: calc(var(--header-height) + 2rem);
			aspect-ratio: 4 / 5;
		}
	}

	.weld-facts {
		display: grid;
		gap: 1px;
		margin: 0;
		background-color: var(--color-border);
		border-block: 1px solid var(--color-border);
	}

	.weld-facts__cell {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 1.25rem 0;
		background-color: var(--color-page);
	}

	.weld-facts dt {
		font-size: 0.75rem;
		font-weight: 500;
		line-height: 1.3;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.weld-facts dd {
		margin: 0;
		font-family: var(--font-heading);
		font-size: clamp(1.125rem, 1.6vw, 1.375rem);
		font-weight: 600;
		line-height: 1.3;
		color: var(--color-text);
	}

	.weld-facts__line {
		display: block;
	}

	.weld-facts__link {
		display: inline-block;
		min-height: var(--tap);
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.25em;
		transition: color 0.15s ease;
	}

	@media (hover: hover) and (pointer: fine) {
		.weld-facts__link:hover {
			color: var(--color-accent);
		}
	}

	@media (min-width: 768px) {
		.weld-facts {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		.weld-facts__cell:not(:first-child) {
			padding-left: var(--gutter);
		}
	}

	.weld-maps {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: clamp(1.5rem, 3vw, 2rem);
	}
</style>
