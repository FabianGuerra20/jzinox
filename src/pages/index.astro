---
/**
 * Inicio: portal de las dos marcas del ecosistema.
 *
 * La página tiene un solo trabajo — que el visitante elija marca. Encabezado
 * corto, las dos placas de marca a sangre completa y el cierre. Los servicios
 * y la historia viven en /servicios y /nosotros, no se duplican aquí.
 */
import Layout from "../layouts/Layout.astro";
import BrandCard from "../components/BrandCard.astro";
import { brands } from "../data/brands.js";
import { site } from "../data/site.js";
---

<Layout
	title="Inicio"
	description="JZINOX y AL Mueblería: equipamiento gastronómico en acero inoxidable y mueblería de línea plana."
>
	<section class="section page-hero home-hero">
		<div class="container">
			<span class="eyebrow">Encabezado</span>
			<h1>INICIO 1</h1>
			<p>
				Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor
				incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud
				exercitation ullamco laboris.
			</p>
		</div>
	</section>

	{/* Sin .container: las placas de marca cruzan la pantalla de canto a canto */}
	<section class="section home-brands">
		<div class="home-brands__stack">
			{brands.map((brand, i) => <BrandCard brand={brand} eager={i === 0} bleed />)}
		</div>
	</section>

	<section class="section section--alt">
		<div class="container">
			<div class="cta-plate">
				<div>
					<h2>INICIO 4</h2>
					<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor.</p>
				</div>
				<div class="cta-band__actions">
					<a href="/contacto" class="btn btn--primary">Cotizar Proyecto</a>
					<a
						href={`https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent(site.whatsappDefaultMessage)}`}
						target="_blank"
						rel="noopener noreferrer"
						class="btn btn--outline"
					>
						Escríbenos por WhatsApp
					</a>
				</div>
			</div>
		</div>
	</section>
</Layout>

<style>
	.home-hero {
		padding-bottom: clamp(1.6rem, 4vw, 2rem);
	}

	.home-brands {
		padding-top: clamp(2rem, 5vw, 3rem);
	}

	/* Las dos placas se apilan separadas por aire, no por una línea: cada una
	   es una plancha independiente apoyada sobre el fondo. */
	.home-brands__stack {
		display: flex;
		flex-direction: column;
		gap: clamp(1.8rem, 4vw, 2.5rem);
	}
</style>
