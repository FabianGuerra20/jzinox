---
/**
 * Inicio.
 *
 * De arriba abajo:
 *   1. Hero partido: titular a la izquierda, foto del taller a sangre a la
 *      derecha y, cerrando, el cartucho del plano con los cuatro datos.
 *   2. Bloque de JZ INOX      (pedido del cliente: va primero)
 *   3. Bloque de AL Mueblería (sección clara, composición invertida)
 *   4. Servicios principales: columna fija con la foto + tres renglones
 *   5. Cierre a gran tamaño con doble CTA
 *
 * El copy sale del PDF del cliente. Los bloques marcados [PROPUESTA] en
 * `src/data/` los redactamos nosotros y esperan validación.
 */
import Layout from "../layouts/Layout.astro";
import BrandShowcase from "../components/BrandShowcase.astro";
import WhatsAppIcon from "../components/WhatsAppIcon.astro";
import { brands } from "../data/brands.js";
import { facts } from "../data/company.js";
import { srcset } from "../utils/img.js";
import { mainServices } from "../data/services.js";
import { site } from "../data/site.js";

/**
 * Imagen del hero. Para publicar otra foto basta con cambiar esta ruta.
 * Formato recomendado: horizontal, 2400 px de ancho, WebP bajo 300 KB.
 */
const heroImage = {
  src: "/img/taller-estanteria.webp",
  alt: "Taller de JZ INOX: estantería de acero inoxidable en fabricación junto a la plegadora",
};

// [PDF] Titular de la página de inicio. Se parte en palabras para que cada una
// suba por separado al cargar; el texto y su orden no cambian.
const heroTitle = "Fabricación, reparación y mantención de estructuras en acero inoxidable";
const heroWords = heroTitle.split(" ");


// El PDF pide dos imágenes por servicio; hasta que lleguen, la sección muestra
// la única foto real que hay y no los huecos rotulados.
const servicePhoto = mainServices.flatMap((service) => service.media).find((media) => media.src);

const whatsappHref = `https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent(site.whatsappDefaultMessage)}`;
---

<Layout
	flush
	description="Mesones, campanas y equipamiento en acero inoxidable a medida para restaurantes y comida rápida. Taller en Santiago con más de 20 años de oficio."
>
	{/* --- 1. Hero --- */}
	<section class="hero">
		<div class="hero__main">
			<div class="hero__copy">
				<h1 class="hero__title">
					{
						heroWords.map((word, i) => (
							<>
								<span class="hero__word" style={`--i: ${i}`}>
									<span>{word}</span>
								</span>{" "}
							</>
						))
					}
				</h1>
				{/* [PDF] Segunda oración del subtítulo del cliente, literal. La primera
				    va bajo el nombre de la marca, en el bloque siguiente. */}
				<p class="hero__lead">{brands[0].heroLead}</p>
				{/* Dos CTA con peso distinto: cotizar es la acción que el negocio quiere,
				    WhatsApp es la salida para quien todavía no sabe qué pedir. */}
				<div class="hero__actions">
					<a href="/contacto" class="btn btn--primary btn--lg">Cotizar proyecto</a>
					<a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="btn btn--ghost btn--lg">
						<WhatsAppIcon size={18} />
						Escríbenos por WhatsApp
					</a>
				</div>
			</div>

			{/* `<img>` y no background-image: el preloader la descubre en el HTML
			    inicial y la trata como candidata a LCP. */}
			<figure class="hero__figure">
				<img
					src={heroImage.src}
					srcset={srcset(heroImage.src)}
					sizes="(min-width: 960px) 40vw, 100vw"
					alt={heroImage.alt}
					width="1600"
					height="1189"
					fetchpriority="high"
					decoding="async"
				/>
			</figure>
		</div>

		<dl class="hero__block">
			{
				facts.map((cell, i) => (
					<div class="hero__cell" style={`--i: ${i}`}>
						<dt>{cell.label}</dt>
						<dd>{cell.value}</dd>
					</div>
				))
			}
		</dl>
	</section>

	{/* --- 2 y 3. Las dos marcas --- */}
	{
		brands.map((brand, i) => (
			<section class:list={["section", "brand-section", { "section--alt": i % 2 === 1 }]}>
				<div class="container">
					<BrandShowcase brand={brand} flip={i % 2 === 1} />
				</div>
			</section>
		))
	}

	{/* --- 4. Servicios principales --- */}
	<section class="section services" aria-labelledby="servicios-principales">
		<div class="container services__grid">
			<div class="services__aside">
				<div data-reveal>
					<h2 id="servicios-principales">Lo que hacemos en taller</h2>
				</div>

				{
					servicePhoto && (
						<figure class="services__photo media-frame" data-reveal="cut">
							<img
								src={servicePhoto.src}
								srcset={srcset(servicePhoto.src)}
								sizes="(min-width: 1024px) 38vw, 92vw"
								alt={servicePhoto.alt}
								width="900"
								height="675"
								loading="lazy"
								decoding="async"
								style={servicePhoto.position ? `object-position: ${servicePhoto.position}` : undefined}
							/>
						</figure>
					)
				}
			</div>

			<ol class="services__list" role="list">
				{
					mainServices.map((service, i) => (
						<li class="services__item" data-reveal style={`--i: ${i}`}>
							<h3>{service.title}</h3>
							<p>{service.blurb}</p>
							<a href={`/servicios#${service.slug}`} class="services__link link-press" aria-label={`Ver el detalle de ${service.title}`}>
								Ver el detalle
								<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
									<path d="M5 12h14M13 6l6 6-6 6" />
								</svg>
							</a>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	{/* --- 5. Cierre --- */}
	<section class="closing section--alt" aria-labelledby="cierre">
		<div class="container">
			<div class="closing__inner" data-reveal>
				<h2 id="cierre">Cotiza tu proyecto</h2>
				<div class="closing__side">
					<p>Medimos tu espacio, te mostramos la propuesta con plazos y recién ahí fabricamos.</p>

					<div class="closing__actions">
						<a href="/contacto" class="btn btn--primary btn--lg">Cotizar proyecto</a>
						<a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="btn btn--whatsapp btn--lg">
							<WhatsAppIcon size={18} />
							Escríbenos por WhatsApp
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>
</Layout>

<style>
	/* =========================================================
	   1. Hero partido
	   ---------------------------------------------------------
	   El texto vive sobre el lienzo, no sobre la foto: así el
	   titular no necesita velo y la foto se ve a plena luz. La
	   foto sangra por la derecha y por arriba (pasa bajo la barra
	   translúcida). Debajo, el cartucho del plano.
	   ========================================================= */
	.hero {
		display: grid;
		grid-template-rows: 1fr auto;
		min-height: 100svh;
		background-color: var(--color-page);
		border-bottom: 1px solid var(--color-border);
	}

	.hero__main {
		display: grid;
	}

	.hero__copy {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		justify-content: center;
		padding: calc(var(--header-height) + clamp(2rem, 6vw, 3.5rem)) var(--margin-mobile) clamp(2rem, 6vw, 3.5rem);
	}

	.hero__figure {
		position: relative;
		margin: 0;
		min-height: 72vw;
		overflow: hidden;
		border-top: 1px solid var(--color-border);
	}

	.hero__figure img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 32% 50%;
	}

	@media (min-width: 960px) {
		.hero__main {
			grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
		}

		/* El margen izquierdo sigue al contenedor de 1440px del resto del sitio,
		   aunque el hero no use `.container` (la foto tiene que llegar al borde). */
		.hero__copy {
			padding-left: max(var(--margin-desktop), calc((100vw - var(--container-width)) / 2 + var(--margin-desktop)));
			padding-right: clamp(2rem, 4vw, 4.5rem);
		}

		.hero__figure {
			min-height: 0;
			border-top: 0;
			border-left: 1px solid var(--color-border);
		}
	}

	/* El titular del cliente tiene 70 caracteres: a 56px y 24ch cabe en cuatro
	   líneas. Cada palabra va en su propia caja recortada para la entrada. */
	.hero__title {
		max-width: 24ch;
		font-size: clamp(2.125rem, 3.9vw, 3.5rem);
		line-height: 1.08;
		margin-bottom: 1.5rem;
	}

	/* El recorte se extiende hacia arriba para no comerse la tilde de las
	   mayúsculas (FABRICACIÓN), que sobresale de la caja de línea. */
	.hero__word {
		display: inline-block;
		vertical-align: top;
		clip-path: inset(-0.25em -0.05em 0 -0.05em);
	}

	.hero__word > span {
		display: inline-block;
	}

	.hero__lead {
		max-width: 52ch;
		font-size: 1.125rem;
		margin-bottom: 0;
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		margin-top: 2rem;
	}

	@media (max-width: 639.98px) {
		.hero__lead {
			font-size: 1.0625rem;
		}
	}

	/* --- Cartucho del plano --- */
	.hero__block {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1px;
		margin: 0;
		background-color: var(--color-border);
		border-top: 1px solid var(--color-border);
	}

	.hero__cell {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		padding: 1rem var(--margin-mobile) 1.1rem;
		background-color: var(--color-bg);
	}

	.hero__cell dt {
		font-size: 0.75rem;
		font-weight: 500;
		line-height: 1;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.hero__cell dd {
		margin: 0;
		font-family: var(--font-heading);
		font-size: clamp(1rem, 1.5vw, 1.25rem);
		font-weight: 600;
		line-height: 1.2;
		color: var(--color-text);
	}

	@media (min-width: 960px) {
		.hero__block {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}

		.hero__cell {
			padding: 1.25rem 2rem 1.4rem;
		}

		.hero__cell:first-child {
			padding-left: max(var(--margin-desktop), calc((100vw - var(--container-width)) / 2 + var(--margin-desktop)));
		}

		/* El botón flotante de WhatsApp cae sobre esta celda */
		.hero__cell:last-child {
			padding-right: 6rem;
		}
	}

	/* --- Entrada: una sola vez, al cargar --- */
	@keyframes word-up {
		from {
			transform: translateY(105%);
		}
		to {
			transform: none;
		}
	}

	@keyframes cut-in {
		from {
			clip-path: inset(0 100% 0 0);
		}
		to {
			clip-path: inset(0 0 0 0);
		}
	}

	@keyframes hero-settle {
		from {
			transform: scale(1.1);
		}
		to {
			transform: none;
		}
	}

	@keyframes hero-rise {
		from {
			opacity: 0;
			transform: translateY(14px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.hero__word > span {
			animation: word-up 0.7s var(--ease-out) both;
			animation-delay: calc(var(--i) * 35ms);
		}

		.hero__lead,
		.hero__actions {
			animation: hero-rise 0.6s var(--ease-out) 0.35s both;
		}

		.hero__actions {
			animation-delay: 0.42s;
		}

		/* La foto entra como un corte de guillotina, de izquierda a derecha, y
		   se asienta por debajo. */
		.hero__figure {
			animation: cut-in 0.8s var(--ease-in-out) both;
		}

		.hero__figure img {
			animation: hero-settle 1.4s var(--ease-out) both;
		}

		.hero__cell > * {
			animation: hero-rise 0.6s var(--ease-out) both;
			animation-delay: calc(0.45s + var(--i) * 60ms);
		}
	}

	/* =========================================================
	   2 y 3. Bloques de marca
	   ========================================================= */
	.brand-section {
		border-bottom: 1px solid var(--color-border);
	}

	/* =========================================================
	   4. Servicios — columna fija + renglones
	   ---------------------------------------------------------
	   El título y la foto se quedan a la vista mientras pasan los
	   tres servicios. Sin tarjetas: cada renglón se separa del
	   siguiente con la junta de 1px.
	   ========================================================= */
	.services__grid {
		display: grid;
		gap: clamp(2rem, 5vw, 4rem);
	}

	.services__aside h2 {
		margin-bottom: 0;
	}

	.services__photo {
		margin: clamp(1.5rem, 3vw, 2.25rem) 0 0;
		aspect-ratio: 4 / 3;
		border: 1px solid var(--color-border);
	}

	.services__photo img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	@media (min-width: 1024px) {
		.services__grid {
			grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
			align-items: start;
		}

		.services__aside {
			position: sticky;
			top: calc(var(--header-height) + 2rem);
		}
	}

	.services__list {
		border-bottom: 1px solid var(--color-border);
	}

	.services__item {
		padding: clamp(1.5rem, 3.4vw, 2.5rem) 0;
		border-top: 1px solid var(--color-border);
	}

	.services__item h3 {
		font-size: clamp(1.375rem, 2.2vw, 1.75rem);
		line-height: 1.15;
		letter-spacing: -0.015em;
		font-weight: 700;
		margin-bottom: 0.75rem;
	}

	.services__item p {
		max-width: 52ch;
		font-size: 1.0625rem;
		margin-bottom: 1rem;
	}

	.services__link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		min-height: var(--tap);
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 0.9375rem;
		color: var(--color-accent);
		transition: color 0.2s ease;
	}

	.services__link svg {
		transition: transform 0.2s var(--ease-out);
	}

	@media (hover: hover) and (pointer: fine) {
		.services__link:hover {
			color: var(--color-accent-dark);
		}

		.services__link:hover svg {
			transform: translateX(4px);
		}
	}

	/* =========================================================
	   5. Cierre
	   ========================================================= */
	/* Banda clara (`section--alt`): tras 970px de servicios en oscuro y antes
	   del pie, el cierre oscuro se fundía con ambos. Es la versión grande de la
	   banda de cierre de las demás páginas. */
	.closing {
		padding: clamp(3.5rem, 8vw, 6.5rem) 0;
	}

	.closing__inner {
		display: grid;
		gap: 1.5rem clamp(2rem, 5vw, 4rem);
	}

	@media (min-width: 1024px) {
		.closing__inner {
			grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
			align-items: end;
		}
	}

	.closing h2 {
		/* Tope en 72px: a 96px le ganaba al titular principal de la página */
		font-size: clamp(2.25rem, 5.2vw, 4.5rem);
		font-weight: 800;
		line-height: 0.95;
		letter-spacing: -0.03em;
		text-transform: uppercase;
		margin: 0;
	}

	.closing p {
		max-width: 46ch;
		font-size: 1.125rem;
		margin: 0 0 1.75rem;
	}

	/* Los dos botones miden lo mismo, apilados o en fila */
	.closing__actions {
		display: grid;
		grid-template-columns: max-content;
		gap: 0.75rem;
	}

	@media (max-width: 420px) {
		.closing__actions {
			grid-template-columns: 1fr;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.services__link svg {
			transition: none;
		}

		.services__link:hover svg {
			transform: none;
		}
	}
</style>
