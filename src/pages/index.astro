---
/**
 * Inicio: portal de las dos marcas del ecosistema.
 *
 * Estructura del mockup aprobado, de arriba abajo:
 *   INICIO 1  hero a sangre bajo la barra translúcida
 *   INICIO 2  placa de marca JZ INOX      (fondo blanco)
 *   INICIO 3  placa de marca AL Mueblería (fondo gris)
 *   INICIO 4  cierre centrado con doble CTA
 *
 * El copy sale del PDF del cliente. Los bloques marcados [PROPUESTA] en
 * `src/data/` los redactamos nosotros y esperan validación.
 */
import Layout from "../layouts/Layout.astro";
import BrandCard from "../components/BrandCard.astro";
import MediaPlaceholder from "../components/MediaPlaceholder.astro";
import { brands } from "../data/brands.js";
import { mainServices } from "../data/services.js";
import { site } from "../data/site.js";

/**
 * Imagen del hero. Para publicar la foto real del taller basta con reemplazar
 * este archivo (o cambiar esta ruta): el resto del bloque no se toca.
 * Formato recomendado: 1920x1080, JPG/WebP, por debajo de 300 KB.
 */
const heroImage = {
  src: "/hero-inicio.svg",
  alt: "Taller de JZ INOX: mesón de acero inoxidable en primer plano y puesto de soldadura al fondo — imagen referencial",
};

const whatsappHref = `https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent(site.whatsappDefaultMessage)}`;
---

<Layout
	flush
	title="Inicio"
	description="Fabricación, reparación y mantención de estructuras en acero inoxidable 100% a medida. Más de 20 años equipando restaurantes, comida rápida e industria alimentaria."
>
	{/* --- INICIO 1: hero --- */}
	<section class="hero">
		<img class="hero__media" src={heroImage.src} alt={heroImage.alt} fetchpriority="high" decoding="async" />
		<div class="hero__veil" aria-hidden="true"></div>

		<div class="container hero__inner">
			<span class="hero__eyebrow">Manufactura nacional · 20+ años</span>
			<h1 class="hero__title">Fabricación, reparación y mantención de estructuras en acero inoxidable</h1>
			<p class="hero__lead">
				Soluciones en acero inoxidable diseñadas a la medida de tu negocio. Fabricamos
				mesones, equipamiento y mobiliario de alta durabilidad para restaurantes, comida
				rápida e industria alimentaria.
			</p>
			{/* Dos CTA con peso distinto: cotizar es la acción que el negocio quiere,
			    hablar con un asesor es la salida para quien todavía no sabe qué pedir.
			    Con ambos en relleno de acento, la primera decisión sería un volado. */}
			<div class="hero__actions">
				<a href="/contacto" class="btn btn--primary">Cotizar Proyecto</a>
				<a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="btn btn--hero-ghost">
					Hablar con un Asesor
				</a>
			</div>
		</div>
	</section>

	{/* --- Servicios principales: las tres filas que pide el PDF, alternadas --- */}
	<section class="section services-strip" aria-labelledby="servicios-principales">
		<div class="container">
			<div class="section-head">
				<span class="eyebrow">Principales servicios</span>
				<h2 id="servicios-principales">Lo que hacemos en taller</h2>
			</div>

			<div class="strip">
				{
					mainServices.map((service, i) => (
						<article class:list={["strip__row", { "strip__row--flip": i % 2 === 1 }]}>
							<div class="strip__text">
								<span class="strip__index">{String(i + 1).padStart(2, "0")}</span>
								<h3>{service.title}</h3>
								<p>{service.blurb}</p>
								<a href={`/servicios#${service.slug}`} class="strip__link">Ver el detalle</a>
							</div>

							<div class="strip__media">
								{service.media.map((m) => <MediaPlaceholder slot={m.slot} ratio={m.ratio} />)}
							</div>
						</article>
					))
				}
			</div>
		</div>
	</section>

	{/* --- INICIO 2 e INICIO 3: las dos placas de marca --- */}
	{
		brands.map((brand, i) => (
			<section class:list={["section", "brand-section", { "section--alt": i % 2 === 1 }]}>
				<div class="container">
					<BrandCard brand={brand} eager={i === 0} />
				</div>
			</section>
		))
	}

	{/* --- INICIO 4: cierre --- */}
	<section class="section closing">
		<div class="container closing__inner">
			<h2>Cotiza tu proyecto</h2>
			<p>Medimos tu espacio, te mostramos la propuesta con plazos y recién ahí fabricamos.</p>

			<div class="closing__actions">
				<a href="/contacto" class="btn btn--primary">Cotizar Proyecto</a>
				<a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="btn btn--whatsapp">
					<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
						<path
							d="M12.02 2c-5.5 0-9.98 4.48-9.98 9.98 0 1.76.46 3.48 1.34 4.99L2 22l5.2-1.36a9.94 9.94 0 0 0 4.82 1.23h.01c5.5 0 9.98-4.47 9.98-9.98C22 6.48 17.53 2 12.02 2Zm0 18.26h-.01a8.3 8.3 0 0 1-4.24-1.16l-.3-.18-3.09.81.82-3.01-.2-.31a8.26 8.26 0 0 1-1.27-4.43c0-4.57 3.72-8.29 8.3-8.29 2.22 0 4.3.86 5.87 2.43a8.23 8.23 0 0 1 2.43 5.87c0 4.58-3.73 8.27-8.31 8.27Zm4.53-6.19c-.25-.12-1.46-.72-1.68-.8-.23-.08-.39-.12-.56.12-.16.25-.64.8-.78.97-.14.16-.29.18-.53.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.39-1.72-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.12-.14.16-.25.25-.41.08-.16.04-.31-.02-.43-.06-.12-.56-1.35-.77-1.85-.2-.48-.41-.42-.56-.43h-.48c-.16 0-.43.06-.66.31-.23.25-.86.84-.86 2.04 0 1.2.88 2.37 1 2.53.12.16 1.73 2.64 4.2 3.7.59.25 1.04.4 1.4.52.59.19 1.12.16 1.54.1.47-.07 1.46-.6 1.66-1.17.21-.58.21-1.07.14-1.17-.06-.11-.22-.17-.47-.29Z"
						></path>
					</svg>
					Escríbenos por WhatsApp
				</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	/* =========================================================
	   INICIO 1 — Hero
	   ---------------------------------------------------------
	   Pasa POR DEBAJO del header translúcido, así que el padding
	   superior compensa la barra para que el bloque de texto quede
	   centrado en el área realmente visible, no en la sección.
	   ========================================================= */
	.hero {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 80vh;
		padding-top: var(--header-height);
		padding-bottom: clamp(2rem, 5vw, 3rem);
		overflow: hidden;
		background-color: var(--color-steel);
		border-bottom: 1px solid var(--color-border);
	}

	/* `<img>` en lugar de background-image: el preloader del navegador la
	   descubre en el HTML inicial y la trata como candidata a LCP. Un
	   background-image en CSS solo se descarga tras resolver la hoja de estilo. */
	.hero__media {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* Velo de acero: baja la foto lo justo para que el texto blanco pase AA
	   con holgura sin apagar la imagen. */
	.hero__veil {
		position: absolute;
		inset: 0;
		background-color: rgba(95, 94, 94, 0.6);
	}

	.hero__inner {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}

	.hero__eyebrow {
		font-size: 0.875rem;
		font-weight: 600;
		line-height: 1;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--color-accent-light);
		text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
		margin-bottom: 1.5rem;
	}

	/* El titular del cliente tiene 70 caracteres. Con la escala global de h1 y
	   20ch de medida se parte en cinco líneas y se come el hero entero, así que
	   aquí baja un escalón y la medida sube: cabe en dos o tres líneas y el
	   subtítulo y los CTA vuelven a entrar en la primera pantalla. */
	.hero__title {
		max-width: 26ch;
		font-size: clamp(1.75rem, 3.6vw, 3rem);
		line-height: 1.08;
		color: #fff;
		text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
		margin-bottom: 1.5rem;
	}

	.hero__lead {
		max-width: 62ch;
		font-size: 1.125rem;
		color: rgba(255, 255, 255, 0.92);
		text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
		margin-bottom: 0;
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		margin-top: 2rem;
	}

	.hero__actions .btn {
		padding: 1rem 2rem;
	}

	/* Secundario sobre el velo de acero: el contorno claro se lee sin competir
	   con el relleno de acento del CTA principal. El rojo de marca sobre este
	   fondo da 1.18:1, así que aquí el secundario va en blanco. */
	.btn--hero-ghost {
		background-color: transparent;
		border-color: rgba(255, 255, 255, 0.75);
		color: #fff;
	}

	.btn--hero-ghost:hover {
		border-color: #fff;
		background-color: rgba(255, 255, 255, 0.14);
		color: #fff;
	}

	/* =========================================================
	   Servicios principales — tres filas alternadas
	   ---------------------------------------------------------
	   El PDF pide tres servicios con dos imágenes cada uno. En tres
	   columnas iguales las seis fotos quedan en miniaturas donde no
	   se distingue el trabajo, y la composición cae en la grilla de
	   tarjetas simétricas que delata una plantilla. Alternando el
	   lado del texto, cada servicio tiene su propia fila ancha.
	   ========================================================= */
	.strip {
		display: flex;
		flex-direction: column;
		gap: clamp(2rem, 5vw, 3.5rem);
	}

	.strip__row {
		display: grid;
		gap: clamp(1.25rem, 3vw, 2.5rem);
		align-items: center;
	}

	@media (min-width: 900px) {
		.strip__row {
			grid-template-columns: 0.85fr 1.15fr;
		}

		/* El flip invierte solo el orden visual: el DOM mantiene texto → imágenes,
		   que es el orden en que conviene leerlo y escucharlo. */
		.strip__row--flip .strip__text {
			order: 2;
		}
	}

	.strip__index {
		display: block;
		font-family: var(--font-heading);
		font-variant-numeric: tabular-nums;
		font-weight: 800;
		font-size: 0.875rem;
		letter-spacing: 0.08em;
		color: var(--color-accent);
		margin-bottom: 0.75rem;
	}

	.strip__text h3 {
		font-size: clamp(1.25rem, 2.6vw, 1.75rem);
		margin-bottom: 0.75rem;
	}

	.strip__text p {
		max-width: 46ch;
		margin-bottom: 1.25rem;
	}

	.strip__link {
		display: inline-flex;
		align-items: center;
		min-height: var(--tap);
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 0.875rem;
		letter-spacing: 0.02em;
		color: var(--color-accent);
		border-bottom: 1px solid currentColor;
	}

	.strip__link:hover {
		color: var(--color-accent-dark);
	}

	/* Las dos fotos comparten la junta de 1px del sistema, igual que el bento. */
	.strip__media {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1px;
		background-color: var(--color-border);
		border: 1px solid var(--color-border);
		container-type: inline-size;
	}

	/* =========================================================
	   INICIO 2 / 3 — Placas de marca
	   ========================================================= */
	.brand-section {
		background-color: var(--color-bg);
		border-bottom: 1px solid var(--color-border);
	}

	/* `.section--alt` ya trae el gris; se repite aquí para ganarle en
	   especificidad a `.brand-section`, que si no lo pisaría por orden. */
	.brand-section.section--alt {
		background-color: var(--color-bg-alt);
	}

	/* =========================================================
	   INICIO 4 — Cierre
	   ========================================================= */
	.closing {
		background-color: var(--color-surface-high);
		border-bottom: 1px solid var(--color-border);
		padding-top: clamp(3rem, 8vw, 6rem);
		padding-bottom: clamp(3rem, 8vw, 6rem);
	}

	.closing__inner {
		text-align: center;
	}

	.closing h2 {
		margin-bottom: 1.5rem;
	}

	.closing p {
		max-width: 62ch;
		margin: 0 auto 2.5rem;
		font-size: 1.125rem;
	}

	.closing__actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1rem;
	}

	.closing__actions .btn {
		padding: 1rem 2rem;
	}
</style>
