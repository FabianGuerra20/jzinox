---
/**
 * Inicio.
 *
 * De arriba abajo:
 *   1. Hero partido: titular a la izquierda, foto del taller a sangre a la
 *      derecha y, cerrando, el cartucho del plano con los cuatro datos.
 *   2. Bloque de JZ INOX      (pedido del cliente: va primero)
 *   3. Bloque de AL Mueblería (sección clara, composición invertida)
 *   4. Servicios principales: columna fija con la foto + tres renglones
 *   5. Cierre a gran tamaño con doble CTA
 *
 * El copy sale del PDF del cliente. Los bloques marcados [PROPUESTA] en
 * `src/data/` los redactamos nosotros y esperan validación.
 */
import Layout from "../layouts/Layout.astro";
import BrandShowcase from "../components/BrandShowcase.astro";
import { brands } from "../data/brands.js";
import { mainServices } from "../data/services.js";
import { site } from "../data/site.js";

/**
 * Imagen del hero. Para publicar otra foto basta con cambiar esta ruta.
 * Formato recomendado: horizontal, 2400 px de ancho, WebP bajo 300 KB.
 */
const heroImage = {
  src: "/img/taller-estanteria.webp",
  alt: "Taller de JZ INOX: estantería de acero inoxidable en fabricación junto a la plegadora",
};

// [PDF] Titular de la página de inicio. Se parte en palabras para que cada una
// suba por separado al cargar; el texto y su orden no cambian.
const heroTitle = "Fabricación, reparación y mantención de estructuras en acero inoxidable";
const heroWords = heroTitle.split(" ");

/**
 * Cartucho del plano: los cuatro datos que identifican al taller. Todos salen
 * del documento del cliente; ninguno es una cifra nueva.
 */
const titleBlock = [
  { label: "Oficio", value: "20+ años" },
  { label: "Origen", value: "Manufactura nacional" },
  { label: "Taller", value: "Propio, en Santiago" },
  { label: "Fabricación", value: "100% a medida" },
];

// El PDF pide dos imágenes por servicio; hasta que lleguen, la sección muestra
// la única foto real que hay y no los huecos rotulados.
const servicePhoto = mainServices.flatMap((service) => service.media).find((media) => media.src);

const whatsappHref = `https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent(site.whatsappDefaultMessage)}`;
---

<Layout
	flush
	title="Inicio"
	description="Fabricación, reparación y mantención de estructuras en acero inoxidable 100% a medida. Más de 20 años equipando restaurantes, comida rápida e industria alimentaria."
>
	{/* --- 1. Hero --- */}
	<section class="hero">
		<div class="hero__main">
			<div class="hero__copy">
				<h1 class="hero__title">
					{
						heroWords.map((word, i) => (
							<>
								<span class="hero__word" style={`--i: ${i}`}>
									<span>{word}</span>
								</span>{" "}
							</>
						))
					}
				</h1>
				<p class="hero__lead">
					Soluciones en acero inoxidable diseñadas a la medida de tu negocio. Fabricamos
					mesones, equipamiento y mobiliario de alta durabilidad para restaurantes, comida
					rápida e industria alimentaria.
				</p>
				{/* Dos CTA con peso distinto: cotizar es la acción que el negocio quiere,
				    WhatsApp es la salida para quien todavía no sabe qué pedir. */}
				<div class="hero__actions">
					<a href="/contacto" class="btn btn--primary">Cotizar Proyecto</a>
					<a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="btn btn--ghost">
						Escríbenos por WhatsApp
					</a>
				</div>
			</div>

			{/* `<img>` y no background-image: el preloader la descubre en el HTML
			    inicial y la trata como candidata a LCP. */}
			<figure class="hero__figure">
				<img src={heroImage.src} alt={heroImage.alt} width="1600" height="1189" fetchpriority="high" decoding="async" />
			</figure>
		</div>

		<dl class="hero__block">
			{
				titleBlock.map((cell, i) => (
					<div class="hero__cell" style={`--i: ${i}`}>
						<dt>{cell.label}</dt>
						<dd>{cell.value}</dd>
					</div>
				))
			}
		</dl>
	</section>

	{/* --- 2 y 3. Las dos marcas --- */}
	{
		brands.map((brand, i) => (
			<section class:list={["section", "brand-section", { "section--alt": i % 2 === 1 }]}>
				<div class="container">
					<BrandShowcase brand={brand} flip={i % 2 === 1} hideLead={i === 0} />
				</div>
			</section>
		))
	}

	{/* --- 4. Servicios principales --- */}
	<section class="section services" aria-labelledby="servicios-principales">
		<div class="container services__grid">
			<div class="services__aside">
				<div data-reveal>
					<span class="eyebrow">Principales servicios</span>
					<h2 id="servicios-principales">Lo que hacemos en taller</h2>
				</div>

				{
					servicePhoto && (
						<figure class="services__photo media-frame" data-reveal="cut">
							<img
								src={servicePhoto.src}
								alt={servicePhoto.alt}
								width="900"
								height="675"
								loading="lazy"
								decoding="async"
								style={servicePhoto.position ? `object-position: ${servicePhoto.position}` : undefined}
							/>
						</figure>
					)
				}
			</div>

			<ol class="services__list" role="list">
				{
					mainServices.map((service, i) => (
						<li class="services__item" data-reveal style={`--i: ${i}`}>
							<h3>{service.title}</h3>
							<p>{service.blurb}</p>
							<a href={`/servicios#${service.slug}`} class="services__link">
								Ver el detalle
								<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
									<path d="M5 12h14M13 6l6 6-6 6" />
								</svg>
							</a>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	{/* --- 5. Cierre --- */}
	<section class="closing" aria-labelledby="cierre">
		<div class="container">
			<span class="closing__seam" data-reveal="line" aria-hidden="true"></span>
			<div class="closing__inner" data-reveal>
				<h2 id="cierre">Cotiza tu proyecto</h2>
				<div class="closing__side">
					<p>Medimos tu espacio, te mostramos la propuesta con plazos y recién ahí fabricamos.</p>

					<div class="closing__actions">
						<a href="/contacto" class="btn btn--primary">Cotizar Proyecto</a>
						<a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="btn btn--whatsapp">
							<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
								<path
									d="M12.02 2c-5.5 0-9.98 4.48-9.98 9.98 0 1.76.46 3.48 1.34 4.99L2 22l5.2-1.36a9.94 9.94 0 0 0 4.82 1.23h.01c5.5 0 9.98-4.47 9.98-9.98C22 6.48 17.53 2 12.02 2Zm0 18.26h-.01a8.3 8.3 0 0 1-4.24-1.16l-.3-.18-3.09.81.82-3.01-.2-.31a8.26 8.26 0 0 1-1.27-4.43c0-4.57 3.72-8.29 8.3-8.29 2.22 0 4.3.86 5.87 2.43a8.23 8.23 0 0 1 2.43 5.87c0 4.58-3.73 8.27-8.31 8.27Zm4.53-6.19c-.25-.12-1.46-.72-1.68-.8-.23-.08-.39-.12-.56.12-.16.25-.64.8-.78.97-.14.16-.29.18-.53.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.39-1.72-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.12-.14.16-.25.25-.41.08-.16.04-.31-.02-.43-.06-.12-.56-1.35-.77-1.85-.2-.48-.41-.42-.56-.43h-.48c-.16 0-.43.06-.66.31-.23.25-.86.84-.86 2.04 0 1.2.88 2.37 1 2.53.12.16 1.73 2.64 4.2 3.7.59.25 1.04.4 1.4.52.59.19 1.12.16 1.54.1.47-.07 1.46-.6 1.66-1.17.21-.58.21-1.07.14-1.17-.06-.11-.22-.17-.47-.29Z"
								></path>
							</svg>
							Escríbenos por WhatsApp
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>
</Layout>

<style>
	/* =========================================================
	   1. Hero partido
	   ---------------------------------------------------------
	   El texto vive sobre el lienzo, no sobre la foto: así el
	   titular no necesita velo y la foto se ve a plena luz. La
	   foto sangra por la derecha y por arriba (pasa bajo la barra
	   translúcida). Debajo, el cartucho del plano.
	   ========================================================= */
	.hero {
		display: grid;
		grid-template-rows: 1fr auto;
		min-height: 100svh;
		background-color: var(--color-page);
		border-bottom: 1px solid var(--color-border);
	}

	.hero__main {
		display: grid;
	}

	.hero__copy {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		justify-content: center;
		padding: calc(var(--header-height) + clamp(2rem, 6vw, 3.5rem)) var(--margin-mobile) clamp(2rem, 6vw, 3.5rem);
	}

	.hero__figure {
		position: relative;
		margin: 0;
		min-height: 56vw;
		overflow: hidden;
		border-top: 1px solid var(--color-border);
	}

	.hero__figure img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 32% 50%;
	}

	@media (min-width: 960px) {
		.hero__main {
			grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
		}

		/* El margen izquierdo sigue al contenedor de 1440px del resto del sitio,
		   aunque el hero no use `.container` (la foto tiene que llegar al borde). */
		.hero__copy {
			padding-left: max(var(--margin-desktop), calc((100vw - var(--container-width)) / 2 + var(--margin-desktop)));
			padding-right: clamp(2rem, 4vw, 4.5rem);
		}

		.hero__figure {
			min-height: 0;
			border-top: 0;
			border-left: 1px solid var(--color-border);
		}
	}

	/* El titular del cliente tiene 70 caracteres: a 56px y 24ch cabe en cuatro
	   líneas. Cada palabra va en su propia caja recortada para la entrada. */
	.hero__title {
		max-width: 24ch;
		font-size: clamp(1.9rem, 3.9vw, 3.5rem);
		line-height: 1.08;
		margin-bottom: 1.5rem;
	}

	/* El recorte se extiende hacia arriba para no comerse la tilde de las
	   mayúsculas (FABRICACIÓN), que sobresale de la caja de línea. */
	.hero__word {
		display: inline-block;
		vertical-align: top;
		clip-path: inset(-0.25em -0.05em 0 -0.05em);
	}

	.hero__word > span {
		display: inline-block;
	}

	.hero__lead {
		max-width: 52ch;
		font-size: 1.125rem;
		margin-bottom: 0;
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		margin-top: 2rem;
	}

	.hero__actions .btn {
		padding: 1rem 1.75rem;
	}

	/* --- Cartucho del plano --- */
	.hero__block {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1px;
		margin: 0;
		background-color: var(--color-border);
		border-top: 1px solid var(--color-border);
	}

	.hero__cell {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		padding: 1rem var(--margin-mobile) 1.1rem;
		background-color: var(--color-bg);
	}

	.hero__cell dt {
		font-size: 0.75rem;
		font-weight: 500;
		line-height: 1;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.hero__cell dd {
		margin: 0;
		font-family: var(--font-heading);
		font-size: clamp(1rem, 1.5vw, 1.25rem);
		font-weight: 600;
		line-height: 1.2;
		color: var(--color-text);
	}

	@media (min-width: 960px) {
		.hero__block {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}

		.hero__cell {
			padding: 1.25rem 2rem 1.4rem;
		}

		.hero__cell:first-child {
			padding-left: max(var(--margin-desktop), calc((100vw - var(--container-width)) / 2 + var(--margin-desktop)));
		}
	}

	/* --- Entrada: una sola vez, al cargar --- */
	@keyframes word-up {
		from {
			transform: translateY(105%);
		}
		to {
			transform: none;
		}
	}

	@keyframes cut-in {
		from {
			clip-path: inset(0 100% 0 0);
		}
		to {
			clip-path: inset(0 0 0 0);
		}
	}

	@keyframes hero-settle {
		from {
			transform: scale(1.1);
		}
		to {
			transform: none;
		}
	}

	@keyframes hero-rise {
		from {
			opacity: 0;
			transform: translateY(14px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.hero__word > span {
			animation: word-up 0.7s var(--ease-out) both;
			animation-delay: calc(var(--i) * 35ms);
		}

		.hero__lead,
		.hero__actions {
			animation: hero-rise 0.6s var(--ease-out) 0.35s both;
		}

		.hero__actions {
			animation-delay: 0.42s;
		}

		/* La foto entra como un corte de guillotina, de izquierda a derecha, y
		   se asienta por debajo: el mismo sentido que la costura del canto. */
		.hero__figure {
			animation: cut-in 0.8s var(--ease-in-out) both;
		}

		.hero__figure img {
			animation: hero-settle 1.4s var(--ease-out) both;
		}

		.hero__cell > * {
			animation: hero-rise 0.6s var(--ease-out) both;
			animation-delay: calc(0.45s + var(--i) * 60ms);
		}
	}

	/* =========================================================
	   2 y 3. Bloques de marca
	   ========================================================= */
	.brand-section {
		border-bottom: 1px solid var(--color-border);
	}

	/* =========================================================
	   4. Servicios — columna fija + renglones
	   ---------------------------------------------------------
	   El título y la foto se quedan a la vista mientras pasan los
	   tres servicios. Sin tarjetas: cada renglón se separa del
	   siguiente con la junta de 1px.
	   ========================================================= */
	.services__grid {
		display: grid;
		gap: clamp(2rem, 5vw, 4rem);
	}

	.services__aside h2 {
		margin-bottom: 0;
	}

	.services__photo {
		margin: clamp(1.5rem, 3vw, 2.25rem) 0 0;
		aspect-ratio: 4 / 3;
		border: 1px solid var(--color-border);
	}

	.services__photo img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	@media (min-width: 1024px) {
		.services__grid {
			grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
			align-items: start;
		}

		.services__aside {
			position: sticky;
			top: calc(var(--header-height) + 2rem);
		}
	}

	.services__list {
		border-bottom: 1px solid var(--color-border);
	}

	.services__item {
		padding: clamp(1.5rem, 3.4vw, 2.5rem) 0;
		border-top: 1px solid var(--color-border);
	}

	.services__item h3 {
		font-size: clamp(1.5rem, 2.8vw, 2.25rem);
		line-height: 1.12;
		letter-spacing: -0.015em;
		font-weight: 700;
		margin-bottom: 0.75rem;
	}

	.services__item p {
		max-width: 52ch;
		font-size: 1.0625rem;
		margin-bottom: 1rem;
	}

	.services__link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		min-height: var(--tap);
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 0.9375rem;
		color: var(--color-accent);
		transition: color 0.2s ease;
	}

	.services__link svg {
		transition: transform 0.2s var(--ease-out);
	}

	@media (hover: hover) and (pointer: fine) {
		.services__link:hover {
			color: var(--color-accent-dark);
		}

		.services__link:hover svg {
			transform: translateX(4px);
		}
	}

	/* =========================================================
	   5. Cierre
	   ---------------------------------------------------------
	   La costura de soldadura vuelve aquí como línea superior: se
	   traza al entrar en pantalla y deja el titular apoyado en ella.
	   ========================================================= */
	.closing {
		background-color: var(--color-surface-high);
		border-bottom: 1px solid var(--color-border);
		padding: clamp(3.5rem, 9vw, 7.5rem) 0;
	}

	.closing__seam {
		display: block;
		height: 2px;
		margin-bottom: clamp(1.75rem, 4vw, 3rem);
		background: linear-gradient(90deg, var(--color-accent) 0, var(--color-accent) 92%, #ffe9c9 100%);
		transform-origin: left center;
	}

	.closing__inner {
		display: grid;
		gap: 1.5rem clamp(2rem, 5vw, 4rem);
	}

	@media (min-width: 1024px) {
		.closing__inner {
			grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
			align-items: end;
		}
	}

	.closing h2 {
		font-size: clamp(2.5rem, 7.2vw, 6rem);
		font-weight: 800;
		line-height: 0.95;
		letter-spacing: -0.03em;
		text-transform: uppercase;
		margin: 0;
	}

	.closing p {
		max-width: 46ch;
		font-size: 1.125rem;
		margin: 0 0 1.75rem;
	}

	.closing__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
	}

	.closing__actions .btn {
		padding: 1rem 1.75rem;
	}

	@media (prefers-reduced-motion: reduce) {
		.services__link svg {
			transition: none;
		}

		.services__link:hover svg {
			transform: none;
		}
	}
</style>
