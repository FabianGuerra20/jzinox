---
import Layout from "../layouts/Layout.astro";
import WhatsAppIcon from "../components/WhatsAppIcon.astro";
import { site } from "../data/site.js";

const whatsappHref = `https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent(site.whatsappDefaultMessage)}`;
---

<Layout title="Página no encontrada" description="La página que buscas no existe o cambió de dirección." noindex>
	<section class="section page-hero status-page" aria-labelledby="notfound-titulo">
		<div class="container">
			<h1 id="notfound-titulo">Esta página no existe</h1>
			<p>El enlace puede estar roto o la página cambió de dirección. Prueba por aquí, o pregúntanos y te decimos dónde está.</p>
			<nav class="status-page__actions" aria-label="Dónde seguir">
				<a href="/" class="btn btn--primary">Volver al inicio</a>
				<a href="/catalogo" class="btn btn--outline">Ver productos</a>
				<a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="btn btn--whatsapp">
					<WhatsAppIcon size={18} />
					Cotizar por WhatsApp
				</a>
			</nav>
		</div>
	</section>
</Layout>

<style>
	.status-page {
		display: flex;
		align-items: center;
		min-height: calc(100svh - var(--header-height) - 12rem);
	}

	.status-page p {
		max-width: 52ch;
		font-size: 1.125rem;
	}

	.status-page__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2rem;
	}

	:global(body:has(.status-page) .fab) {
		display: none;
	}
</style>
