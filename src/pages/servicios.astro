---
import Layout from "../layouts/Layout.astro";
import WhatsAppIcon from "../components/WhatsAppIcon.astro";
import MediaPair from "../components/MediaPair.astro";
import { services, mainServices, processSteps, faqs } from "../data/services.js";
import { site } from "../data/site.js";
import { faqSchema } from "../utils/schema.js";

const whatsappHref = `https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent(site.whatsappDefaultMessage)}`;
const faqLd = JSON.stringify(faqSchema(faqs));
const mediaOf = (service) => service.media ?? mainServices.find((main) => main.slug === service.slug)?.media;
---

<Layout
	title="Corte, plegado y diseño en acero inoxidable"
	description="Corte y plegado de plancha, diseño de proyecto, campanas, mesones y reparación en acero inoxidable. Taller propio en San Miguel, Santiago. Cotiza tu proyecto."
	breadcrumb="Servicios"
	jsonLd={faqLd}
>
	<section class="section page-hero page-hero--split" aria-labelledby="servicios-titulo">
		<div class="container">
			<h1 id="servicios-titulo">Soldadura, corte, plegado y diseño en acero inoxidable</h1>
			<p>
				Hacemos el proyecto completo en taller propio: medimos tu espacio, diseñamos la
				solución, cortamos y plegamos la plancha, soldamos e instalamos.
			</p>
		</div>
	</section>

	<section class="section section--alt" aria-labelledby="servicios-listado">
		<div class="container">
			<div class="section-head" data-reveal>
				<h2 id="servicios-listado">De la medición a la instalación</h2>
			</div>

			<div class="ledger">
				{
					services.map((service) => (
						<article class="ledger__row" id={service.slug} data-reveal>
							<h3>{service.title}</h3>
							{service.href ? (
								<div class="ledger__body">
									<p>{service.summary}</p>
									<a href={service.href} class="arrow-link link-press">
										{service.linkLabel}
										<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
											<path d="M5 12h14M13 6l6 6-6 6" />
										</svg>
									</a>
								</div>
							) : (
								<p>{service.summary}</p>
							)}
							<ul class="check-list">
								{service.details.map((detail) => <li>{detail}</li>)}
							</ul>
							{mediaOf(service) && (
								<div class="ledger__media">
									<MediaPair media={mediaOf(service)} sizes="(min-width: 1024px) 20vw, 46vw" />
								</div>
							)}
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="servicios-proceso">
		<div class="container">
			<div class="section-head" data-reveal>
				<h2 id="servicios-proceso">Cómo trabajamos</h2>
				<p>Cómo avanza tu proyecto, de la primera visita a la instalación.</p>
			</div>

			<div class="timeline">
				<span class="timeline__line" data-reveal="line" aria-hidden="true"></span>
				<ol class="timeline__steps" role="list">
					{
						processSteps.map((step, i) => (
							<li class="timeline__step" data-reveal style={`--i: ${i}`}>
								<span class="timeline__num">Paso {i + 1}</span>
								<h3>{step.title}</h3>
								<p>{step.description}</p>
							</li>
						))
					}
				</ol>
			</div>
		</div>
	</section>

	<section class="section section--alt" aria-labelledby="servicios-preguntas">
		<div class="container faq-layout">
			<div class="faq-layout__head" data-reveal>
				<h2 id="servicios-preguntas">Preguntas frecuentes</h2>
				<p>¿No está la tuya? Escríbenos y te respondemos en horario de taller.</p>
				<a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="btn btn--whatsapp">
					<WhatsAppIcon size={18} />
					Contáctanos por WhatsApp
				</a>
			</div>

			<div class="faq" data-reveal>
				{
					faqs.map((faq) => (
						<details class="faq__item">
							<summary>{faq.question}</summary>
							<p>{faq.answer}</p>
						</details>
					))
				}
			</div>
		</div>
	</section>

	<section class="section section--tight cta-band" aria-labelledby="servicios-cierre">
		<div class="container">
			<div class="cta-band__inner" data-reveal>
			<div class="cta-band__text">
				<h2 id="servicios-cierre">¿Cotizamos tu proyecto?</h2>
				<p>Cuéntanos qué necesitas y te respondemos con medidas, materiales y plazos.</p>
			</div>
			<div class="cta-band__actions">
				<a href="/contacto" class="btn btn--primary">Cotizar proyecto</a>
				<a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="btn btn--whatsapp">
					<WhatsAppIcon size={18} />
					Contáctanos por WhatsApp
				</a>
			</div>
		</div>
		</div>
	</section>
</Layout>

<style>
	.ledger__media {
		margin-top: 0.75rem;
	}

	@media (min-width: 1024px) {
		.ledger__row {
			grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
			grid-template-areas:
				"title body"
				"title list";
			column-gap: var(--gutter);
		}

		.ledger__row:has(.ledger__media) {
			grid-template-areas:
				"media title"
				"media body"
				"media list";
			grid-template-rows: auto auto 1fr;
		}

		.ledger__row h3 {
			grid-area: title;
		}

		.ledger__row > p,
		.ledger__body {
			grid-area: body;
		}

		.ledger__row .check-list {
			grid-area: list;
		}

		.ledger__media {
			grid-area: media;
			margin-top: 0;
		}
	}

	.timeline {
		position: relative;
	}

	.timeline__line {
		position: absolute;
		top: 0;
		bottom: 0;
		left: 5px;
		width: 1px;
		background-color: var(--color-text-muted);
		transform-origin: top center;
	}

	.timeline__steps {
		display: grid;
		gap: 2rem;
		margin: 0;
		padding: 0;
	}

	.timeline__step {
		position: relative;
		padding-left: 2rem;
	}

	.timeline__step::before {
		content: "";
		position: absolute;
		top: 0.15rem;
		left: 0;
		width: 11px;
		height: 11px;
		border-radius: 50%;
		background-color: var(--color-page);
		box-shadow: inset 0 0 0 2px var(--color-accent);
	}

	@media (min-width: 1024px) {
		.timeline__line {
			top: 5px;
			bottom: auto;
			left: 0;
			right: 0;
			width: auto;
			height: 1px;
			transform-origin: left center;
		}

		.timeline__steps {
			grid-template-columns: repeat(4, minmax(0, 1fr));
			gap: var(--gutter);
		}

		.timeline__step {
			padding: 2rem 0 0;
		}
	}

	@media (max-width: 1023.98px) {
		:global(html.js) .timeline__line[data-reveal="line"] {
			transform-origin: top center;
		}

		:global(html.js) .timeline__line[data-reveal="line"]:not(.is-in) {
			transform: scaleY(0);
		}
	}

	.timeline__num {
		display: block;
		margin-bottom: 0.5rem;
		font-size: 0.875rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.timeline__step h3 {
		margin-bottom: 0.4rem;
	}

	.timeline__step p {
		max-width: 34ch;
		margin-bottom: 0;
	}
</style>
