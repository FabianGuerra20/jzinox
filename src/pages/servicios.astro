---
/**
 * Servicios de JZINOX.
 *
 * Los nombres de servicio son los reales; los textos de apoyo son placeholder
 * localizable (SERVICIOS 1..4, PASO 1..4) hasta que llegue el copy definitivo.
 * Jerarquía: h1 → h2 por sección → h3 por servicio y por etapa.
 */
import Layout from "../layouts/Layout.astro";
import ServiceIcon from "../components/ServiceIcon.astro";
import { services, processSteps } from "../data/services.js";
---

<Layout
	title="Servicios"
	description="Fabricación, instalación y mantención de equipamiento gastronómico en acero inoxidable: cocinas industriales, campanas, mesones, lavaplatos y soldadura TIG."
>
	{/* --- SERVICIOS 1: encabezado --- */}
	<section class="section page-hero" aria-labelledby="servicios-titulo">
		<div class="container">
			<span class="eyebrow">Servicios</span>
			<h1 id="servicios-titulo">SERVICIOS 1</h1>
			<p>
				Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor
				incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud.
			</p>
		</div>
	</section>

	{/* --- SERVICIOS 2: listado de servicios --- */}
	<section class="section section--alt" aria-labelledby="servicios-listado">
		<div class="container">
			<div class="section-head">
				<span class="eyebrow">Qué hacemos</span>
				<h2 id="servicios-listado">SERVICIOS 2</h2>
				<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor.</p>
			</div>

			<div class="bento bento--3">
				{
					services.map((service) => (
						<article class="bento__cell bento__cell--hover service-detail" id={service.slug}>
							<div class="bento__icon service-detail__icon">
								<ServiceIcon name={service.icon} />
							</div>
							<h3 class="service-detail__title">{service.title}</h3>
							<p>{service.summary}</p>
							<ul class="check-list">
								{service.details.map((detail) => <li>{detail}</li>)}
							</ul>
						</article>
					))
				}
			</div>
		</div>
	</section>

	{/* --- SERVICIOS 3: cómo trabajamos --- */}
	<section class="section" aria-labelledby="servicios-proceso">
		<div class="container">
			<div class="section-head">
				<span class="eyebrow">Cómo trabajamos</span>
				<h2 id="servicios-proceso">SERVICIOS 3</h2>
				<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor.</p>
			</div>

			<ol class="bento bento--4 steps" role="list">
				{
					processSteps.map((step, i) => (
						<li class="bento__cell steps__item">
							<span class="steps__num">{String(i + 1).padStart(2, "0")}</span>
							<h3>{step.title}</h3>
							<p>{step.description}</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	{/* --- SERVICIOS 4: cierre --- */}
	<section class="section section--alt cta-band" aria-labelledby="servicios-cierre">
		<div class="container cta-band__inner">
			<div>
				<h2 id="servicios-cierre">SERVICIOS 4</h2>
				<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor.</p>
			</div>
			<div class="cta-band__actions">
				<a href="/contacto" class="btn btn--primary">Cotizar Proyecto</a>
				<a href="/catalogo" class="btn btn--ghost">Ver catálogo</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	.service-detail__icon {
		margin-bottom: 1.1rem;
	}

	.steps {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	/* Numeración como viñeta de plano. Antes declaraba var(--font-mono), que
	   no se carga desde Google Fonts y aterrizaba en Consolas: una cara de
	   editor de código, ajena a Hanken Grotesk e Inter. Con la grotesca de
	   titulares y cifras tabulares, el 01/02/03/04 alinea en columna como la
	   llamada de un plano. */
	.steps__num {
		display: block;
		font-family: var(--font-heading);
		font-variant-numeric: tabular-nums;
		font-weight: 800;
		font-size: clamp(1.25rem, 3vw, 1.5rem);
		line-height: 1;
		letter-spacing: 0.02em;
		color: var(--color-accent);
		margin-bottom: 0.6rem;
	}

	/* El tamaño lo gobierna la escala global de h3; aquí solo se ajusta el
	   aire hacia la descripción. */
	.steps__item h3 {
		margin-bottom: 0.4rem;
	}

	/* Mismo cuerpo pequeño que .check-list y .btn. El 0.92rem anterior era un
	   valor suelto fuera de la escala. */
	.steps__item p {
		font-size: 0.875rem;
		margin-bottom: 0;
	}
</style>
