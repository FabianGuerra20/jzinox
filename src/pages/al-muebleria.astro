---
/**
 * Vista interna del aliado estratégico AL Mueblería.
 *
 * Landing resumida dentro del ecosistema JZ Inox: presentación, servicios
 * propios y galería de proyectos. Mantiene el fondo, la tipografía y las
 * juntas de 1px del sistema; no introduce una paleta paralela.
 *
 * Jerarquía SEO: h1 → h2 (secciones) → h3 (servicios y piezas).
 */
import Layout from "../layouts/Layout.astro";
import WhatsAppIcon from "../components/WhatsAppIcon.astro";
import { alMuebleriaPage, alMuebleriaCatalog, alMuebleria } from "../data/brands.js";
import { site } from "../data/site.js";
import { srcset } from "../utils/img.js";

const { hero, services, catalog, cta } = alMuebleriaPage;

// Foto del encabezado: la primera del mosaico del Inicio. Es la página con más
// fotos del sitio y antes abría con media pantalla de puro texto.
const heroPhoto = alMuebleria.images.find((image) => image.src);

const quoteHref = (item) =>
	`https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent(`Hola AL Mueblería, me interesa cotizar: ${item.name}`)}`;
---

<Layout
	title="AL Mueblería: muebles a medida en línea plana"
	description="Muebles a medida en línea plana y estilo industrial: clósets, cocinas empotradas y mobiliario comercial. Herrajes Häfele, Blum y Hettich."
>
	{/* --- Presentación --- */}
	<section class="section page-hero al-hero">
		<div class="container al-hero__grid">
			<div class="al-hero__copy">
				<span class="eyebrow">{hero.eyebrow}</span>
				<h1>{hero.title}</h1>
				<p class="al-hero__subtitle">{hero.subtitle}</p>
				<p>{hero.lead}</p>

				<div class="al-hero__actions">
					<a href="#al-catalogo" class="btn btn--primary">Ver proyectos</a>
					<a href="/contacto" class="btn btn--outline">Cotizar proyecto</a>
				</div>
			</div>

			{
				heroPhoto && (
					<figure class="al-hero__photo">
						<img
							src={heroPhoto.src}
							srcset={srcset(heroPhoto.src)}
							sizes="(min-width: 1024px) 40vw, 92vw"
							alt={heroPhoto.alt}
							style={heroPhoto.position ? `object-position: ${heroPhoto.position}` : undefined}
							width="800"
							height="600"
							decoding="async"
						/>
					</figure>
				)
			}
		</div>
	</section>

	{/* --- Servicios: renglones, como en /servicios --- */}
	<section class="section section--alt" id="servicios" aria-labelledby="al-servicios">
		<div class="container">
			<div class="section-head" data-reveal>
				<h2 id="al-servicios">{services.title}</h2>
				<p>{services.lead}</p>
			</div>

			<div class="ledger">
				{
					services.items.map((service) => (
						<article class="ledger__row" data-reveal>
							<h3>{service.title}</h3>
							<p>{service.summary}</p>
							<ul class="check-list">
								{service.details.map((detail) => <li>{detail}</li>)}
							</ul>
						</article>
					))
				}
			</div>
		</div>
	</section>

	{/* --- Proyectos --- */}
	<section class="section" id="al-catalogo" aria-labelledby="al-catalogo-title">
		<div class="container">
			<div class="section-head" data-reveal>
				<h2 id="al-catalogo-title">{catalog.title}</h2>
				<p>{catalog.lead}</p>
			</div>

			<div class="pgrid al-gallery">
				{
					alMuebleriaCatalog.map((item, i) => (
						<article class="pcard" data-reveal="fade" style={`--i: ${i % 3}`}>
							{/* Las fotos son verticales y el marco 4:3: tocar la foto la abre
							    completa. En mueblería el acabado es el argumento de venta. */}
							<a
								class="pcard__media media-frame"
								href={item.image.src}
								data-zoom
								data-alt={item.image.alt}
								aria-label={`Ampliar la foto de ${item.name}`}
							>
								<img
									src={item.image.src}
									srcset={srcset(item.image.src)}
									sizes="(min-width: 1100px) 420px, (min-width: 640px) 46vw, 46vw"
									alt={item.image.alt}
									style={item.image.position ? `object-position: ${item.image.position}` : undefined}
									width="800"
									height="600"
									loading="lazy"
									decoding="async"
								/>
							</a>
							<div class="pcard__body">
								<span class="pcard__kind">{item.category}</span>
								<h3 id={`${item.id}-name`}>{item.name}</h3>
								<p>{item.description}</p>
								<a
									id={`${item.id}-cta`}
									aria-labelledby={`${item.id}-cta ${item.id}-name`}
									href={quoteHref(item)}
									target="_blank"
									rel="noopener noreferrer"
									class="btn btn--whatsapp btn--sm"
								>
									<WhatsAppIcon size={16} />
									<span class="al-gallery__long">Cotizar por WhatsApp</span>
									<span class="al-gallery__short" aria-hidden="true">Cotizar</span>
								</a>
							</div>
						</article>
					))
				}
			</div>
		</div>
	</section>

	{/* --- Cierre --- */}
	<section class="section section--tight section--alt cta-band" aria-labelledby="al-cierre">
		<div class="container cta-band__inner" data-reveal>
			<div class="cta-band__text">
				<h2 id="al-cierre">{cta.title}</h2>
				<p>{cta.lead}</p>
			</div>
			<div class="cta-band__actions">
				<a href="/contacto" class="btn btn--primary">Cotizar proyecto</a>
				<a href={`tel:${site.phoneHref}`} class="btn btn--ghost">Llamar al {site.phoneDisplay}</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	/* --- Encabezado: texto a la izquierda, foto a la derecha --- */
	.al-hero__grid {
		display: grid;
		gap: clamp(1.75rem, 4vw, 3.5rem);
	}

	@media (min-width: 1024px) {
		.al-hero__grid {
			grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
			align-items: center;
		}
	}

	.al-hero__photo {
		margin: 0;
		border: 1px solid var(--color-border);
	}

	.al-hero__photo img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 4 / 3;
		object-fit: cover;
	}

	/* Bajada del titular: "Mueblistería y ebanistería" es el oficio de la marca.
	   Va en la grotesca de titulares, un escalón bajo el h1. */
	.al-hero__subtitle {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: clamp(1rem, 2.2vw, 1.25rem);
		letter-spacing: 0.01em;
		color: var(--color-text-muted);
		margin-bottom: 1.25rem;
	}

	.al-hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.75rem;
	}

	/* --- Galería --- */
	.al-gallery__short {
		display: none;
	}

	/* En teléfono, dos columnas con foto, tipo y nombre: ocho tarjetas completas
	   a una columna eran más de cinco pantallas. La descripción vuelve desde
	   640px; la foto completa siempre está a un toque. */
	@media (max-width: 639.98px) {
		.al-gallery {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 0.75rem;
		}

		.al-gallery .pcard__body {
			padding: 0.75rem;
		}

		.al-gallery .pcard h3 {
			font-size: 1rem;
		}

		.al-gallery .pcard p {
			display: none;
		}

		.al-gallery .btn {
			width: 100%;
			padding: 0 0.5rem;
		}

		.al-gallery__long {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip-path: inset(50%);
			white-space: nowrap;
		}

		.al-gallery__short {
			display: inline;
		}
	}
</style>
