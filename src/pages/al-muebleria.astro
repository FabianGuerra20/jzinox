---
/**
 * Vista interna del aliado estratégico AL Mueblería.
 *
 * Landing resumida dentro del ecosistema JZ Inox: presentación, servicios
 * propios y mini-catálogo de 4 piezas. Mantiene el fondo, la tipografía y las
 * juntas de 1px del sistema JZ Inox; no introduce una paleta paralela.
 *
 * Jerarquía SEO: h1 (marca) → h2 (secciones AL 2/3/4) → h3 (servicios y piezas).
 */
import Layout from "../layouts/Layout.astro";
import MediaPlaceholder from "../components/MediaPlaceholder.astro";
import { alMuebleriaPage, alMuebleriaCatalog, alMuebleria } from "../data/brands.js";
import { site } from "../data/site.js";

const { hero, services, catalog, cta } = alMuebleriaPage;
const featured = alMuebleriaCatalog.slice(0, 4);
---

<Layout
	title="AL Mueblería"
	description="Muebles a medida en línea plana y estilo industrial: clósets, cocinas empotradas y mobiliario comercial. Herrajes Häfele, Blum y Hettich."
>
	{/* --- AL 1: presentación de la marca --- */}
	<section class="section page-hero al-hero">
		<div class="container">
			<span class="eyebrow">{hero.eyebrow}</span>
			<h1>{hero.title}</h1>
			<p class="al-hero__subtitle">{hero.subtitle}</p>
			<p>{hero.lead}</p>

			<div class="al-hero__actions">
				<a href="#al-catalogo" class="btn btn--primary">Ver proyectos</a>
				<a href="/contacto" class="btn btn--outline">Cotizar Proyecto</a>
			</div>
		</div>
	</section>

	{/* --- AL 2: resumen de servicios --- */}
	<section class="section section--alt" id="servicios" aria-labelledby="al-servicios">
		<div class="container">
			<div class="section-head">
				<span class="eyebrow">{services.eyebrow}</span>
				<h2 id="al-servicios">{services.title}</h2>
				<p>{services.lead}</p>
			</div>

			{/* Tres celdas, no cuatro: el PDF entrega exactamente tres servicios
			    con sus viñetas. Forzar una cuarta obligaría a inventar un servicio. */}
			<div class="bento bento--3">
				{
					services.items.map((service, i) => (
						<article class="bento__cell bento__cell--hover al-service">
							<span class="bento__index">{String(i + 1).padStart(2, "0")}</span>
							<h3>{service.title}</h3>
							<p>{service.summary}</p>
							<ul class="check-list">
								{service.details.map((detail) => <li>{detail}</li>)}
							</ul>
						</article>
					))
				}
			</div>
		</div>
	</section>

	{/* --- AL 3: mini-catálogo destacado (máximo 4 piezas) --- */}
	<section class="section" id="al-catalogo" aria-labelledby="al-catalogo-title">
		<div class="container">
			<div class="section-head">
				<span class="eyebrow">{catalog.eyebrow}</span>
				<h2 id="al-catalogo-title">{catalog.title}</h2>
				<p>{catalog.lead}</p>
			</div>

			<div class="bento bento--4">
				{
					featured.map((item) => (
						<article class="bento__cell bento__cell--flush bento__cell--hover al-product">
							{/* Marco propio, NO `.media-frame`: aquel entrega la foto en
							    grayscale hasta el hover, y sin puntero (móvil, tablet) las
							    cuatro piezas se quedarían grises para siempre. En un
							    catálogo la madera y el acabado SON el dato. El marco existe
							    solo para anclar la barra de acento sobre la imagen. */}
							{/* Mientras no lleguen las fotos reales, el hueco dice qué foto va
							    ahí: una caja gris muda se lee como un error de carga. */}
							<div class="al-product__frame">
								{
									item.image.pending ? (
										<MediaPlaceholder slot={item.image.slot} ratio={item.image.ratio} />
									) : (
										<img
											src={item.image.src}
											alt={item.image.alt}
											width="800"
											height="600"
											loading="lazy"
											decoding="async"
											class="al-product__media"
										/>
									)
								}
							</div>
							<div class="al-product__body">
								<span class="tag">{item.category}</span>
								<h3>{item.name}</h3>
								<p>{item.description}</p>
								<a
									href={`https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent(`Hola, me interesa cotizar de AL Mueblería: ${item.name}`)}`}
									target="_blank"
									rel="noopener noreferrer"
									class="al-product__cta"
									aria-label={`Cotizar ${item.name} por WhatsApp`}
								>
									Cotizar por WhatsApp
								</a>
							</div>
						</article>
					))
				}
			</div>
		</div>
	</section>

	{/* --- AL 4: cierre + vuelta al ecosistema JZ Inox --- */}
	<section class="section section--alt" aria-labelledby="al-cierre">
		<div class="container">
			<div class="cta-plate">
				<div>
					<h2 id="al-cierre">{cta.title}</h2>
					<p>{cta.lead}</p>
				</div>
				<div class="cta-band__actions">
					<a href="/contacto" class="btn btn--primary">Cotizar Proyecto</a>
					<a href={`tel:${site.phoneHref}`} class="btn btn--outline">{site.phoneDisplay}</a>
				</div>
			</div>

			<aside class="al-ally">
				<p>
					{alMuebleria.name} es marca aliada de <strong>{site.name}</strong>.
					<a href="/">Volver al inicio</a>
				</p>
			</aside>
		</div>
	</section>
</Layout>

<style>
	/* Bajada del titular, no una etiqueta técnica: "Mueblistería y ebanistería"
	   es el oficio de la marca. Va en la grotesca de titulares, un escalón bajo
	   el h1. (--font-mono no se carga desde Google Fonts: aterrizaba en Consolas.) */
	.al-hero__subtitle {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: clamp(1rem, 2.2vw, 1.25rem);
		letter-spacing: 0.01em;
		color: var(--color-text-muted);
		margin-bottom: 1.25rem;
	}

	/* Mismo gap que `.cta-band__actions`: las dos filas de botones de la página
	   deben separar sus piezas con la misma medida. */
	.al-hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		margin-top: 1.6rem;
	}

	.al-service h3 {
		font-size: 1.02rem;
	}

	.al-service p {
		font-size: 0.92rem;
		margin-bottom: 0;
	}

	/* --- Piezas del mini-catálogo: imagen a sangre, texto en su propia caja --- */
	.al-product {
		display: flex;
		flex-direction: column;
	}

	/* `position: relative` es el único motivo por el que el marco existe: da el
	   sistema de coordenadas de la barra de acento. El borde vive aquí y no en
	   la imagen para que la junta de 1px sea del marco, no del medio. */
	.al-product__frame {
		position: relative;
		border-bottom: 1px solid var(--color-border);
	}

	/* La barra de acento del hover la pinta `.bento__cell--hover` como
	   `inset box-shadow` de la placa, así que queda DEBAJO de la imagen —que es
	   opaca— y se corta a su altura. Se repite aquí encima del medio para que la
	   marca recorra la tarjeta entera, como en las placas de servicios. El corte
	   de 1px sobre el borde inferior es la junta del plano. */
	.al-product__frame::after {
		content: "";
		position: absolute;
		top: 0;
		bottom: 0;
		left: 0;
		width: 3px;
		background-color: var(--color-accent);
		opacity: 0;
		transition: opacity 0.2s ease;
	}

	.al-product:hover .al-product__frame::after,
	.al-product:focus-within .al-product__frame::after {
		opacity: 1;
	}

	/* `height: auto` es obligatorio: sin él manda el atributo height="600" del
	   HTML y el aspect-ratio queda ignorado. `display: block` también: dentro
	   del marco la imagen ya no es un ítem flex, y como inline arrastraría el
	   hueco del descendente (~5px) entre la foto y la junta inferior. */
	.al-product__media {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 4 / 3;
		object-fit: cover;
	}

	/* La celda va `--flush` (padding 0) porque la imagen sangra; el cuerpo tiene
	   que devolver EXACTAMENTE el padding de `.bento__cell`. Con el valor fijo
	   anterior, calibrado para el contenedor de 1180px, el texto de las piezas
	   quedaba 10px más pegado al canto que el de las placas de servicios
	   inmediatamente encima, y no crecía al ensanchar el contenedor a 1440px. */
	.al-product__body {
		display: flex;
		flex-direction: column;
		flex: 1;
		padding: clamp(1.5rem, 3.6vw, 2rem);
	}

	.al-product h3 {
		font-size: 1rem;
		margin: 0.7rem 0 0.5rem;
	}

	.al-product p {
		font-size: 0.9rem;
		flex: 1;
	}

	/* Mismo caso que en /productos: CTA de conversión con 44px de alto táctil */
	.al-product__cta {
		display: inline-flex;
		align-items: center;
		min-height: var(--tap);
		font-size: 0.88rem;
		font-weight: 600;
		color: var(--color-accent);
	}

	.al-product__cta:hover {
		text-decoration: underline;
	}

	.tag {
		align-self: flex-start;
	}

	/* --- Anclaje al ecosistema: de vuelta a la marca principal --- */
	/* Se apila justo debajo de `.cta-plate`: el padding horizontal es el mismo
	   que el de la placa para que las dos líneas de texto arranquen del mismo
	   eje vertical. Con el valor fijo anterior se descuadraban ~17px en
	   escritorio. */
	.al-ally {
		margin-top: 1.5rem;
		border: 1px solid var(--color-border);
		padding: 1rem clamp(1.8rem, 4vw, 2.4rem);
		background-color: var(--color-bg);
	}

	.al-ally p {
		margin: 0;
		font-size: 0.9rem;
	}

	.al-ally a {
		display: inline-flex;
		align-items: center;
		min-height: var(--tap);
		color: var(--color-accent);
		font-weight: 600;
		margin-left: 0.5rem;
	}

	.al-ally a:hover {
		text-decoration: underline;
	}
</style>
