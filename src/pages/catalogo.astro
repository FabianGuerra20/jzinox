---
import Layout from "../layouts/Layout.astro";
import { catalog, catalogCategories, pricesArePlaceholder } from "../data/catalog.js";
import { site } from "../data/site.js";

const formatPrice = (price) =>
	price > 0
		? new Intl.NumberFormat("es-CL", { style: "currency", currency: "CLP", maximumFractionDigits: 0 }).format(price)
		: "A cotizar";

const slugify = (value) =>
	value
		.toLowerCase()
		.normalize("NFD")
		.replace(/[\u0300-\u036f]/g, "")
		.replace(/[^a-z0-9]+/g, "-")
		.replace(/(^-|-$)/g, "");

const groups = catalogCategories
	.filter((category) => category !== "Todos")
	.map((category) => ({
		name: category,
		id: slugify(category),
		items: catalog.filter((item) => item.category === category),
	}))
	.filter((group) => group.items.length > 0);
---

<Layout
	title="Catálogo"
	description="Catálogo de mesones, lavaplatos, campanas y estructuras en acero inoxidable con valores referenciales para dimensionar tu proyecto."
>
	<section class="section page-hero">
		<div class="container">
			<span class="eyebrow">Catálogo</span>
			<h1>Catálogo y valores referenciales</h1>
			<p>
				Valores de referencia para dimensionar tu proyecto. El precio final depende de las
				medidas, el espesor de la plancha y la complejidad de la instalación.
			</p>

			{
				/* El aviso va ARRIBA, no en la nota al pie: una lista de precios que el
				   cliente puede confundir con la real es lo más riesgoso de esta maqueta.
				   Se apaga solo, desde catalog.js, cuando los precios sean los definitivos. */
				pricesArePlaceholder && (
					<p class="price-warning" role="note">
						<strong>Valores de demostración.</strong> Los precios de esta maqueta son
						referencias de ejemplo, no la lista de precios de JZINOX. Se reemplazan por
						los valores reales antes de publicar el sitio.
					</p>
				)
			}

			<nav class="catalog-nav" aria-label="Categorías del catálogo">
				{groups.map((group) => (
					<a href={`#${group.id}`}>{group.name}</a>
				))}
			</nav>
		</div>
	</section>

	{
		groups.map((group, index) => (
			<section
				class:list={["section", { "section--alt": index % 2 === 0 }]}
				id={group.id}
				aria-labelledby={`${group.id}-title`}
			>
				<div class="container">
					<h2 class="catalog-group-title" id={`${group.id}-title`}>{group.name}</h2>

					<div class="bento bento--3 catalog-grid">
						{group.items.map((item) => (
							<article class="bento__cell bento__cell--hover catalog-card">
								<span class="tag">{item.category}</span>
								<h3 id={`${item.id}-name`}>{item.name}</h3>
								<p>{item.description}</p>
								<div class="catalog-card__price">
									<strong>{formatPrice(item.price)}</strong>
									{item.price > 0 && <span>/ {item.unit}</span>}
								</div>
								{/* El nombre visible se repite en 15 enlaces idénticos: se compone el
								    nombre accesible con el h3 para que cada enlace se distinga (WCAG 2.4.4). */}
								<a
									id={`${item.id}-cta`}
									aria-labelledby={`${item.id}-cta ${item.id}-name`}
									href={`https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent(`Hola JZINOX, me interesa cotizar: ${item.name}`)}`}
									target="_blank"
									rel="noopener noreferrer"
									class="btn btn--ghost catalog-card__cta"
								>
									Cotizar este ítem
								</a>
							</article>
						))}
					</div>
				</div>
			</section>
		))
	}

	<section class="section">
		<div class="container">
			<p class="catalog-note">
				* Precios en pesos chilenos (CLP), referenciales al {new Date().getFullYear()}. No
				incluyen instalación en todos los casos ni traslados fuera de la {site.region}.
			</p>

			<div class="cta-plate">
				<div>
					<h2>¿No encuentras lo que buscas?</h2>
					<p>Fabricamos a medida según tus planos o el levantamiento en terreno.</p>
				</div>
				<a href="/contacto" class="btn btn--primary">Cotizar Proyecto</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	/* Amarillo de advertencia sobre la base clara: el único uso de un color
	   fuera de la paleta en todo el sitio, y es deliberado — su trabajo es
	   interrumpir la lectura, no integrarse. Texto grafito sobre #fdf6e3 da
	   14.8:1, muy por encima de AA. */
	.price-warning {
		margin-top: 1.5rem;
		padding: 0.9rem 1.1rem;
		border: 1px solid #d9c47a;
		border-left-width: 4px;
		background-color: #fdf6e3;
		color: var(--color-graphite);
		font-size: 0.9rem;
		max-width: 68ch;
	}

	.catalog-nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 1.5rem;
	}

	.catalog-nav a {
		display: inline-flex;
		align-items: center;
		min-height: var(--tap);
		font-family: var(--font-mono);
		font-size: 0.78rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		font-weight: 500;
		color: var(--color-graphite);
		background-color: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		padding: 0.4rem 0.95rem;
		transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
	}

	.catalog-nav a:hover {
		background-color: var(--color-accent);
		border-color: var(--color-accent);
		color: #fff;
	}

	.catalog-group-title {
		margin-bottom: 1.8rem;
		padding-bottom: 0.8rem;
		border-bottom: 1px solid var(--color-border);
	}

	.catalog-card {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		align-items: flex-start;
	}

	.catalog-card h3 {
		margin: 0.6rem 0 0;
		font-size: 1.05rem;
	}

	.catalog-card p {
		font-size: 0.9rem;
		flex-grow: 1;
		margin-bottom: 0;
	}

	.catalog-card__price {
		display: flex;
		align-items: baseline;
		gap: 0.4rem;
		font-family: var(--font-heading);
		font-weight: 700;
		color: var(--color-accent);
		font-size: clamp(1.1rem, 2.4vw, 1.25rem);
		margin: 0.4rem 0 0.6rem;
	}

	.catalog-card__price span {
		font-family: var(--font-body);
		font-weight: 400;
		font-size: 0.8rem;
		color: var(--color-text-muted);
	}

	.catalog-card__cta {
		font-size: 0.78rem;
		padding: 0.55rem 1.1rem;
	}

	/* Al pasar el cursor se apilan dos tintes: la celda va a --color-surface
	   (#f3f3f3) y encima .btn--ghost:hover añade rgba(193,61,47,.06), dando
	   #f0e8e7. El texto de acento sobre ese fondo mide 4.38:1 a 12.5px, bajo el
	   mínimo AA. Con --color-accent-dark vuelve a 5.36:1.
	   Solo :hover: en foco de teclado el botón NO recibe el lavado del ghost
	   (queda --color-graphite sobre #f3f3f3) y el anillo global de :focus-visible
	   ya marca el estado, así que ahí no hay nada que corregir. */
	.catalog-card__cta:hover {
		color: var(--color-accent-dark);
	}

	.catalog-note {
		font-size: 0.82rem;
		color: var(--color-steel);
		text-align: center;
		max-width: 70ch;
		margin: 0 auto 2.5rem;
	}

</style>
