---
import Layout from "../layouts/Layout.astro";
import WhatsAppIcon from "../components/WhatsAppIcon.astro";
import { catalog, catalogCategories } from "../data/catalog.js";
import { site } from "../data/site.js";
import { photoFill, srcset } from "../utils/img.js";

const slugify = (value) =>
	value
		.toLowerCase()
		.normalize("NFD")
		.replace(/[̀-ͯ]/g, "")
		.replace(/[^a-z0-9]+/g, "-")
		.replace(/(^-|-$)/g, "");

const hasPhoto = (item) => Boolean(item.image && !item.image.pending && item.image.src);

const photosOf = (item) => [item.image, ...(item.gallery ?? [])];

const toRuns = (items) =>
	items.reduce((runs, item) => {
		const kind = hasPhoto(item) ? "cards" : "rows";
		const last = runs[runs.length - 1];
		if (last && last.kind === kind) last.items.push(item);
		else runs.push({ kind, items: [item] });
		return runs;
	}, []);

const quoteHref = (item) =>
	`https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent(`Hola ${site.name}, me interesa cotizar: ${item.name}`)}`;

const catalogLd = JSON.stringify({
	"@context": "https://schema.org",
	"@type": "ItemList",
	name: `Productos de ${site.name}`,
	numberOfItems: catalog.length,
	itemListElement: catalog.map((item, i) => ({
		"@type": "ListItem",
		position: i + 1,
		name: item.name,
		url: `${site.siteUrl}/catalogo#${slugify(item.category)}`,
	})),
});

const groups = catalogCategories
	.map((category) => {
		const items = catalog.filter((item) => item.category === category);
		return { name: category, id: slugify(category), count: items.length, runs: toRuns(items) };
	})
	.filter((group) => group.count > 0);
---

<Layout
	title="Mesones y campanas de acero inoxidable a medida"
	description="Mesones, campanas, carros, soportes y protectores de acero inoxidable a medida para cocinas profesionales. Taller en San Miguel, Santiago. Cotiza por WhatsApp."
	jsonLd={catalogLd}
	breadcrumb="Productos"
>
	<section class="section page-hero page-hero--split">
		<div class="container">
			<h1>Productos en acero inoxidable a medida</h1>
			<p>
				{catalog.length} piezas que hacemos habitualmente, cada una a la medida de tu espacio. Si no está
				la que necesitas, la fabricamos igual.
			</p>
		</div>
	</section>

	<nav class="catalog-bar" aria-label="Categorías de productos">
		<div class="container catalog-bar__inner" data-catalog-bar>
			{groups.map((group) => (
				<a href={`#${group.id}`} class="catalog-bar__link" data-category={group.id} aria-label={`${group.name}, ${group.count} ${group.count === 1 ? "producto" : "productos"}`}>
					{group.name}
					<span class="catalog-bar__count" aria-hidden="true">{group.count}</span>
				</a>
			))}
		</div>
	</nav>

	<section class="section catalog">
		<div class="container catalog-groups">
			{
				groups.map((group) => (
					<section class="catalog-group" id={group.id} aria-labelledby={`${group.id}-title`}>
						<h2 class="catalog-group-title" id={`${group.id}-title`}>{group.name}</h2>

						{group.runs.map((run) =>
							run.kind === "cards" ? (
								<div class="pgrid catalog-run">
									{run.items.map((item, i) => (
										<article class="pcard" data-reveal style={`--i: ${i % 2}`}>
											<div class="pcard__gallery" data-gallery={photosOf(item).length > 1 ? "" : undefined}>
												{item.note && <span class="pcard__flag">{item.note}</span>}
												<div class="pcard__track">
													{photosOf(item).map((photo, n, all) => (
														<a
															class="pcard__media media-frame photo-fill"
															style={photoFill(photo.src)}
															href={photo.src}
															data-zoom
															data-alt={photo.alt}
															aria-label={all.length > 1 ? `Ampliar la foto ${n + 1} de ${all.length} de ${item.name}` : `Ampliar la foto de ${item.name}`}
														>
															<img
																src={photo.src}
																srcset={srcset(photo.src)}
																sizes="(min-width: 1100px) 640px, (min-width: 740px) 46vw, 92vw"
																alt={photo.alt}
																width="800"
																height="600"
																loading="lazy"
																decoding="async"
															/>
														</a>
													))}
												</div>
												{photosOf(item).length > 1 && (
													<div class="pcard__nav">
														<button type="button" class="pcard__step" data-step="-1" aria-label={`Foto anterior de ${item.name}`}>
															<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M10 3 5 8l5 5" /></svg>
														</button>
														<span class="pcard__count" data-count>1 / {photosOf(item).length}</span>
														<button type="button" class="pcard__step" data-step="1" aria-label={`Foto siguiente de ${item.name}`}>
															<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="m6 3 5 5-5 5" /></svg>
														</button>
													</div>
												)}
											</div>

											<div class="pcard__body">
												<h3 id={`${item.id}-name`}>{item.name}</h3>
												{item.description && <p>{item.description}</p>}
												<a
													id={`${item.id}-cta`}
													aria-labelledby={`${item.id}-cta ${item.id}-name`}
													href={quoteHref(item)}
													target="_blank"
													rel="noopener noreferrer"
													class="btn btn--whatsapp btn--sm"
												>
													<WhatsAppIcon size={16} />
													Cotizar por WhatsApp
												</a>
											</div>
										</article>
									))}
								</div>
							) : (
								<ul class="prows catalog-run">
									{run.items.map((item) => (
										<li class="prow" data-reveal="fade">
											<h3 id={`${item.id}-name`}>{item.name}</h3>
											<p>{item.description}</p>
											<a
												id={`${item.id}-cta`}
												aria-labelledby={`${item.id}-cta ${item.id}-name`}
												href={quoteHref(item)}
												target="_blank"
												rel="noopener noreferrer"
												class="btn btn--whatsapp btn--sm"
											>
												<WhatsAppIcon size={16} />
												Cotizar por WhatsApp
											</a>
										</li>
									))}
								</ul>
							),
						)}
					</section>
				))
			}
		</div>
	</section>

	<section class="section section--tight section--alt cta-band" aria-labelledby="catalogo-cierre">
		<div class="container">
			<div class="cta-band__inner" data-reveal>
			<div class="cta-band__text">
				<h2 id="catalogo-cierre">¿No encuentras lo que buscas?</h2>
				<p>Lo fabricamos a medida, con tu plano o tus medidas.</p>
			</div>
			<div class="cta-band__actions">
				<a href="/contacto" class="btn btn--primary">Cotizar proyecto</a>
			</div>
		</div>
		</div>
	</section>
</Layout>

<script>
	const bar = document.querySelector("[data-catalog-bar]");
	if (bar) {
		const links = new Map([...bar.querySelectorAll("[data-category]")].map((link) => [link.dataset.category, link]));
		const visible = new Set();
		let active = null;
		const mark = () => {
			const current = [...links.keys()].find((id) => visible.has(id)) ?? null;
			if (current === active) return;
			active = current;
			links.forEach((link, id) => {
				if (id === current) {
					link.setAttribute("aria-current", "location");
					const offset = link.getBoundingClientRect().left - bar.getBoundingClientRect().left;
					bar.scrollTo({ left: bar.scrollLeft + offset - (bar.clientWidth - link.offsetWidth) / 2, behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
				} else {
					link.removeAttribute("aria-current");
				}
			});
		};
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => (entry.isIntersecting ? visible.add(entry.target.id) : visible.delete(entry.target.id)));
				mark();
			},
			{ rootMargin: "-170px 0px -55% 0px" },
		);
		links.forEach((_, id) => {
			const section = document.getElementById(id);
			if (section) observer.observe(section);
		});
	}

	document.querySelectorAll("[data-gallery]").forEach((gallery) => {
		const track = gallery.querySelector(".pcard__track");
		const count = gallery.querySelector("[data-count]");
		const total = track.children.length;
		const current = () => Math.round(track.scrollLeft / track.clientWidth);
		gallery.querySelectorAll("[data-step]").forEach((button) => {
			button.addEventListener("click", () => {
				const step = Number(button.dataset.step);
				const next = (current() + step + total) % total;
				const wraps = Math.abs(next - current()) > 1;
				const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
				track.scrollTo({ left: next * track.clientWidth, behavior: reduced || wraps ? "auto" : "smooth" });
			});
		});
		track.addEventListener("scroll", () => {
			count.textContent = `${current() + 1} / ${total}`;
		}, { passive: true });
	});
</script>

<style>
	.catalog-bar {
		position: sticky;
		top: var(--header-height);
		z-index: 40;
		background-color: color-mix(in srgb, var(--color-page) 94%, transparent);
		-webkit-backdrop-filter: blur(10px);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid color-mix(in srgb, var(--color-border) 60%, transparent);
	}

	.catalog-bar__inner {
		display: flex;
		gap: 0.625rem;
		padding-block: 0.875rem;
		overflow-x: auto;
		overscroll-behavior-x: contain;
		scrollbar-width: none;
		white-space: nowrap;
	}

	.catalog-bar__inner::-webkit-scrollbar {
		display: none;
	}

	.catalog-bar__inner {
		-webkit-mask-image: linear-gradient(to right, #000 calc(100% - 2rem), transparent);
		mask-image: linear-gradient(to right, #000 calc(100% - 2rem), transparent);
	}

	.catalog-bar__link {
		display: inline-flex;
		align-items: center;
		gap: 0.625rem;
		flex: none;
		min-height: 48px;
		padding: 0 1rem 0 1.15rem;
		border-radius: var(--radius);
		background-color: var(--color-bg);
		box-shadow: var(--shadow-sm);
		font-family: var(--font-heading);
		font-size: 1rem;
		font-weight: 600;
		color: var(--color-text);
		touch-action: manipulation;
		transition:
			background-color 0.2s var(--ease-out),
			color 0.2s var(--ease-out),
			transform 0.16s var(--ease-out);
	}

	.catalog-bar__count {
		display: inline-grid;
		place-items: center;
		min-width: 1.5rem;
		height: 1.5rem;
		padding: 0 0.4rem;
		border-radius: var(--radius);
		background-color: var(--color-page);
		font-family: var(--font-body);
		font-size: 0.75rem;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
		color: var(--color-text-muted);
		transition:
			background-color 0.2s var(--ease-out),
			color 0.2s var(--ease-out);
	}

	.catalog-bar__link[aria-current="location"] {
		background-color: var(--color-accent);
		color: var(--color-on-accent);
	}

	.catalog-bar__link[aria-current="location"] .catalog-bar__count {
		background-color: color-mix(in srgb, var(--color-on-accent) 20%, transparent);
		color: var(--color-on-accent);
	}

	.catalog-bar__link:active {
		transform: scale(0.97);
	}

	@media (hover: hover) and (pointer: fine) {
		.catalog-bar__link:not([aria-current="location"]):hover {
			color: var(--color-accent);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.catalog-bar__link:active {
			transform: none;
		}
	}

	.catalog-groups {
		display: flex;
		flex-direction: column;
		gap: clamp(3rem, 6vw, 4.5rem);
	}

	.catalog-group {
		scroll-margin-top: 6rem;
	}

	.catalog-group-title {
		font-size: clamp(1.5rem, 2.4vw, 2rem);
		margin-bottom: 1.25rem;
	}

	.catalog-run + .catalog-run {
		margin-top: clamp(1rem, 2.4vw, var(--gutter));
	}

	@media (min-width: 1100px) {
		.catalog-group {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			column-gap: clamp(1rem, 2.4vw, var(--gutter));
			align-items: start;
		}

		.catalog-group > * {
			grid-column: 1 / -1;
		}

		.catalog-group > .pgrid:has(> .pcard:only-child) {
			grid-column: 1;
		}

		.catalog-group > .pgrid:has(> .pcard:only-child) + .prows {
			grid-column: 2;
			margin-top: 0;
		}
	}

	.pcard__gallery {
		position: relative;
	}

	.pcard__track {
		display: flex;
		overflow-x: auto;
		overscroll-behavior-x: contain;
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
	}

	.pcard__track::-webkit-scrollbar {
		display: none;
	}

	.pcard__track > .pcard__media {
		flex: 0 0 100%;
		scroll-snap-align: start;
	}

	.pcard__nav {
		position: absolute;
		left: 10px;
		bottom: 10px;
		display: flex;
		align-items: center;
		background-color: color-mix(in srgb, var(--color-bg) 92%, transparent);
		border-radius: var(--radius);
		box-shadow: var(--shadow-sm);
	}

	.pcard__step {
		display: grid;
		place-items: center;
		width: var(--tap);
		height: var(--tap);
		padding: 0;
		border: 0;
		background: none;
		color: var(--color-text);
		cursor: pointer;
		touch-action: manipulation;
	}

	.pcard__flag {
		position: absolute;
		top: 10px;
		left: 10px;
		z-index: 1;
		padding: 0.3rem 0.55rem;
		border-radius: var(--radius);
		background-color: color-mix(in srgb, var(--color-bg) 92%, transparent);
		box-shadow: var(--shadow-sm);
		font-size: 0.75rem;
		font-weight: 500;
		color: var(--color-text-muted);
		pointer-events: none;
	}

	@media (min-width: 700px) {
		.catalog .pgrid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.catalog .pgrid > .pcard:last-child:nth-child(odd) {
			grid-column: 1 / -1;
			flex-direction: row;
		}

		.catalog .pgrid > .pcard:last-child:nth-child(odd) .pcard__gallery {
			flex: 0 0 50%;
			min-width: 0;
		}

		.catalog .pgrid > .pcard:last-child:nth-child(odd) .pcard__body {
			justify-content: center;
		}

		.catalog .pgrid > .pcard:last-child:nth-child(odd) .btn {
			margin-top: 0.75rem;
		}

		.catalog .pgrid > .pcard:last-child:nth-child(odd) h3 {
			font-size: clamp(1.5rem, 2.2vw, 1.875rem);
		}
	}

	@media (min-width: 1100px) {
		.catalog .pgrid:has(> .pcard:only-child) {
			grid-template-columns: minmax(0, 1fr);
		}

		.catalog .pgrid > .pcard:only-child {
			flex-direction: column;
		}

		.catalog .pgrid > .pcard:only-child .pcard__gallery {
			flex: none;
		}
	}

	@media (min-width: 1100px) {
		.catalog-group > .pgrid:has(> .pcard:only-child) + .prows .prow {
			grid-template-columns: minmax(0, 1fr) auto;
		}

		.catalog-group > .pgrid:has(> .pcard:only-child) + .prows .prow p {
			grid-column: 1;
			grid-row: 2;
		}

		.catalog-group > .pgrid:has(> .pcard:only-child) + .prows .prow .btn {
			grid-column: 2;
			grid-row: 1 / span 2;
		}
	}

	.pcard__step svg {
		fill: none;
		stroke: currentColor;
		stroke-width: 1.6;
		transition: transform 0.12s var(--ease-out);
	}

	.pcard__step:active svg {
		transform: scale(0.9);
	}

	.pcard__step:active {
		color: var(--color-accent);
	}

	.pcard__count {
		min-width: 3.25rem;
		font-family: var(--font-heading);
		font-size: 0.875rem;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
		text-align: center;
		color: var(--color-text);
	}

	@media (hover: hover) and (pointer: fine) {
		.pcard__step:hover {
			color: var(--color-accent);
		}
	}

	.prow p:empty {
		display: none;
	}

	@media (min-width: 768px) {
		.prow p:empty {
			display: block;
		}
	}
</style>
