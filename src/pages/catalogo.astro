---
import Layout from "../layouts/Layout.astro";
import MediaPlaceholder from "../components/MediaPlaceholder.astro";
import { catalog, catalogCategories } from "../data/catalog.js";
import { site } from "../data/site.js";

const slugify = (value) =>
	value
		.toLowerCase()
		.normalize("NFD")
		.replace(/[\u0300-\u036f]/g, "")
		.replace(/[^a-z0-9]+/g, "-")
		.replace(/(^-|-$)/g, "");

/**
 * Datos estructurados del catálogo.
 *
 * Se emite `Product` sin `offers`: el sitio no publica precios (decisión del
 * cliente), cada pieza se cotiza según medidas.
 */
const catalogLd = JSON.stringify({
	"@context": "https://schema.org",
	"@type": "ItemList",
	name: `Catálogo de ${site.name}`,
	numberOfItems: catalog.length,
	itemListElement: catalog.map((item, i) => ({
		"@type": "ListItem",
		position: i + 1,
		item: {
			"@type": "Product",
			name: item.name,
			description: item.description,
			category: item.category,
			brand: { "@type": "Brand", name: site.name },
		},
	})),
});

const groups = catalogCategories
	.map((category) => ({
		name: category,
		id: slugify(category),
		items: catalog.filter((item) => item.category === category),
	}))
	.filter((group) => group.items.length > 0);
---

<Layout
	title="Productos"
	description="Campanas, revestimientos, mesones, carros, soportes y protectores en acero inoxidable fabricados a medida. Cotiza cada pieza según tus medidas."
	jsonLd={catalogLd}
>
	<section class="section page-hero">
		<div class="container">
			<span class="eyebrow">Productos</span>
			<h1>Todo lo que fabricamos en acero inoxidable</h1>
			<p>
				{catalog.length} piezas que hacemos habitualmente, cada una a la medida de tu espacio. Si lo que
				necesitas no está en la lista, lo fabricamos igual: mándanos el plano o las medidas.
			</p>


			<nav class="catalog-nav" aria-label="Categorías del catálogo">
				{groups.map((group) => (
					<a href={`#${group.id}`}>{group.name}</a>
				))}
			</nav>
		</div>
	</section>

	{/* Todo el listado vive en UNA sección clara. Antes cada categoría alternaba
	    claro/oscuro: cinco cambios de tema para 18 tarjetas, y las fotos se
	    juzgaban sobre fondos distintos. */}
	<section class="section section--alt">
		<div class="container catalog-groups">
	{
		groups.map((group) => (
			<section class="catalog-group" id={group.id} aria-labelledby={`${group.id}-title`}>
					<h2 class="catalog-group-title" id={`${group.id}-title`}>{group.name}</h2>

					<div class="catalog-grid">
						{group.items.map((item) => (
							<article class="catalog-card">
								{/* La foto va PRIMERO: en una lista de quince piezas de acero
								    los nombres se parecen entre sí y el comprador elige por
								    la imagen. El hueco rotulado ocupa su sitio con la misma
								    proporción que tendrá la foto final, así que reemplazarla
								    no mueve el layout. */}
								<div
									class:list={[
										"catalog-card__media",
										{ "media-frame": !item.image?.pending },
									]}
								>
									{item.image?.pending ? (
										<MediaPlaceholder slot={item.image.slot} ratio={item.image.ratio} />
									) : (
										<img
											src={item.image.src}
											alt={item.image.alt}
											style={item.image.position ? `object-position: ${item.image.position}` : undefined}
											width="600"
											height="450"
											loading="lazy"
											decoding="async"
										/>
									)}
								</div>

								<div class="catalog-card__body">
								<h3 id={`${item.id}-name`}>{item.name}</h3>
								{item.description && <p>{item.description}</p>}
								{/* El nombre visible se repite en 15 enlaces idénticos: se compone el
								    nombre accesible con el h3 para que cada enlace se distinga (WCAG 2.4.4). */}
								<a
									id={`${item.id}-cta`}
									aria-labelledby={`${item.id}-cta ${item.id}-name`}
									href={`https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent(`Hola JZINOX, me interesa cotizar: ${item.name}`)}`}
									target="_blank"
									rel="noopener noreferrer"
									class="btn btn--outline catalog-card__cta"
								>
									Cotizar
								</a>
								</div>
							</article>
						))}
					</div>
			</section>
		))
	}
		</div>
	</section>

	<section class="section section--tight">
		<div class="container">
			<div class="cta-plate">
				<div>
					<h2>¿No encuentras lo que buscas?</h2>
					<p>Fabricamos a medida según tus planos o el levantamiento en terreno.</p>
				</div>
				<a href="/contacto" class="btn btn--primary">Cotizar Proyecto</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	.catalog-nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 1.5rem;
	}

	.catalog-nav a {
		display: inline-flex;
		align-items: center;
		min-height: var(--tap);
		font-family: var(--font-body);
		font-size: 0.78rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		font-weight: 500;
		color: var(--color-graphite);
		background-color: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		padding: 0.4rem 0.95rem;
		transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
	}

	.catalog-nav a:hover {
		background-color: var(--color-accent);
		border-color: var(--color-accent);
		color: var(--color-on-accent);
	}

	.catalog-groups {
		display: flex;
		flex-direction: column;
		gap: clamp(3rem, 6vw, 4.5rem);
	}

	.catalog-group-title {
		font-size: clamp(1.5rem, 2.4vw, 2rem);
		margin-bottom: 1.5rem;
		padding-bottom: 0.8rem;
		border-bottom: 1px solid var(--color-border);
	}

	/* Tarjetas sueltas con aire entre ellas, no un bento a junta: las categorías
	   tienen 2, 3 o 6 piezas y en un bento la fila incompleta dejaba celdas lisas
	   que se leían como productos que faltan. Aquí la fila simplemente termina. */
	.catalog-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
		gap: clamp(1rem, 2.4vw, var(--gutter));
	}

	.catalog-card {
		display: flex;
		flex-direction: column;
		background-color: var(--color-bg);
		border: 1px solid var(--color-border);
	}

	/* La celda va a sangre para que la foto toque los tres cantos de la
	   tarjeta; el aire vuelve en el cuerpo, con la misma medida que
	   `.bento__cell` para no romper el ritmo del resto del sitio. */
	.catalog-card__media {
		overflow: hidden;
	}

	.catalog-card__media img {
		display: block;
		width: 100%;
		height: auto;
		/* Las fotos del cliente son de celular, casi todas verticales: sin
		   aspect-ratio + cover, una sola tarjeta mediría el doble que sus vecinas. */
		aspect-ratio: 4 / 3;
		object-fit: cover;
	}

	.catalog-card__body {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		align-items: flex-start;
		flex-grow: 1;
		padding: clamp(1.25rem, 3vw, 1.6rem);
	}

	.catalog-card h3 {
		margin: 0;
		font-size: 1.125rem;
	}

	.catalog-card p {
		font-size: 1rem;
		line-height: 1.5;
		margin-bottom: 0.4rem;
	}

	/* `margin-top: auto` ancla el botón al pie aunque la tarjeta no tenga
	   descripción: todos los botones de una fila quedan a la misma altura. */
	.catalog-card__cta {
		margin-top: auto;
		font-size: 0.78rem;
		padding: 0.55rem 1.1rem;
	}

	/* Al pasar el cursor se apilan dos tintes: la celda va a --color-surface
	   (#f3f3f3) y encima .btn--ghost:hover añade rgba(193,61,47,.06), dando
	   #f0e8e7. El texto de acento sobre ese fondo mide 4.38:1 a 12.5px, bajo el
	   mínimo AA. Con --color-accent-dark vuelve a 5.36:1.
	   Solo :hover: en foco de teclado el botón NO recibe el lavado del ghost
	   (queda --color-graphite sobre #f3f3f3) y el anillo global de :focus-visible
	   ya marca el estado, así que ahí no hay nada que corregir. */
	.catalog-card__cta:hover {
		color: var(--color-accent-dark);
	}


</style>
