---
import Layout from "../layouts/Layout.astro";
import WhatsAppIcon from "../components/WhatsAppIcon.astro";
import { catalog, catalogCategories } from "../data/catalog.js";
import { site } from "../data/site.js";
import { srcset } from "../utils/img.js";

const slugify = (value) =>
	value
		.toLowerCase()
		.normalize("NFD")
		.replace(/[̀-ͯ]/g, "")
		.replace(/[^a-z0-9]+/g, "-")
		.replace(/(^-|-$)/g, "");

const hasPhoto = (item) => Boolean(item.image && !item.image.pending && item.image.src);

const photosOf = (item) => [item.image, ...(item.gallery ?? [])];

const toRuns = (items) =>
	items.reduce((runs, item) => {
		const kind = hasPhoto(item) ? "cards" : "rows";
		const last = runs[runs.length - 1];
		if (last && last.kind === kind) last.items.push(item);
		else runs.push({ kind, items: [item] });
		return runs;
	}, []);

const quoteHref = (item) =>
	`https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent(`Hola ${site.name}, me interesa cotizar: ${item.name}`)}`;

const catalogLd = JSON.stringify({
	"@context": "https://schema.org",
	"@type": "ItemList",
	name: `Productos de ${site.name}`,
	numberOfItems: catalog.length,
	itemListElement: catalog.map((item, i) => ({
		"@type": "ListItem",
		position: i + 1,
		item: {
			"@type": "Product",
			name: item.name,
			description: item.description,
			category: item.category,
			brand: { "@type": "Brand", name: site.name },
		},
	})),
});

const groups = catalogCategories
	.map((category) => {
		const items = catalog.filter((item) => item.category === category);
		return { name: category, id: slugify(category), count: items.length, runs: toRuns(items) };
	})
	.filter((group) => group.count > 0);
---

<Layout
	title="Campanas, mesones y carros en acero inoxidable"
	description="Campanas, revestimientos, mesones, carros, soportes y protectores en acero inoxidable fabricados a medida. Cotiza cada pieza según tus medidas."
	jsonLd={catalogLd}
	breadcrumb="Productos"
>
	<section class="section page-hero page-hero--split">
		<div class="container">
			<h1>Productos en acero inoxidable a medida</h1>
			<p>
				{catalog.length} piezas que hacemos habitualmente, cada una a la medida de tu espacio. Si no está
				la que necesitas, la fabricamos igual.
			</p>
		</div>
	</section>

	<nav class="catalog-bar theme-light" aria-label="Categorías de productos">
		<div class="container catalog-bar__inner">
			{groups.map((group) => (
				<a href={`#${group.id}`}>{group.name}</a>
			))}
		</div>
	</nav>

	<section class="section section--alt catalog">
		<div class="container catalog-groups">
			{
				groups.map((group) => (
					<section class="catalog-group" id={group.id} aria-labelledby={`${group.id}-title`}>
						<h2 class="catalog-group-title" id={`${group.id}-title`}>{group.name}</h2>

						{group.runs.map((run) =>
							run.kind === "cards" ? (
								<div class="pgrid catalog-run">
									{run.items.map((item, i) => (
										<article class="pcard" data-reveal="fade" style={`--i: ${i % 3}`}>
											<div class="pcard__gallery" data-gallery={photosOf(item).length > 1 ? "" : undefined}>
												<div class="pcard__track">
													{photosOf(item).map((photo, n, all) => (
														<a
															class="pcard__media media-frame"
															href={photo.src}
															data-zoom
															data-alt={photo.alt}
															aria-label={all.length > 1 ? `Ampliar la foto ${n + 1} de ${all.length} de ${item.name}` : `Ampliar la foto de ${item.name}`}
														>
															<img
																src={photo.src}
																srcset={srcset(photo.src)}
																sizes="(min-width: 1100px) 420px, (min-width: 740px) 46vw, 92vw"
																alt={photo.alt}
																style={photo.position ? `object-position: ${photo.position}` : undefined}
																width="800"
																height="600"
																loading="lazy"
																decoding="async"
															/>
														</a>
													))}
												</div>
												{photosOf(item).length > 1 && (
													<div class="pcard__nav">
														<button type="button" class="pcard__step" data-step="-1" aria-label={`Foto anterior de ${item.name}`}>
															<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M10 3 5 8l5 5" /></svg>
														</button>
														<span class="pcard__count" data-count>1 / {photosOf(item).length}</span>
														<button type="button" class="pcard__step" data-step="1" aria-label={`Foto siguiente de ${item.name}`}>
															<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="m6 3 5 5-5 5" /></svg>
														</button>
													</div>
												)}
											</div>

											<div class="pcard__body">
												<h3 id={`${item.id}-name`}>{item.name}</h3>
												{item.description && <p>{item.description}</p>}
												<a
													id={`${item.id}-cta`}
													aria-labelledby={`${item.id}-cta ${item.id}-name`}
													href={quoteHref(item)}
													target="_blank"
													rel="noopener noreferrer"
													class="btn btn--whatsapp btn--sm"
												>
													<WhatsAppIcon size={16} />
													Cotizar por WhatsApp
												</a>
											</div>
										</article>
									))}
								</div>
							) : (
								<ul class="prows catalog-run">
									{run.items.map((item) => (
										<li class="prow" data-reveal="fade">
											<h3 id={`${item.id}-name`}>{item.name}</h3>
											<p>{item.description}</p>
											<a
												id={`${item.id}-cta`}
												aria-labelledby={`${item.id}-cta ${item.id}-name`}
												href={quoteHref(item)}
												target="_blank"
												rel="noopener noreferrer"
												class="btn btn--whatsapp btn--sm"
											>
												<WhatsAppIcon size={16} />
												Cotizar por WhatsApp
											</a>
										</li>
									))}
								</ul>
							),
						)}
					</section>
				))
			}
		</div>
	</section>

	<section class="section section--tight cta-band cta-band--dark" aria-labelledby="catalogo-cierre">
		<div class="container cta-band__inner">
			<div class="cta-band__text">
				<h2 id="catalogo-cierre">¿No encuentras lo que buscas?</h2>
				<p>Lo fabricamos a medida, con tu plano o tus medidas.</p>
			</div>
			<div class="cta-band__actions">
				<a href="/contacto" class="btn btn--primary">Cotizar proyecto</a>
			</div>
		</div>
	</section>
</Layout>

<script>
	document.querySelectorAll("[data-gallery]").forEach((gallery) => {
		const track = gallery.querySelector(".pcard__track");
		const count = gallery.querySelector("[data-count]");
		const total = track.children.length;
		const current = () => Math.round(track.scrollLeft / track.clientWidth);
		gallery.querySelectorAll("[data-step]").forEach((button) => {
			button.addEventListener("click", () => {
				const next = (current() + Number(button.dataset.step) + total) % total;
				track.scrollTo({ left: next * track.clientWidth, behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
			});
		});
		track.addEventListener("scroll", () => {
			count.textContent = `${current() + 1} / ${total}`;
		}, { passive: true });
	});
</script>

<style>
	.catalog-bar {
		position: sticky;
		top: var(--header-height);
		z-index: 40;
		background-color: var(--color-bg-alt);
		border-bottom: 1px solid var(--color-border);
	}

	.catalog-bar__inner {
		display: flex;
		gap: 0.25rem 1.5rem;
		overflow-x: auto;
		overscroll-behavior-x: contain;
		scrollbar-width: none;
		white-space: nowrap;
	}

	.catalog-bar__inner::-webkit-scrollbar {
		display: none;
	}

	@media (max-width: 639.98px) {
		.catalog-bar__inner {
			mask-image: linear-gradient(to right, #000 calc(100% - 2rem), transparent);
		}
	}

	.catalog-bar a {
		display: inline-flex;
		align-items: center;
		flex: none;
		min-height: 48px;
		font-family: var(--font-heading);
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--color-text);
		touch-action: manipulation;
		transition: color 0.15s ease;
	}

	.catalog-bar a:active {
		color: var(--color-accent);
	}

	@media (hover: hover) and (pointer: fine) {
		.catalog-bar a:hover {
			color: var(--color-accent);
		}
	}

	.catalog-groups {
		display: flex;
		flex-direction: column;
		gap: clamp(3rem, 6vw, 4.5rem);
	}

	.catalog-group {
		scroll-margin-top: 3.5rem;
	}

	.catalog-group-title {
		font-size: clamp(1.5rem, 2.4vw, 2rem);
		margin-bottom: 1.25rem;
	}

	.catalog-run + .catalog-run {
		margin-top: clamp(1rem, 2.4vw, var(--gutter));
	}

	.pcard__gallery {
		position: relative;
	}

	.pcard__track {
		display: flex;
		overflow-x: auto;
		overscroll-behavior-x: contain;
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
	}

	.pcard__track::-webkit-scrollbar {
		display: none;
	}

	.pcard__track > .pcard__media {
		flex: 0 0 100%;
		scroll-snap-align: start;
	}

	.pcard__nav {
		position: absolute;
		right: 0;
		bottom: 0;
		display: flex;
		align-items: center;
		background-color: var(--color-bg);
		border-top: 1px solid var(--color-border);
		border-left: 1px solid var(--color-border);
	}

	.pcard__step {
		display: grid;
		place-items: center;
		width: var(--tap);
		height: var(--tap);
		padding: 0;
		border: 0;
		background: none;
		color: var(--color-text);
		cursor: pointer;
		touch-action: manipulation;
	}

	.pcard__step svg {
		fill: none;
		stroke: currentColor;
		stroke-width: 1.6;
	}

	.pcard__step:active {
		color: var(--color-accent);
	}

	.pcard__count {
		min-width: 3.25rem;
		font-family: var(--font-heading);
		font-size: 0.875rem;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
		text-align: center;
		color: var(--color-text);
	}

	@media (hover: hover) and (pointer: fine) {
		.pcard__step:hover {
			color: var(--color-accent);
		}
	}

	.prow p:empty {
		display: none;
	}

	@media (min-width: 768px) {
		.prow p:empty {
			display: block;
		}
	}
</style>
