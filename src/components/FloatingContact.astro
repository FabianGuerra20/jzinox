---
import WhatsAppIcon from "./WhatsAppIcon.astro";
import { site } from "../data/site.js";

const whatsappHref = `https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent(
  site.whatsappDefaultMessage,
)}`;
---

<a class="fab" href={whatsappHref} target="_blank" rel="noopener noreferrer" aria-label="Hablar con un asesor por WhatsApp">
  <WhatsAppIcon size={24} />
  <span class="fab__label" aria-hidden="true">Hablar con un asesor</span>
</a>

<style>
  .fab {
    position: fixed;
    right: calc(1.5rem + env(safe-area-inset-right, 0px));
    bottom: calc(1.5rem + env(safe-area-inset-bottom, 0px));
    z-index: 60;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 48px;
    height: 48px;
    border: 1px solid var(--color-whatsapp-ink);
    background-color: var(--color-whatsapp-ink);
    color: #fff;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1;
    text-transform: uppercase;
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
    touch-action: manipulation;
    -webkit-user-select: none;
    user-select: none;
    transition:
      background-color 0.2s var(--ease-out),
      border-color 0.2s var(--ease-out),
      opacity 0.24s var(--ease-out),
      visibility 0s,
      transform 0.24s var(--ease-out);
  }

  .fab__label {
    display: none;
  }

  @media (min-width: 1536px) {
    .fab {
      width: auto;
      padding: 0 1.1rem 0 0.9rem;
    }

    .fab__label {
      display: inline;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .fab:hover {
      background-color: var(--color-whatsapp-ink-dark);
      border-color: var(--color-whatsapp-ink-dark);
    }
  }

  .fab:active {
    transform: scale(0.97);
    background-color: var(--color-whatsapp-ink-dark);
    border-color: var(--color-whatsapp-ink-dark);
  }

  .fab.is-away {
    opacity: 0;
    transform: translateY(12px);
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.2s var(--ease-out),
      transform 0.2s var(--ease-out),
      visibility 0s linear 0.2s;
  }

  @media (min-width: 1024px) {
    .fab {
      right: calc(0.75rem + env(safe-area-inset-right, 0px));
    }
  }

  .fab:focus-visible {
    outline: 2px solid var(--color-graphite);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .fab {
      transition:
        background-color 0.2s var(--ease-out),
        border-color 0.2s var(--ease-out);
    }

    .fab:active {
      transform: none;
    }
  }
</style>

<script>
  const hero = document.querySelector(".hero");
  const fab = document.querySelector(".fab");
  if (hero && fab) {
    new IntersectionObserver(([entry]) => fab.classList.toggle("is-away", entry.intersectionRatio > 0.35), {
      threshold: [0, 0.35, 1],
    }).observe(hero);
  }
</script>
