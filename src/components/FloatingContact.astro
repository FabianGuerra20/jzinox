---
// Boton flotante de contacto directo por WhatsApp.
// El mockup lo reduce a un unico enlace: sin estado desplegable, sin checkbox
// y sin JavaScript. Cuadrado de 56px (radio cero, como todo el sistema).
import { site } from "../data/site.js";

const whatsappHref = `https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent(
  site.whatsappDefaultMessage,
)}`;
---

<a
  class="fab"
  href={whatsappHref}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Contactar por WhatsApp"
>
  <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" aria-hidden="true" focusable="false">
    <path
      d="M12.02 2c-5.5 0-9.98 4.48-9.98 9.98 0 1.76.46 3.48 1.34 4.99L2 22l5.2-1.36a9.94 9.94 0 0 0 4.82 1.23h.01c5.5 0 9.98-4.47 9.98-9.98C22 6.48 17.53 2 12.02 2Zm0 18.26h-.01a8.3 8.3 0 0 1-4.24-1.16l-.3-.18-3.09.81.82-3.01-.2-.31a8.26 8.26 0 0 1-1.27-4.43c0-4.57 3.72-8.29 8.3-8.29 2.22 0 4.3.86 5.87 2.43a8.23 8.23 0 0 1 2.43 5.87c0 4.58-3.73 8.27-8.31 8.27Zm4.53-6.19c-.25-.12-1.46-.72-1.68-.8-.23-.08-.39-.12-.56.12-.16.25-.64.8-.78.97-.14.16-.29.18-.53.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.39-1.72-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.12-.14.16-.25.25-.41.08-.16.04-.31-.02-.43-.06-.12-.56-1.35-.77-1.85-.2-.48-.41-.42-.56-.43h-.48c-.16 0-.43.06-.66.31-.23.25-.86.84-.86 2.04 0 1.2.88 2.37 1 2.53.12.16 1.73 2.64 4.2 3.7.59.25 1.04.4 1.4.52.59.19 1.12.16 1.54.1.47-.07 1.46-.6 1.66-1.17.21-.58.21-1.07.14-1.17-.06-.11-.22-.17-.47-.29Z"
    ></path>
  </svg>
</a>

<style>
  /* Cuadrado, nunca circular: el sistema completo trabaja con radio cero. */
  .fab {
    position: fixed;
    right: 1.5rem;
    bottom: 1.5rem;
    z-index: 60;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: var(--radius);
    background-color: var(--color-whatsapp);
    color: #fff;
    box-shadow: var(--shadow-md);
    transition:
      transform 200ms var(--ease-out),
      background-color 200ms var(--ease-out);
  }

  .fab:hover {
    transform: scale(1.1);
  }

  /* Foco visible con contraste alto sobre el verde y sobre el lienzo claro. */
  .fab:focus-visible {
    outline: 2px solid var(--color-graphite);
    outline-offset: 3px;
  }

  /* Sin movimiento: el feedback de hover pasa a ser un oscurecido del fondo. */
  @media (prefers-reduced-motion: reduce) {
    .fab {
      transition: background-color 200ms linear;
    }

    .fab:hover {
      transform: none;
      background-color: #1faa53;
    }
  }
</style>
