---
interface Props {
  brand: {
    slug: string;
    name: string;
    lead: string;
    leadShort?: string;
    blurb?: string;
    actions: Array<{ href: string; label: string; variant: string }>;
    featuredTitle: string;
    featuredHref: string;
    featuredLabel: string;
    featured: Array<{ name: string; note: string; href?: string }>;
    images: Array<{ src?: string; alt?: string; pending?: boolean}>;
  };
  flip?: boolean;
}

const { brand, flip = false } = Astro.props as Props;

const photos = brand.images.filter((image) => !image.pending && image.src);
import { photoFill, srcset } from "../utils/img.js";

const headingId = `marca-${brand.slug}`;
const indexId = `indice-${brand.slug}`;
---

<article class:list={["brand", { "brand--flip": flip }]} aria-labelledby={headingId}>
  <div class="brand__head" data-reveal>
    <h2 id={headingId} class="brand__name">{brand.name}</h2>
    <p class:list={["brand__lead", { "brand__lead--statement": brand.blurb }]}>{brand.leadShort ?? brand.lead}</p>
    {brand.blurb && <p class="brand__text">{brand.blurb}</p>}

    <div class="brand__actions">
      {
        brand.actions.map((action) => (
          <a href={action.href} class:list={["btn", `btn--${action.variant}`]}>
            {action.label}
          </a>
        ))
      }
    </div>
  </div>

  <div class="brand__carousel" data-carousel data-reveal role="region" aria-roledescription="carrusel" aria-label={`Fotos de ${brand.name}`}>
    <div class="brand__track" data-carousel-track>
      {
        photos.map((image, i) => (
          <figure class="brand__slide photo-fill" style={photoFill(image.src)} role="group" aria-roledescription="diapositiva" aria-label={`${i + 1} de ${photos.length}`}>
            <img
              src={image.src}
              srcset={srcset(image.src)}
              sizes="(min-width: 1024px) 56vw, 92vw"
              alt={image.alt}
              width="800"
              height="600"
              loading="lazy"
              decoding="async"
            />
          </figure>
        ))
      }
    </div>
    <div class="brand__controls">
      <button type="button" class="brand__control" data-carousel-toggle aria-label="Pausar el carrusel">
        <svg class="brand__icon-pause" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M5 3v10M11 3v10" /></svg>
        <svg class="brand__icon-play" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M5 3l8 5-8 5z" /></svg>
      </button>
      <button type="button" class="brand__control" data-carousel-step="-1" aria-label="Foto anterior">
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M10 3 5 8l5 5" /></svg>
      </button>
      <span class="brand__count" data-carousel-count aria-hidden="true">1 / {photos.length}</span>
      <button type="button" class="brand__control" data-carousel-step="1" aria-label="Foto siguiente">
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="m6 3 5 5-5 5" /></svg>
      </button>
    </div>
  </div>

  <div class="brand__index">
    <div class="brand__index-head">
      <h3 id={indexId} class="brand__index-title">{brand.featuredTitle}</h3>
      <a href={brand.featuredHref} class="brand__more link-press">{brand.featuredLabel}</a>
    </div>

    <ul class="brand__list" aria-labelledby={indexId}>
      {
        brand.featured.map((item, i) => (
          <li data-reveal style={`--i: ${i}`}>
            <a href={item.href ?? brand.featuredHref} class="brand__row link-press">
              <strong>{item.name}</strong>
              <span>{item.note}</span>
              <svg class="brand__arrow" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</article>

<style>
  .brand {
    display: grid;
    grid-template-areas:
      "head"
      "media"
      "index";
    gap: clamp(2rem, 5vw, 3.5rem) var(--gutter);
  }

  @media (min-width: 1024px) {
    .brand {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      grid-template-areas:
        "head media"
        "index index";
      align-items: center;
    }

    .brand--flip {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      grid-template-areas:
        "media head"
        "index index";
    }
  }

  .brand__head {
    grid-area: head;
  }

  .brand__name {
    font-size: clamp(2rem, 3.6vw, 3rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
  }

  .brand__lead {
    max-width: 40ch;
    font-size: 1.125rem;
    line-height: 1.5;
    margin-bottom: 0;
  }

  .brand__lead--statement {
    max-width: 30ch;
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 1.8vw, 1.5rem);
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-text);
  }

  .brand__text {
    max-width: 46ch;
    font-size: 1.0625rem;
    line-height: 1.6;
    margin: 1rem 0 0;
  }

  .brand__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    margin-top: 2rem;
  }

  .brand__carousel {
    grid-area: media;
    position: relative;
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  .brand__track {
    display: flex;
    aspect-ratio: 1 / 1;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .brand__track::-webkit-scrollbar {
    display: none;
  }

  @media (min-width: 640px) {
    .brand__track {
      aspect-ratio: 4 / 3;
    }
  }

  .brand__slide {
    flex: 0 0 100%;
    margin: 0;
    scroll-snap-align: start;
  }

  .brand__slide img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .brand__controls {
    position: absolute;
    right: 10px;
    bottom: 10px;
    display: flex;
    align-items: center;
    background-color: color-mix(in srgb, var(--color-bg) 92%, transparent);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
  }

  .brand__control {
    display: grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-text);
    cursor: pointer;
    touch-action: manipulation;
  }

  .brand__control svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linejoin: round;
    transition: transform 0.12s var(--ease-out);
  }

  .brand__control:active svg {
    transform: scale(0.9);
  }

  .brand__icon-play {
    display: none;
  }

  .brand__carousel.is-paused .brand__icon-pause {
    display: none;
  }

  .brand__carousel.is-paused .brand__icon-play {
    display: block;
  }

  .brand__count {
    min-width: 3.25rem;
    font-family: var(--font-heading);
    font-size: 0.875rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    text-align: center;
    color: var(--color-text);
  }

  .brand__index {
    grid-area: index;
    align-self: start;
  }

  .brand__index-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-bottom: 0.75rem;
  }

  .brand__index-title {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0;
  }

  .brand__more {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-family: var(--font-heading);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-accent);
    border-bottom: 1px solid currentColor;
    transition: color 0.2s var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .brand__more:hover {
      color: var(--color-accent-dark);
    }
  }

  .brand__list {
    display: grid;
    gap: 0 var(--gutter);
  }

  @media (min-width: 640px) {
    .brand__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .brand__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .brand__row {
    position: relative;
    display: grid;
    gap: 0.3rem;
    height: 100%;
    min-height: var(--tap);
    padding: 1.1rem 2.25rem 1.25rem 0;
    border-top: 1px solid var(--color-border);
  }

  .brand__row strong {
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.25;
    color: var(--color-text);
    transition: color 0.2s var(--ease-out);
  }

  .brand__row span {
    font-size: 1rem;
    line-height: 1.45;
    color: var(--color-text-muted);
  }

  .brand__arrow {
    position: absolute;
    top: 1.25rem;
    right: 0.25rem;
    color: var(--color-text-muted);
    transition:
      transform 0.2s var(--ease-out),
      color 0.2s var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .brand__row:hover strong,
    .brand__row:hover .brand__arrow {
      color: var(--color-accent);
    }

    .brand__row:hover .brand__arrow {
      transform: translateX(4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand__arrow {
      transition: color 0.2s var(--ease-out);
    }

    .brand__row:hover .brand__arrow {
      transform: none;
    }
  }
</style>

<script>
  const INTERVAL = 5000;
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>("[data-carousel-track]");
    const count = carousel.querySelector("[data-carousel-count]");
    const toggle = carousel.querySelector<HTMLButtonElement>("[data-carousel-toggle]");
    if (!track || !count || !toggle) return;

    const total = track.children.length;
    const current = () => Math.round(track.scrollLeft / track.clientWidth);
    let userPaused = reduced;
    let hovering = false;
    let visible = false;
    let timer: number | undefined;

    const goTo = (index: number) => {
      const next = (index + total) % total;
      const wraps = Math.abs(next - current()) > 1;
      if (!wraps || reduced) {
        track.scrollTo({ left: next * track.clientWidth, behavior: reduced ? "auto" : "smooth" });
        return;
      }
      const ease = "cubic-bezier(0.23, 1, 0.32, 1)";
      track.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 120, easing: ease }).finished.then(() => {
        track.scrollTo({ left: next * track.clientWidth, behavior: "auto" });
        track.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 180, easing: ease });
      });
    };

    const sync = () => {
      window.clearInterval(timer);
      const running = !userPaused && !hovering && visible && total > 1;
      if (running) timer = window.setInterval(() => goTo(current() + 1), INTERVAL);
      carousel.classList.toggle("is-paused", userPaused);
      toggle.setAttribute("aria-label", userPaused ? "Reanudar el carrusel" : "Pausar el carrusel");
    };

    carousel.querySelectorAll<HTMLButtonElement>("[data-carousel-step]").forEach((button) => {
      button.addEventListener("click", () => {
        goTo(current() + Number(button.dataset.carouselStep));
        sync();
      });
    });

    toggle.addEventListener("click", () => {
      userPaused = !userPaused;
      sync();
    });

    carousel.addEventListener("pointerenter", () => {
      hovering = true;
      sync();
    });
    carousel.addEventListener("pointerleave", () => {
      hovering = false;
      sync();
    });
    carousel.addEventListener("focusin", () => {
      hovering = true;
      sync();
    });
    carousel.addEventListener("focusout", () => {
      hovering = false;
      sync();
    });
    track.addEventListener("pointerdown", () => {
      userPaused = true;
      sync();
    });

    track.addEventListener(
      "scroll",
      () => {
        count.textContent = `${current() + 1} / ${total}`;
      },
      { passive: true },
    );

    new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting;
        sync();
      },
      { threshold: 0.4 },
    ).observe(carousel);

    sync();
  });
</script>
