---
/**
 * Hueco de foto pendiente.
 *
 * En una maqueta sin fotografía real, el placeholder ES lo que el cliente ve en
 * la mitad de la pantalla. Este componente lo convierte en un pedido explícito:
 * dice qué foto va ahí y con qué orientación, en vez de dejar una caja gris
 * muda que se lee como un error de carga.
 *
 * Por qué no es una imagen: la proporción la fija `aspect-ratio`, así que
 * sustituirlo por la foto real no provoca reflujo, no cuesta una petición de
 * red, y la etiqueta es texto seleccionable y accesible en lugar de píxeles.
 *
 * La desaturación de `.media-frame` (la interacción firma del sistema) se
 * desactiva aquí a propósito: un hover que pasa de gris a gris levemente más
 * grande se siente roto, no intencional.
 */
interface Props {
  /** Qué foto va en esta ranura, en palabras del cliente */
  slot: string;
  /** Proporción requerida, ej. "3:2" o "4:3" */
  ratio?: string;
  /** true cuando el hueco es el candidato a LCP y no debe diferirse */
  eager?: boolean;
  class?: string;
}

const { slot, ratio = "3:2", eager = false, class: className } = Astro.props as Props;

// "3:2" → "3 / 2" para la propiedad CSS
const cssRatio = ratio.replace(":", " / ");
---

<div
  class:list={["media-ph", className]}
  style={`--ph-ratio: ${cssRatio}`}
  data-eager={eager ? "" : undefined}
>
  <span class="media-ph__slot">{slot}</span>
  <span class="media-ph__meta">
    <span class="media-ph__tag">Foto pendiente</span>
    <span class="media-ph__ratio">{ratio}</span>
  </span>
</div>

<style>
  .media-ph {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    /* La proporción la manda el CSS, no el archivo: cambiar el placeholder por
       la foto real no mueve un solo píxel del layout. */
    aspect-ratio: var(--ph-ratio);
    width: 100%;
    padding: 1rem;
    text-align: center;
    background-color: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    /* Trama diagonal muy tenue: distingue el hueco de una superficie del sistema
       sin competir con el contenido real que lo rodea. */
    background-image: repeating-linear-gradient(
      135deg,
      transparent 0 9px,
      rgba(0, 0, 0, 0.022) 9px 18px
    );
  }

  .media-ph__slot {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(0.82rem, 1.6vw, 0.95rem);
    line-height: 1.3;
    color: var(--color-text-muted);
    text-wrap: balance;
  }

  .media-ph__meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .media-ph__tag {
    font-size: 0.62rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #fff;
    background-color: var(--color-steel);
    padding: 0.2rem 0.5rem;
  }

  .media-ph__ratio {
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: var(--color-steel);
  }

  /* Huecos muy chicos: la etiqueta secundaria estorba más de lo que informa. */
  @container (max-width: 180px) {
    .media-ph__meta {
      display: none;
    }
  }
</style>
