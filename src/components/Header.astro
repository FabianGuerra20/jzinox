---
import { navItems, navCta, site } from "../data/site.js";

const currentPath = Astro.url.pathname;
---

<header class="header">
  <div class="header__brandbar">
    <a href="/" class="brand" aria-label={`${site.name} — inicio`}>
      <span class="brand__mark">JZINOX</span>
      <span class="brand__tagline">{site.tagline}</span>
    </a>
  </div>

  <div class="header__navbar">
    <div class="container header__navbar-inner">
      <a href="/" class="header__compact-brand">JZINOX</a>

      <input type="checkbox" id="nav-toggle" class="header__toggle-input" />
      <label for="nav-toggle" class="header__toggle js-toggle-label" tabindex="0" role="button" aria-label="Abrir menú">
        <span></span>
        <span></span>
        <span></span>
      </label>

      <nav class="header__nav" aria-label="Navegación principal">
        <ul>
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={currentPath === item.href ? "page" : undefined}
                  class:list={["header__link", { "header__link--active": currentPath === item.href }]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
        <a href={navCta.href} class="btn btn--primary header__cta">{navCta.label}</a>
      </nav>
    </div>
  </div>
</header>

<style>
  .header {
    position: relative;
    z-index: 50;
  }

  /* --- Franja superior blanca con el logotipo --- */
  .header__brandbar {
    background-color: #fff;
    display: flex;
    justify-content: center;
    padding: 1.6rem 1.5rem 1.4rem;
  }

  .brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
  }

  .brand__mark {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(2.4rem, 7vw, 4rem);
    line-height: 1;
    letter-spacing: 0.02em;
    color: var(--color-graphite);
    background-image: linear-gradient(
      180deg,
      #d9dcde 0%,
      #ffffff 16%,
      #8f959b 44%,
      #3c434a 52%,
      #7d838a 64%,
      #eceef0 86%,
      #a9aeb3 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 1px 0 rgba(43, 49, 56, 0.35));
  }

  /* Si el navegador no soporta el recorte de fondo, el texto queda en grafito sólido */
  @supports not ((-webkit-background-clip: text) or (background-clip: text)) {
    .brand__mark {
      -webkit-text-fill-color: currentColor;
      background-image: none;
    }
  }

  .brand__tagline {
    font-size: clamp(0.78rem, 1.8vw, 1rem);
    color: var(--color-text-muted);
    letter-spacing: 0.01em;
  }

  /* --- Barra de navegación de acero --- */
  .header__navbar {
    position: sticky;
    top: 0;
    background-color: var(--color-steel);
    background-image: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.14) 0%,
      rgba(255, 255, 255, 0) 45%,
      rgba(0, 0, 0, 0.14) 100%
    );
    box-shadow: 0 1px 3px rgba(43, 49, 56, 0.2);
  }

  .header__navbar-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    min-height: 52px;
  }

  .header__compact-brand {
    display: none;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: 0.04em;
    color: #fff;
  }

  .header__nav {
    display: flex;
    align-items: center;
    gap: 1.4rem;
  }

  .header__nav ul {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .header__link {
    display: block;
    font-size: 0.92rem;
    color: rgba(255, 255, 255, 0.9);
    padding: 0.85rem 0.85rem;
    border-bottom: 2px solid transparent;
    transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease;
  }

  .header__link:hover {
    color: #fff;
    background-color: rgba(255, 255, 255, 0.12);
  }

  .header__link--active {
    color: #fff;
    border-color: var(--color-accent);
  }

  .header__cta {
    padding: 0.55rem 1.1rem;
    font-size: 0.88rem;
    white-space: nowrap;
  }

  .header__toggle-input {
    display: none;
  }

  .header__toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    cursor: pointer;
  }

  .header__toggle span {
    height: 2px;
    background-color: #fff;
    display: block;
  }

  @media (max-width: 980px) {
    .header__brandbar {
      padding: 1.2rem 1.5rem 1rem;
    }

    .header__navbar-inner {
      justify-content: space-between;
    }

    .header__compact-brand {
      display: block;
    }

    .header__toggle {
      display: flex;
    }

    .header__nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background-color: var(--color-steel-dark);
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.25s ease;
    }

    .header__nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0.5rem 1.5rem 0;
    }

    .header__link {
      padding: 0.85rem 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    }

    .header__link--active {
      border-color: var(--color-accent);
    }

    .header__cta {
      margin: 1.2rem 1.5rem 1.5rem;
    }

    .header__toggle-input:checked ~ .header__nav {
      max-height: 560px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .header__nav {
      transition: none;
    }
  }
</style>
