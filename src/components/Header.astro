---
import { navItems, navCta, site } from "../data/site.js";

const currentPath = Astro.url.pathname;
---

<header class="header">
  <div class="header__brandbar">
    <a href="/" class="brand" aria-label={`${site.name} — inicio`}>
      <img
        class="brand__logo"
        src="/logo-jzinox.png"
        alt=""
        width="709"
        height="163"
        fetchpriority="high"
        decoding="async"
      />
      <span class="brand__tagline">{site.tagline}</span>
    </a>
  </div>

  <div class="header__navbar">
    <div class="container header__navbar-inner">
      <a href="/" class="header__compact-brand">JZINOX</a>

      <input type="checkbox" id="nav-toggle" class="header__toggle-input" />
      <label for="nav-toggle" class="header__toggle js-toggle-label" tabindex="0" role="button" aria-label="Abrir menú">
        <span></span>
        <span></span>
        <span></span>
      </label>

      <nav class="header__nav" aria-label="Navegación principal">
        <ul>
          {
            navItems.map((item) => (
              <li class:list={{ "header__item--ally": item.ally }}>
                <a
                  href={item.href}
                  aria-current={currentPath === item.href ? "page" : undefined}
                  class:list={[
                    "header__link",
                    {
                      "header__link--active": currentPath === item.href,
                      "header__link--ally": item.ally,
                    },
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
        <a href={navCta.href} class="btn btn--primary header__cta">{navCta.label}</a>
      </nav>
    </div>
  </div>
</header>

<style>
  .header {
    position: relative;
    z-index: 50;
  }

  /* --- Franja superior blanca con el logotipo --- */
  .header__brandbar {
    background-color: #fff;
    display: flex;
    justify-content: center;
    padding: clamp(1rem, 3vw, 1.6rem) 1.5rem clamp(0.85rem, 2.5vw, 1.4rem);
  }

  .brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
  }

  /* Logotipo del cliente. El ancho manda y la altura la fija el aspect-ratio
     intrínseco (709x163), así no hay salto de layout al cargar. */
  .brand__logo {
    width: clamp(210px, 40vw, 400px);
    height: auto;
  }

  .brand__tagline {
    font-size: clamp(0.72rem, 1.8vw, 1rem);
    color: var(--color-text-muted);
    letter-spacing: 0.01em;
    text-align: center;
  }

  /* --- Barra de navegación de acero --- */
  /* Grafito profundo con veta cepillada: la barra debe leerse como una
     platina, no como un fondo gris de plantilla. */
  .header__navbar {
    position: sticky;
    top: 0;
    background-color: var(--color-ink);
    background-image: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.13) 0%,
      rgba(255, 255, 255, 0) 45%,
      rgba(0, 0, 0, 0.3) 100%
    );
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.08), 0 2px 6px rgba(26, 30, 35, 0.28);
  }

  .header__navbar-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    min-height: 52px;
  }

  .header__compact-brand {
    display: none;
    align-items: center;
    min-height: var(--tap);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: 0.04em;
    color: #fff;
  }

  .header__nav {
    display: flex;
    align-items: center;
    gap: 1.2rem;
  }

  .header__nav ul {
    display: flex;
    align-items: center;
    gap: 0.2rem;
  }

  .header__link {
    display: flex;
    align-items: center;
    min-height: var(--tap);
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.9);
    padding: 0 0.75rem;
    border-bottom: 2px solid transparent;
    transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease;
  }

  .header__link:hover {
    color: #fff;
    background-color: rgba(255, 255, 255, 0.12);
  }

  .header__link--active {
    color: #fff;
    border-color: var(--color-accent);
  }

  /* --- Marca aliada: divisor + tipografía propia --- */
  /* AL Mueblería no es una sección de JZ Inox. El divisor y el tratamiento
     en mono avisan que el clic cambia de marca, no de página. */
  .header__item--ally {
    position: relative;
    margin-left: 0.9rem;
    padding-left: 0.9rem;
  }

  .header__item--ally::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 1px;
    height: 20px;
    background-color: rgba(255, 255, 255, 0.28);
  }

  .header__link--ally {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.72);
  }

  .header__cta {
    padding: 0.5rem 1.1rem;
    min-height: 38px;
    font-size: 0.8rem;
    white-space: nowrap;
  }

  .header__toggle-input {
    display: none;
  }

  .header__toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: var(--tap);
    height: var(--tap);
    cursor: pointer;
  }

  .header__toggle span {
    height: 2px;
    width: 22px;
    background-color: #fff;
    display: block;
  }

  /* --- Móvil y tablet: el nav colapsa en el MISMO punto en que el
     contenido deja el layout de escritorio (1024px). --- */
  @media (max-width: 1023.98px) {
    .header__navbar-inner {
      justify-content: space-between;
    }

    .header__compact-brand {
      display: flex;
    }

    .header__toggle {
      display: flex;
    }

    .header__nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background-color: var(--color-ink);
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.25s ease;
    }

    .header__nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0.5rem 1.5rem 0;
    }

    .header__link {
      padding: 0.75rem 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    }

    .header__link--active {
      border-color: var(--color-accent);
    }

    /* En vertical el divisor cruza el ancho, no la altura */
    .header__item--ally {
      margin-left: 0;
      padding-left: 0;
      margin-top: 0.6rem;
      padding-top: 0.6rem;
    }

    .header__item--ally::before {
      top: 0;
      left: 0;
      right: 0;
      width: auto;
      height: 1px;
      transform: none;
    }

    .header__cta {
      margin: 1.2rem 1.5rem 1.5rem;
      min-height: var(--tap);
    }

    .header__toggle-input:checked ~ .header__nav {
      max-height: 620px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .header__nav {
      transition: none;
    }
  }
</style>
