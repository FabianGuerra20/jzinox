---
import { navItems, navCta, site } from "../data/site.js";
import { srcset } from "../utils/img.js";

const currentPath = Astro.url.pathname;

const clean = (value) => (value !== "/" && value.endsWith("/") ? value.slice(0, -1) : value);
const isActive = (href) => clean(currentPath) === clean(href);

const ctaHref = isActive(navCta.href) ? "#name" : navCta.href;
const logo = "/img/logo-jzinox.webp";
---

<header class="header">
  <a class="header__brand" href="/" aria-label={`${site.name}, volver al inicio`}>
    <img
      class="header__logo"
      src={logo}
      srcset={srcset(logo)}
      sizes="180px"
      alt=""
      width="900"
      height="200"
      decoding="async"
    />
  </a>

  <input type="checkbox" id="nav-toggle" class="header__toggle-input" autocomplete="off" />

  <label
    for="nav-toggle"
    class="header__toggle js-toggle-label"
    role="button"
    tabindex="0"
    aria-label="Abrir menú"
    aria-expanded="false"
    aria-controls="site-nav"
  >
    <span class="header__bar"></span>
    <span class="header__bar"></span>
    <span class="header__bar"></span>
  </label>

  <nav id="site-nav" class="header__nav" aria-label="Navegación principal">
    <ul class="header__list">
      {
        navItems.map((item) => (
          <li class:list={["header__item", { "header__item--ally": item.ally }]}>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? "page" : undefined}
              class:list={[
                "header__link",
                {
                  "header__link--active": isActive(item.href),
                  "header__link--ally": item.ally,
                },
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <a href={ctaHref} class="btn btn--primary header__cta header__cta--mobile">{navCta.label}</a>
  </nav>

  <a href={ctaHref} class="btn btn--primary header__cta header__cta--desktop">{navCta.label}</a>

  <label for="nav-toggle" class="header__scrim" aria-hidden="true"></label>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 50;
    height: var(--header-height);
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0 var(--margin-mobile);
    background-color: var(--color-steel);
    background-color: color-mix(in srgb, var(--color-steel) 90%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-steel-dark);
  }

  @supports not ((backdrop-filter: blur(12px)) or (-webkit-backdrop-filter: blur(12px))) {
    .header {
      background-color: var(--color-steel);
    }
  }

  .header :focus-visible {
    outline-color: #fff;
  }

  .header__brand {
    display: flex;
    align-items: center;
    min-height: var(--tap);
    flex-shrink: 0;
    margin-right: auto;
  }

  .header__logo {
    display: block;
    height: 32px;
    width: auto;
  }

  .header__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .header__link {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--tap);
    min-width: var(--tap);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.875rem;
    letter-spacing: 0.05em;
    line-height: 1;
    white-space: nowrap;
    color: rgba(255, 255, 255, 0.92);
    transition: color 0.2s ease;
  }

  .header__link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 8px;
    height: 2px;
    background-color: currentColor;
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform 0.2s var(--ease-out);
  }

  .header__link--active {
    color: #fff;
  }

  .header__link--active::after {
    background-color: var(--color-accent);
    transform: scaleX(1);
  }

  @media (hover: hover) and (pointer: fine) {
    .header__link:hover {
      color: #fff;
    }

    .header__link:hover::after {
      transform: scaleX(1);
      transform-origin: left center;
    }
  }

  .header__link--ally {
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .header__cta {
    white-space: nowrap;
  }

  .header__toggle-input {
    display: none;
  }

  .header__toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: var(--tap);
    height: var(--tap);
    cursor: pointer;
    order: 3;
    -webkit-user-select: none;
    user-select: none;
  }

  .header__bar {
    display: block;
    width: 22px;
    height: 2px;
    background-color: #fff;
    transition:
      transform 0.2s var(--ease-out),
      opacity 0.15s ease;
  }

  .header__toggle-input:checked ~ .header__toggle .header__bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .header__toggle-input:checked ~ .header__toggle .header__bar:nth-child(2) {
    opacity: 0;
  }

  .header__toggle-input:checked ~ .header__toggle .header__bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .header__scrim {
    display: none;
  }

  @media (max-width: 1279.98px) {
    .header__nav {
      position: absolute;
      z-index: 2;
      top: var(--header-height);
      left: 0;
      right: 0;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      background-color: var(--color-steel);
      border-bottom: 1px solid var(--color-steel-dark);
      max-height: calc(100dvh - var(--header-height));
      overflow-y: auto;
      overscroll-behavior: contain;
      clip-path: inset(0 0 100% 0);
      visibility: hidden;
      transition:
        clip-path 0.28s var(--ease-out),
        visibility 0s linear 0.28s;
    }

    .header__toggle-input:checked ~ .header__nav {
      clip-path: inset(0 0 0 0);
      visibility: visible;
      transition:
        clip-path 0.28s var(--ease-out),
        visibility 0s;
    }

    .header__scrim {
      display: block;
      position: absolute;
      z-index: 1;
      top: var(--header-height);
      left: 0;
      right: 0;
      height: 100dvh;
      background-color: rgb(15 12 10 / 0.6);
      opacity: 0;
      visibility: hidden;
      transition:
        opacity 0.2s var(--ease-out),
        visibility 0s linear 0.2s;
    }

    .header__toggle-input:checked ~ .header__scrim {
      opacity: 1;
      visibility: visible;
      transition:
        opacity 0.2s var(--ease-out),
        visibility 0s;
    }

    .header__link {
      justify-content: flex-start;
      padding: 0.75rem var(--margin-mobile);
      border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    }

    .header__link::after {
      display: none;
    }

    .header__link--active {
      color: var(--color-accent);
    }

    .header__link:active {
      background-color: color-mix(in srgb, var(--color-accent) 18%, transparent);
    }

    .header__item--ally {
      margin-top: 0.75rem;
      border-top: 1px solid var(--color-steel-medium);
    }

    .header__cta--desktop {
      display: none;
    }

    .header__cta--mobile {
      margin: 1.25rem var(--margin-mobile) 1.5rem;
    }
  }

  @media (min-width: 1280px) {
    .header {
      gap: clamp(1rem, 3vw, 3rem);
      padding: 0 var(--margin-desktop);
    }

    .header__nav {
      display: flex;
      align-items: center;
    }

    .header__list {
      display: flex;
      align-items: center;
      gap: clamp(0.75rem, 1.7vw, var(--gutter));
    }

    .header__item {
      display: flex;
      align-items: center;
    }

    .header__item--ally {
      position: relative;
      padding-left: clamp(0.75rem, 1.7vw, var(--gutter));
    }

    .header__item--ally::before {
      content: "";
      position: absolute;
      left: 0;
      top: 50%;
      transform: translateY(-50%);
      width: 1px;
      height: 24px;
      background-color: var(--color-steel-medium);
    }

    .header__cta--mobile,
    .header__toggle {
      display: none;
    }
  }

  @media (min-width: 768px) {
    .header__logo {
      height: 40px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .header__nav,
    .header__toggle-input:checked ~ .header__nav,
    .header__link::after,
    .header__bar {
      transition: none;
    }
  }
</style>
