---
import { navItems, site } from "../data/site.js";

const year = new Date().getFullYear();

---

<footer class="footer">
  <div class="container footer__grid">
    <!-- Columna 1 — Marca y contacto -->
    <div class="footer__col">
      <a href="/" class="footer__brand" aria-label={`${site.name} — ir al inicio`}>
        <img src="/img/logo-jzinox.webp" alt="" width="900" height="200" loading="lazy" decoding="async" />
      </a>
      <address class="footer__address">
        {site.street},<br />
        {site.city}, {site.region}, Chile
      </address>
      <ul class="footer__contact">
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a href={`tel:${site.phoneHref}`}>{site.phoneDisplay}</a></li>
      </ul>
    </div>

    <!-- Columna 2 — Navegación -->
    <nav class="footer__col" aria-labelledby="footer-nav-title">
      <h2 class="footer__title" id="footer-nav-title">Navegación</h2>
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={["footer__link", item.ally && "footer__link--ally"]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Columna 3 — Horario -->
    <section class="footer__col" aria-labelledby="footer-hours-title">
      <h2 class="footer__title" id="footer-hours-title">Horario de Atención</h2>
      <ul class="footer__hours">
        {site.hoursLines.map((line) => <li>{line}</li>)}
      </ul>
    </section>

    <!-- Columna 4 — CTA, apoyado al margen derecho -->
    <div class="footer__col footer__col--cta">
      <a href="/contacto" class="btn btn--primary footer__cta">Cotizar Proyecto</a>
    </div>

    <!-- Barra inferior — ocupa las cuatro columnas -->
    <div class="footer__bottom">
      <p class="footer__copy">
        &copy; {year} {site.name}. Todos los derechos reservados.
      </p>

      <p class="footer__note">Sitio web en construcción — contenido de referencia.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-footer);
    border-top: 1px solid var(--color-border);
    /* Los 64px laterales del mockup ya los aporta .container (20px móvil,
       64px desde 1024px), así que aquí solo va el ritmo vertical. */
    padding-block: 4rem;
  }

  /* --- Rejilla: una columna en móvil, cuatro desde 768px --- */
  .footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gutter);
  }

  @media (min-width: 768px) {
    .footer__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Cuatro columnas reales. Antes el horario ocupaba dos y la cuarta quedaba
     vacía: un tercio del pie era aire muerto a la derecha. */
  @media (min-width: 1024px) {
    .footer__grid {
      grid-template-columns: 1.5fr 1fr 1.2fr auto;
    }

    .footer__col--cta {
      justify-self: end;
    }
  }

  /* --- Columna 1: marca y contacto --- */
  .footer__address {
    font-style: normal;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: 0.5rem;
  }

  /* --- Títulos de columna --- */
  /* Son <h2> a propósito: el pie es una landmark independiente y saltar de h1
     a h4 rompe la jerarquía. El tamaño de etiqueta lo da la clase, no el tag. */
  .footer__title {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.2;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-graphite);
    margin-bottom: 0.6rem;
  }

  .footer__col ul {
    display: flex;
    flex-direction: column;
  }

  .footer__hours li {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    padding: 0.3rem 0;
  }

  /* Cada enlace del pie es un objetivo táctil real de 44px. Antes medían
     ~23px de alto, la mitad del mínimo, y son 10 enlaces seguidos. */
  .footer__col a,
  .footer__contact a,
  .footer__legal a {
    display: flex;
    align-items: center;
    min-height: var(--tap);
    font-size: 0.875rem;
    /* #59413d sobre #eeeeee da 8:1. No usar --color-steel-medium: no llega
       a AA en textos de este tamaño. */
    color: var(--color-text-muted);
    transition: color 0.15s ease;
  }

  .footer__col a:hover,
  .footer__contact a:hover,
  .footer__legal a:hover {
    color: var(--color-accent);
  }

  /* AL Mueblería no es una sección de JZ Inox sino la marca aliada: peso extra
     y aire encima para que se lea como un salto de marca, no de página. */
  .footer__link--ally {
    font-weight: 700;
    margin-top: 0.5rem;
  }

  /* Hay que calificar con `.footer__col` para superar a `.footer__col a`, que
     es más específico que las clases sueltas de abajo: sin esto la marca se
     estira a todo el ancho y el texto del botón queda gris sobre el rojo. */
  .footer__col a.footer__brand {
    display: inline-flex;
    width: fit-content;
    margin-bottom: 0.6rem;
  }

  .footer__brand img {
    display: block;
    height: 34px;
    width: auto;
  }

  .footer__col a.footer__cta,
  .footer__col a.footer__cta:hover {
    display: inline-flex;
    justify-content: center;
    width: fit-content;
    font-size: 0.875rem;
    color: var(--color-on-accent);
  }

  /* --- Barra inferior --- */
  .footer__bottom {
    grid-column: 1 / -1;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
  }

  @media (min-width: 768px) {
    .footer__bottom {
      flex-direction: row;
      align-items: center;
      flex-wrap: wrap;
    }
  }

  .footer__bottom p {
    margin: 0;
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .footer__note {
    font-style: italic;
  }

  .footer__legal ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
  }

  .footer__legal a {
    font-size: 0.75rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .footer__col a,
    .footer__contact a,
    .footer__legal a {
      transition: none;
    }
  }
</style>
