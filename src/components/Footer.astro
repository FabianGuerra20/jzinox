---
import { navItems, site } from "../data/site.js";

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__col">
      <a href="/" class="footer__brand">{site.name}</a>
      <address class="footer__address">
        {site.street},<br />
        {site.city}, {site.region}, Chile
      </address>
      <ul class="footer__contact">
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a href={`tel:${site.phoneHref}`}>{site.phoneDisplay}</a></li>
      </ul>
    </div>

    <div class="footer__col">
      <h4>Navegación</h4>
      <ul>
        {navItems.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="footer__col">
      <h4>Horario de Atención</h4>
      <ul class="footer__hours">
        {site.hoursLines.map((line) => (
          <li>{line}</li>
        ))}
      </ul>
      <a href="/contacto" class="btn btn--primary footer__cta">Cotizar Proyecto</a>
    </div>
  </div>

  <div class="footer__bottom">
    <div class="container footer__bottom-inner">
      <p>&copy; {year} {site.name}. Todos los derechos reservados.</p>
      <p>Sitio web en construcción — contenido de referencia.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-bg-alt);
    border-top: 1px solid var(--color-border);
  }

  .footer__grid {
    display: grid;
    gap: clamp(1.8rem, 4vw, 2.5rem);
    padding-top: clamp(2.2rem, 5vw, 3.5rem);
    padding-bottom: clamp(1.8rem, 4vw, 2.5rem);
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .footer__grid {
      grid-template-columns: 1.5fr 1fr 1fr;
    }
  }

  .footer__brand {
    display: inline-block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(1.2rem, 2.5vw, 1.35rem);
    letter-spacing: 0.03em;
    color: var(--color-graphite);
    margin-bottom: 0.9rem;
  }

  .footer__address {
    font-style: normal;
    font-size: 0.92rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: 0.5rem;
  }

  .footer__col h4 {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-graphite);
    margin-bottom: 0.6rem;
  }

  .footer__col ul {
    display: flex;
    flex-direction: column;
  }

  .footer__hours li {
    font-size: 0.92rem;
    color: var(--color-text-muted);
    padding: 0.3rem 0;
  }

  /* Cada enlace del pie es un objetivo táctil real de 44px. Antes medían
     ~23px de alto, la mitad del mínimo, y son 9 enlaces seguidos. */
  .footer__col a,
  .footer__contact a {
    display: flex;
    align-items: center;
    min-height: var(--tap);
    font-size: 0.92rem;
    color: var(--color-text-muted);
    transition: color 0.15s ease;
  }

  .footer__col a:hover,
  .footer__contact a:hover {
    color: var(--color-accent);
  }

  .footer__cta {
    margin-top: 1.2rem;
  }

  /* Hay que calificar con `.footer__col` para superar a `.footer__col a`, que
     es más específico que `.btn--primary`: sin esto el texto del botón queda
     gris sobre el rojo corporativo. */
  .footer__col a.footer__cta,
  .footer__col a.footer__cta:hover {
    display: inline-flex;
    justify-content: center;
    color: #fff;
  }

  .footer__bottom {
    border-top: 1px solid var(--color-border);
  }

  .footer__bottom-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    justify-content: space-between;
    padding-top: 1.2rem;
    padding-bottom: 1.2rem;
  }

  .footer__bottom p {
    margin: 0;
    font-size: 0.78rem;
    color: var(--color-steel);
  }
</style>
