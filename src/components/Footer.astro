---
import { navItems, site } from "../data/site.js";
import { srcset } from "../utils/img.js";

const year = new Date().getFullYear();
const logo = "/img/logo-jzinox.webp";
---

<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__col">
      <a href="/" class="footer__brand" aria-label={`${site.name}, volver al inicio`}>
        <img src={logo} srcset={srcset(logo)} sizes="160px" alt="" width="900" height="200" loading="lazy" decoding="async" />
      </a>
      <ul class="footer__contact">
        <li><a class="link-press" href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a class="link-press" href={`tel:${site.phoneHref}`}>{site.phoneDisplay}</a></li>
      </ul>
    </div>

    <nav class="footer__col" aria-labelledby="footer-nav-title">
      <h2 class="footer__title" id="footer-nav-title">Navegación</h2>
      <ul class="footer__nav">
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} class:list={["footer__link", "link-press", item.ally && "footer__link--ally"]}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <section class="footer__col" aria-labelledby="footer-shop-title">
      <h2 class="footer__title" id="footer-shop-title">Taller</h2>
      <address class="footer__address">
        {site.street}<br />
        {site.city}, {site.region}
      </address>
      <ul class="footer__hours">
        {site.hoursLines.map((line) => <li>{line}</li>)}
      </ul>
      <ul class="footer__maps">
        <li><a class="link-press" href={site.mapsHref} target="_blank" rel="noopener noreferrer">Abrir en Google Maps</a></li>
        <li><a class="link-press" href={site.wazeHref} target="_blank" rel="noopener noreferrer">Abrir en Waze</a></li>
      </ul>
    </section>

    <div class="footer__bottom">
      <p class="footer__copy">
        &copy; {year} {site.name}. Todos los derechos reservados.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-footer);
    border-top: 1px solid var(--color-border);
    padding-block: 2.5rem;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem var(--gutter);
  }

  @media (min-width: 768px) {
    .footer {
      padding-block: 4rem;
    }

    .footer__grid {
      grid-template-columns: 1.4fr 1fr 1.2fr;
    }
  }

  .footer__title {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.2;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-text-muted);
    margin-bottom: 0.6rem;
  }

  .footer__address,
  .footer__hours li {
    font-style: normal;
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  .footer__hours {
    margin-top: 0.5rem;
  }

  .footer__nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  @media (min-width: 768px) {
    .footer__nav {
      grid-template-columns: 1fr;
    }
  }

  .footer__maps {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
    margin-top: 0.25rem;
  }

  .footer__col a {
    display: flex;
    align-items: center;
    min-height: var(--tap);
    font-size: 0.875rem;
    color: var(--color-text-muted);
    transition: color 0.15s ease;
  }

  .footer__maps a {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }

  @media (hover: hover) and (pointer: fine) {
    .footer__col a:hover {
      color: var(--color-accent);
    }
  }

  .footer__link--ally {
    font-weight: 700;
  }

  .footer__col a.footer__brand {
    display: inline-flex;
    width: fit-content;
    margin-bottom: 0.4rem;
  }

  .footer__brand img {
    display: block;
    height: 34px;
    width: auto;
  }

  .footer__bottom {
    grid-column: 1 / -1;
    margin-top: 0.5rem;
    padding-top: 1.25rem;
    padding-bottom: 3.5rem;
    border-top: 1px solid var(--color-border);
  }

  @media (min-width: 768px) {
    .footer__bottom {
      margin-top: 1.5rem;
      padding-top: 2rem;
      padding-bottom: 0;
    }
  }

  .footer__bottom p {
    margin: 0;
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .footer__col a {
      transition: none;
    }
  }
</style>
