---
/**
 * Hero principal de la home.
 *
 * Una sola grilla de 12 columnas ("placa continua"): la imagen, el panel de
 * productos destacados y el bloque de titular + CTAs son celdas del mismo bento,
 * separadas por juntas de 1px. Nada flota: cada pieza tiene su geometría dentro
 * del ensamblaje.
 */
import { catalog } from "../data/catalog.js";

interface Props {
  products?: Array<{ id: string; name: string; description: string }>;
  heading?: string;
  subheading?: string;
}

const {
  products = catalog.slice(0, 4),
  heading = "JZINOX: Soluciones de Acero de Precisión para su Cocina",
  subheading = "Equipamiento industrial, soldadura TIG y estructuras a medida.",
} = Astro.props;
---

<section class="hero">
  <div class="container">
    <div class="bento hero__bento">
      <figure class="bento__cell bento__cell--flush hero__media">
        <img
          src="/hero-placeholder.svg"
          alt="Línea de cocción industrial en acero inoxidable fabricada por JZINOX"
          width="960"
          height="600"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <figcaption>Imagen referencial — a reemplazar</figcaption>
      </figure>

      <aside class="bento__cell bento__cell--flush hero__aside" aria-labelledby="hero-destacados">
        <h2 id="hero-destacados" class="hero__aside-title">Productos destacados</h2>

        <ul class="hero__list">
          {
            products.map((item, i) => (
              <li>
                <a href="/catalogo" class="hero__list-link">
                  <span class="hero__list-index">{String(i + 1).padStart(2, "0")}</span>
                  <span class="hero__list-text">
                    <strong>{item.name}</strong>
                    <span>{item.description}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>

        <a href="/catalogo" class="hero__aside-link">Ver catálogo completo</a>
      </aside>

      <div class="bento__cell hero__pitch">
        <h1>{heading}</h1>
        <p>{subheading}</p>
        <div class="hero__actions">
          <a href="/catalogo" class="btn btn--primary">Ver Catálogo</a>
          <a href="/servicios" class="btn btn--outline">Ver Servicios</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 2.5rem 0 4rem;
  }

  /* Una columna en móvil; el ensamblaje de 12 columnas entra en escritorio */
  .hero__bento {
    grid-template-areas:
      "media"
      "aside"
      "pitch";
  }

  @media (min-width: 900px) {
    .hero__bento {
      grid-template-columns: repeat(12, 1fr);
      grid-template-areas:
        "media media media media media media media media aside aside aside aside"
        "pitch pitch pitch pitch pitch pitch pitch pitch pitch pitch pitch pitch";
    }
  }

  /* --- Celda de imagen --- */
  .hero__media {
    grid-area: media;
    position: relative;
    margin: 0;
    aspect-ratio: 16 / 10;
    background-color: var(--color-surface);
  }

  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Etiqueta técnica sólida, sin difuminado */
  .hero__media figcaption {
    position: absolute;
    left: 0;
    bottom: 0;
    background-color: var(--color-graphite);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    padding: 0.38rem 0.7rem;
  }

  /* --- Panel de productos destacados --- */
  .hero__aside {
    grid-area: aside;
    display: flex;
    flex-direction: column;
  }

  .hero__aside-title {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    margin: 0;
    padding: 1.15rem 1.35rem;
    border-bottom: 1px solid var(--color-border);
  }

  /* Las filas también se separan con la junta de 1px, a sangre completa */
  .hero__list {
    display: grid;
    gap: 1px;
    background-color: var(--color-border);
  }

  .hero__list > li {
    background-color: var(--color-bg);
  }

  .hero__list-link {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.7rem;
    padding: 0.85rem 1.35rem;
    transition: background-color 0.15s ease, box-shadow 0.15s ease;
  }

  .hero__list-link:hover {
    background-color: var(--color-bg-alt);
    box-shadow: inset 3px 0 0 var(--color-accent);
  }

  .hero__list-index {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.55;
    color: var(--color-steel-dark);
  }

  .hero__list-text strong {
    display: block;
    font-size: 0.87rem;
    line-height: 1.35;
    color: var(--color-graphite);
  }

  .hero__list-text > span {
    display: block;
    font-size: 0.82rem;
    line-height: 1.45;
    color: var(--color-text-muted);
  }

  .hero__list-link:hover strong {
    color: var(--color-accent);
  }

  .hero__aside-link {
    margin-top: auto; /* ancla el enlace al pie de la celda */
    padding: 1rem 1.35rem;
    border-top: 1px solid var(--color-border);
    font-family: var(--font-heading);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-accent);
  }

  .hero__aside-link:hover {
    background-color: var(--color-bg-alt);
    text-decoration: underline;
  }

  /* --- Celda del titular --- */
  .hero__pitch {
    grid-area: pitch;
    text-align: center;
    padding: 3rem 1.75rem 3.25rem;
  }

  .hero__pitch h1 {
    max-width: 26ch;
    margin-left: auto;
    margin-right: auto;
  }

  .hero__pitch p {
    font-size: 1.05rem;
    max-width: 52ch;
    margin: 0 auto;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    margin-top: 1.7rem;
  }
</style>
