---
interface Props {
  size?: number;
}

const { size = 18 } = Astro.props as Props;
---

<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  aria-hidden="true"
  focusable="false"
>
  <rect x="3" y="3" width="18" height="18" rx="5"></rect>
  <circle cx="12" cy="12" r="4.2"></circle>
  <circle cx="17.4" cy="6.6" r="0.9" fill="currentColor" stroke="none"></circle>
</svg>
