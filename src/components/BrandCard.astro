---
import MediaPlaceholder from "./MediaPlaceholder.astro";
/**
 * Placa de marca del Inicio.
 *
 * Una sola placa dividida en tres bloques unidos por juntas de 1px, en la
 * proporción 3/6/3 del mockup:
 *
 *   [ Identidad + CTAs ] | [ Galería enmarcada ] | [ Productos destacados ]
 *
 * El bloque central no es una imagen a sangre: es una imagen ENMARCADA sobre
 * una mesa de trabajo con retícula de puntos. Ese aire alrededor es lo que la
 * hace leer como pieza sobre un plano y no como banner. Las flechas se apoyan
 * justo en el canto del marco, medio dentro y medio fuera.
 *
 * El carrusel funciona sin JavaScript (scroll-snap + gesto táctil). Las flechas
 * y los puntos son progresivos: quedan ocultos hasta que el script los habilita,
 * así nunca se muestra un control muerto.
 */
interface Props {
  brand: {
    slug: string;
    name: string;
    eyebrow: string;
    lead: string;
    actions: Array<{ href: string; label: string; variant: string }>;
    featuredTitle: string;
    featuredHref: string;
    featuredLabel: string;
    featured: Array<{ name: string; note: string }>;
    images: Array<{ src: string; alt: string; pending?: boolean; slot?: string; ratio?: string }>;
  };
  /** true solo en la primera placa: su imagen es la candidata a LCP */
  eager?: boolean;
}

const { brand, eager = false } = Astro.props as Props;

// `.media-frame` entrega la foto desaturada y le devuelve el color en hover:
// es la interacción firma del sistema. Sobre placeholders grises ese gesto se
// degrada a "caja gris → caja gris un poco más grande", que se siente roto.
// Mientras la galería sea de huecos, el marco va sin revelado.
const allPending = brand.images.every((image) => image.pending);

const headingId = `marca-${brand.slug}`;
const featuredId = `destacados-${brand.slug}`;
---

<article class="bento brand-card" aria-labelledby={headingId}>
  {/* --- Bloque 1: identidad de la marca --- */}
  <div class="bento__cell brand-card__identity">
    <p class="brand-card__eyebrow">{brand.eyebrow}</p>
    <h2 id={headingId} class="brand-card__name">{brand.name}</h2>
    <p class="brand-card__lead">{brand.lead}</p>

    <div class="brand-card__actions">
      {
        brand.actions.map((action) => (
          <a href={action.href} class:list={["btn", `btn--${action.variant}`]}>
            {action.label}
          </a>
        ))
      }
    </div>
  </div>

  {/* --- Bloque 2: galería enmarcada --- */}
  <div
    class="bento__cell bento__cell--flush brand-card__media"
    data-carousel
    role="group"
    aria-roledescription="carrusel"
    aria-label={`Imágenes de ${brand.name}`}
  >
    <div class:list={["brand-card__viewport", { "media-frame": !allPending }]}>
      <ul class="carousel__track" data-carousel-track>
        {
          brand.images.map((image, i) => (
            <li class="carousel__slide">
              {
                image.pending ? (
                  <MediaPlaceholder slot={image.slot} ratio={image.ratio} eager={eager && i === 0} />
                ) : (
                  <img
                    src={image.src}
                    alt={image.alt}
                    width="800"
                    height="600"
                    loading={eager && i === 0 ? "eager" : "lazy"}
                    fetchpriority={eager && i === 0 ? "high" : undefined}
                    decoding="async"
                  />
                )
              }
            </li>
          ))
        }
      </ul>
    </div>

    <button type="button" class="carousel__arrow carousel__arrow--prev" data-carousel-prev hidden>
      <span class="visually-hidden">Imagen anterior</span>
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M15 5 8 12l7 7" />
      </svg>
    </button>

    <button type="button" class="carousel__arrow carousel__arrow--next" data-carousel-next hidden>
      <span class="visually-hidden">Imagen siguiente</span>
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="m9 5 7 7-7 7" />
      </svg>
    </button>

    <div class="carousel__dots" data-carousel-dots hidden>
      {
        brand.images.map((_, i) => (
          <button type="button" class="carousel__dot" data-carousel-dot={i}>
            <span class="visually-hidden">{`Ir a la imagen ${i + 1}`}</span>
          </button>
        ))
      }
    </div>
  </div>

  {/* --- Bloque 3: productos destacados --- */}
  <aside class="bento__cell bento__cell--flush brand-card__featured" aria-labelledby={featuredId}>
    <h3 id={featuredId} class="brand-card__featured-title">{brand.featuredTitle}</h3>

    <ul class="brand-card__list">
      {
        brand.featured.map((item, i) => (
          <li>
            <a href={brand.featuredHref} class="brand-card__list-link">
              <span class="brand-card__list-index">{String(i + 1).padStart(2, "0")}</span>
              <span class="brand-card__list-text">
                <strong>{item.name}</strong>
                <span>{item.note}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <a href={brand.featuredHref} class="brand-card__featured-link">{brand.featuredLabel}</a>
  </aside>
</article>

<style>
  /* Una columna en móvil; la proporción 3/6/3 del mockup en escritorio */
  .brand-card {
    grid-template-areas:
      "identity"
      "media"
      "featured";
  }

  @media (min-width: 1024px) {
    .brand-card {
      grid-template-columns: 3fr 6fr 3fr;
      grid-template-areas: "identity media featured";
    }
  }

  /* --- Bloque 1: identidad --- */
  .brand-card__identity {
    grid-area: identity;
    display: flex;
    flex-direction: column;
  }

  /* Etiqueta de posición en el ecosistema. Va ARRIBA del nombre, como el
     eyebrow del mockup. */
  .brand-card__eyebrow {
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 1rem;
  }

  .brand-card__name {
    font-size: clamp(1.6rem, 3vw, 2rem);
    line-height: 1.2;
    margin-bottom: 1rem;
  }

  .brand-card__lead {
    font-size: 0.875rem;
    line-height: 1.5;
    max-width: 40ch;
  }

  /* Apilados a ancho completo: en una columna de 3/12 dos botones en línea no
     caben sin partir la palabra, y el mockup los muestra así. */
  .brand-card__actions {
    display: grid;
    gap: 1rem;
    margin-top: auto; /* ancla los CTA al pie de la placa */
    padding-top: 1.5rem;
  }

  /* --- Bloque 2: galería --- */
  /* Mesa de trabajo: gris hundido con retícula de puntos cada 20px. El
     radial-gradient sustituye al data-URI del mockup — mismo dibujo, sin
     base64 y usando el token de color. */
  .brand-card__media {
    grid-area: media;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 400px;
    padding: 2rem;
    background-color: var(--color-surface);
    background-image: radial-gradient(circle at 1px 1px, var(--color-border) 1px, transparent 0);
    background-size: 20px 20px;
  }

  /* El marco blanco. `.media-frame` (global) le da el recorte y el revelado
     de color + zoom al pasar el cursor. */
  .brand-card__viewport {
    position: relative;
    z-index: 1;
    width: 100%;
    align-self: stretch;
    border: 1px solid var(--color-border);
    background-color: var(--color-bg);
    box-shadow: var(--shadow-sm);
  }

  .carousel__track {
    display: flex;
    height: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .carousel__track::-webkit-scrollbar {
    display: none;
  }

  .carousel__slide {
    flex: 0 0 100%;
    scroll-snap-align: center;
    min-width: 0;
    display: flex;
  }

  .carousel__slide > * {
    width: 100%;
  }

  /* El marco tiene altura propia (`align-self: stretch` sobre una celda de
     400px). El hueco de foto trae su propia proporción, así que dejaba una
     franja blanca bajo el placeholder. Dentro del carrusel manda la altura del
     marco, igual que haría la foto real con object-fit: cover. */
  .carousel__slide > :global(.media-ph) {
    aspect-ratio: auto;
    height: 100%;
  }

  /* `aspect-ratio` explícito, no solo `height: 100%`: sin él la altura depende
     del stretch del contenedor y el atributo height="600" del HTML se impone
     en cuanto alguien cambie el layout de la placa. */
  .carousel__slide img {
    height: 100%;
    min-height: 336px;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  /* Controles sólidos, sin difuminado: chapa de acero apoyada en el canto del
     marco, medio dentro y medio fuera, como en el mockup. */
  .carousel__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--tap);
    height: var(--tap);
    padding: 0;
    border: 1px solid var(--color-border);
    background-color: var(--color-bg);
    color: var(--color-steel);
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .carousel__arrow:hover {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
    color: #fff;
  }

  .carousel__arrow--prev {
    left: 1rem;
  }

  .carousel__arrow--next {
    right: 1rem;
  }

  /* Área táctil de 44px sin engordar el botón visible de 40px */
  .carousel__arrow::before {
    content: "";
    position: absolute;
    inset: -2px;
  }

  .carousel__dots {
    position: absolute;
    left: 50%;
    bottom: 1rem;
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    gap: 0.5rem;
    padding: 0.35rem 0.5rem;
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
  }

  .carousel__dot {
    position: relative; /* ancla del área táctil de abajo */
    width: 24px;
    height: 4px;
    padding: 0;
    border: 0;
    background-color: var(--color-surface-dim);
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .carousel__dot[aria-current="true"] {
    background-color: var(--color-accent);
  }

  /* Área táctil de 44px sin engordar la barra visible */
  .carousel__dot::before {
    content: "";
    position: absolute;
    inset-block: -20px;
    width: 24px;
  }

  /* --- Bloque 3: productos destacados --- */
  .brand-card__featured {
    grid-area: featured;
    display: flex;
    flex-direction: column;
  }

  .brand-card__featured-title {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-graphite);
    margin: 0;
    padding: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .brand-card__list {
    display: flex;
    flex-direction: column;
  }

  .brand-card__list > li + li {
    border-top: 1px solid var(--color-border);
  }

  .brand-card__list-link {
    display: grid;
    grid-template-columns: 1.5rem 1fr;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    transition: background-color 0.15s ease, box-shadow 0.15s ease;
  }

  .brand-card__list-link:hover,
  .brand-card__list-link:focus-visible {
    background-color: var(--color-surface);
    box-shadow: inset 3px 0 0 var(--color-accent);
  }

  .brand-card__list-index {
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.6;
    color: var(--color-steel);
  }

  .brand-card__list-text strong {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--color-graphite);
    margin-bottom: 0.25rem;
  }

  .brand-card__list-text > span {
    display: block;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .brand-card__list-link:hover strong {
    color: var(--color-accent);
  }

  .brand-card__featured-link {
    display: flex;
    align-items: center;
    min-height: var(--tap);
    margin-top: auto;
    padding: 1rem 1.5rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-accent);
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .brand-card__featured-link:hover {
    background-color: var(--color-surface);
    color: var(--color-accent-dark);
    text-decoration: underline;
  }
</style>

<script>
  // Progressive enhancement: sin JS el carrusel sigue siendo desplazable
  // (scroll-snap + gesto). El script solo agrega flechas y puntos.
  document.querySelectorAll("[data-carousel]").forEach((root) => {
    const track = root.querySelector("[data-carousel-track]");
    const prev = root.querySelector("[data-carousel-prev]");
    const next = root.querySelector("[data-carousel-next]");
    const dotsBox = root.querySelector("[data-carousel-dots]");
    if (!(track instanceof HTMLElement)) return;

    const slides = Array.from(track.children);
    if (slides.length < 2) return;

    const dots = dotsBox ? Array.from(dotsBox.querySelectorAll("[data-carousel-dot]")) : [];

    // Solo ahora se revelan los controles: ya sabemos que funcionan
    if (prev instanceof HTMLElement) prev.hidden = false;
    if (next instanceof HTMLElement) next.hidden = false;
    if (dotsBox instanceof HTMLElement) dotsBox.hidden = false;

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const indexOf = () => Math.round(track.scrollLeft / track.clientWidth);

    const goTo = (index) => {
      const clamped = Math.max(0, Math.min(slides.length - 1, index));
      track.scrollTo({ left: clamped * track.clientWidth, behavior: reduceMotion ? "auto" : "smooth" });
    };

    const syncDots = () => {
      const current = indexOf();
      dots.forEach((dot, i) => dot.setAttribute("aria-current", String(i === current)));
    };

    prev?.addEventListener("click", () => goTo(indexOf() - 1));
    next?.addEventListener("click", () => goTo(indexOf() + 1));
    dots.forEach((dot, i) => dot.addEventListener("click", () => goTo(i)));

    // Un solo repintado por frame mientras el usuario desplaza
    let ticking = false;
    track.addEventListener("scroll", () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        syncDots();
        ticking = false;
      });
    });

    syncDots();
  });
</script>
