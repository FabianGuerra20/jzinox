---
---

<div id="tig-sparks" aria-hidden="true"></div>

<style>
  #tig-sparks {
    position: fixed;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 9999;
    contain: strict;
  }

  #tig-sparks :global(.spark) {
    position: absolute;
    top: 0;
    left: 0;
    width: 2px;
    height: 11px;
    border-radius: 40%;
    background-color: rgb(var(--c, 255, 168, 56));
    opacity: 0;
    will-change: transform, opacity;
  }

  #tig-sparks :global(.spark)::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 22px;
    height: 34px;
    transform: translate(-50%, -50%);
    background: radial-gradient(
      closest-side,
      rgba(var(--c, 255, 168, 56), calc(0.7 * var(--a, 1))) 0%,
      rgba(var(--c, 255, 168, 56), calc(0.25 * var(--a, 1))) 55%,
      transparent 100%
    );
  }

  @media (hover: none), (pointer: coarse), (prefers-reduced-motion: reduce) {
    #tig-sparks {
      display: none;
    }
  }
</style>

<script>
  const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (finePointer && !reducedMotion) {
    const layer = document.getElementById("tig-sparks");

    const POOL_SIZE = 90;
    const GRAVITY = 980;
    const FRICTION = 0.12;
    const SPREAD = 2.5;
    const SPAWN_DISTANCE = 9;
    const MAX_DT = 0.05;
    const MAX_DRAG_SPEED = 1400;
    const HEAT_STEPS = 8;
    const SPARK_OFF = "form, dialog";

    const HEAT = [
      { t: 0.0, c: [255, 253, 244], glow: 13 },
      { t: 0.18, c: [255, 236, 160], glow: 11 },
      { t: 0.45, c: [255, 168, 56], glow: 8 },
      { t: 0.75, c: [216, 80, 63], glow: 4 },
      { t: 1.0, c: [124, 33, 22], glow: 0 },
    ];

    function heatAt(t) {
      let a = HEAT[0];
      let b = HEAT[HEAT.length - 1];
      for (let i = 0; i < HEAT.length - 1; i++) {
        if (t >= HEAT[i].t && t <= HEAT[i + 1].t) {
          a = HEAT[i];
          b = HEAT[i + 1];
          break;
        }
      }
      const span = b.t - a.t || 1;
      const k = (t - a.t) / span;
      return {
        r: Math.round(a.c[0] + (b.c[0] - a.c[0]) * k),
        g: Math.round(a.c[1] + (b.c[1] - a.c[1]) * k),
        b: Math.round(a.c[2] + (b.c[2] - a.c[2]) * k),
        glow: a.glow + (b.glow - a.glow) * k,
      };
    }

    const pool = [];
    const frag = document.createDocumentFragment();
    for (let i = 0; i < POOL_SIZE; i++) {
      const el = document.createElement("span");
      el.className = "spark";
      frag.appendChild(el);
      pool.push({ el, alive: false, x: 0, y: 0, vx: 0, vy: 0, age: 0, life: 1, scale: 1, stage: -1 });
    }
    layer.appendChild(frag);

    let cursor = 0;
    let rafId = null;
    let lastFrame = 0;
    let lastX = null;
    let lastY = null;
    let lastMoveTime = 0;

    function emit(x, y, dragVx, dragVy) {
      const p = pool[cursor];
      cursor = (cursor + 1) % POOL_SIZE;

      const angle = -Math.PI / 2 + (Math.random() - 0.5) * SPREAD;
      const heavy = Math.random() < 0.12;
      const speed = (heavy ? 260 : 120) + Math.random() * (heavy ? 220 : 180);

      p.x = x;
      p.y = y;
      p.vx = Math.cos(angle) * speed + dragVx * 0.18;
      p.vy = Math.sin(angle) * speed + dragVy * 0.18;
      p.age = 0;
      p.life = (heavy ? 0.62 : 0.34) + Math.random() * 0.38;
      p.scale = heavy ? 1.15 + Math.random() * 0.5 : 0.55 + Math.random() * 0.5;
      p.stage = -1;
      p.alive = true;
    }

    function frame(now) {
      const dt = Math.min((now - lastFrame) / 1000, MAX_DT);
      lastFrame = now;

      const drag = Math.pow(FRICTION, dt);
      let living = 0;

      for (let i = 0; i < POOL_SIZE; i++) {
        const p = pool[i];
        if (!p.alive) continue;

        p.age += dt;
        if (p.age >= p.life) {
          p.alive = false;
          p.el.style.opacity = "0";
          continue;
        }
        living++;

        p.vx *= drag;
        p.vy = p.vy * drag + GRAVITY * dt;
        p.x += p.vx * dt;
        p.y += p.vy * dt;

        const t = p.age / p.life;

        const stage = Math.min(Math.floor(t * HEAT_STEPS), HEAT_STEPS - 1);
        if (stage !== p.stage) {
          p.stage = stage;
          const heat = heatAt((stage + 0.5) / HEAT_STEPS);
          p.el.style.setProperty("--c", heat.r + "," + heat.g + "," + heat.b);
          p.el.style.setProperty("--a", (heat.glow / 13).toFixed(2));
        }

        const speed = Math.hypot(p.vx, p.vy);
        const angle = (Math.atan2(p.vy, p.vx) * 180) / Math.PI + 90;
        const stretch = Math.min(0.5 + speed / 260, 2.6);

        const alpha = t < 0.55 ? 1 : 1 - (t - 0.55) / 0.45;

        p.el.style.transform =
          "translate3d(" + p.x.toFixed(2) + "px," + p.y.toFixed(2) + "px,0) rotate(" +
          angle.toFixed(1) + "deg) scale(" + p.scale.toFixed(2) + "," +
          (p.scale * stretch).toFixed(2) + ") translate(-50%,-50%)";
        p.el.style.opacity = alpha.toFixed(3);
      }

      rafId = living > 0 ? requestAnimationFrame(frame) : null;
    }

    function startLoop() {
      if (rafId === null) {
        lastFrame = performance.now();
        rafId = requestAnimationFrame(frame);
      }
    }

    function onPointerMove(event) {
      if (!(event.target instanceof Element) || event.target.closest(SPARK_OFF)) {
        lastX = null;
        return;
      }

      const x = event.clientX;
      const y = event.clientY;
      const now = performance.now();

      if (lastX === null) {
        lastX = x;
        lastY = y;
        lastMoveTime = now;
        return;
      }

      const dx = x - lastX;
      const dy = y - lastY;
      const distance = Math.hypot(dx, dy);
      if (distance < SPAWN_DISTANCE) return;

      const elapsed = Math.max((now - lastMoveTime) / 1000, 0.008);
      let dragVx = dx / elapsed;
      let dragVy = dy / elapsed;
      const dragSpeed = Math.hypot(dragVx, dragVy);
      if (dragSpeed > MAX_DRAG_SPEED) {
        const k = MAX_DRAG_SPEED / dragSpeed;
        dragVx *= k;
        dragVy *= k;
      }

      const steps = Math.min(Math.round(distance / SPAWN_DISTANCE), 5);
      for (let i = 1; i <= steps; i++) {
        const k = i / steps;
        const burst = 1 + Math.floor(Math.random() * 2);
        for (let n = 0; n < burst; n++) {
          emit(lastX + dx * k, lastY + dy * k, dragVx, dragVy);
        }
      }

      lastX = x;
      lastY = y;
      lastMoveTime = now;
      startLoop();
    }

    window.addEventListener("pointermove", onPointerMove, { passive: true });

    document.addEventListener("visibilitychange", () => {
      if (document.hidden && rafId !== null) {
        cancelAnimationFrame(rafId);
        rafId = null;
        for (let i = 0; i < POOL_SIZE; i++) {
          pool[i].alive = false;
          pool[i].el.style.opacity = "0";
        }
      }
    });
  }
</script>
