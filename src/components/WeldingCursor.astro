<canvas id="welding-sparks" aria-hidden="true"></canvas>

<style>
  #welding-sparks {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 9999;
  }
</style>

<script>
  const canFineHover = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (canFineHover && !prefersReducedMotion) {
    const canvas = document.getElementById("welding-sparks");
    const ctx = canvas.getContext("2d");

    const COLORS = ["#c0392b", "#d8503f", "#5c6267", "#2b3138"];
    const MAX_PARTICLES = 140;
    const SPAWN_DISTANCE = 7;
    const GRAVITY = 0.22;
    const FRICTION = 0.965;

    let particles = [];
    let dpr = Math.min(window.devicePixelRatio || 1, 2);
    let rafId = null;
    let lastX = null;
    let lastY = null;

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = window.innerWidth * dpr;
      canvas.height = window.innerHeight * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function spawnSparks(x, y, count) {
      for (let i = 0; i < count; i++) {
        if (particles.length >= MAX_PARTICLES) particles.shift();
        const angle = Math.random() * Math.PI * 2;
        const speed = 1 + Math.random() * 3.2;
        const life = 22 + Math.random() * 20;
        particles.push({
          x,
          y,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed - 1.2,
          life,
          maxLife: life,
          size: 1 + Math.random() * 1.8,
          color: COLORS[Math.floor(Math.random() * COLORS.length)],
        });
      }
      startLoop();
    }

    function step() {
      ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);

      particles = particles.filter((p) => p.life > 0);

      for (const p of particles) {
        p.vx *= FRICTION;
        p.vy = p.vy * FRICTION + GRAVITY;
        p.x += p.vx;
        p.y += p.vy;
        p.life -= 1;

        const alpha = Math.max(p.life / p.maxLife, 0);
        ctx.globalAlpha = alpha;
        ctx.fillStyle = p.color;
        ctx.fillRect(p.x - p.size / 2, p.y - p.size / 2, p.size, p.size);
      }

      ctx.globalAlpha = 1;

      if (particles.length > 0) {
        rafId = requestAnimationFrame(step);
      } else {
        rafId = null;
      }
    }

    function startLoop() {
      if (rafId === null) {
        rafId = requestAnimationFrame(step);
      }
    }

    function onPointerMove(event) {
      const { clientX: x, clientY: y } = event;
      if (lastX === null) {
        lastX = x;
        lastY = y;
        return;
      }
      const dx = x - lastX;
      const dy = y - lastY;
      const distance = Math.sqrt(dx * dx + dy * dy);

      if (distance >= SPAWN_DISTANCE) {
        const steps = Math.min(Math.floor(distance / SPAWN_DISTANCE), 4);
        for (let i = 0; i < steps; i++) {
          const t = (i + 1) / steps;
          spawnSparks(lastX + dx * t, lastY + dy * t, 1 + Math.floor(Math.random() * 2));
        }
        lastX = x;
        lastY = y;
      }
    }

    resize();
    window.addEventListener("resize", resize);
    window.addEventListener("pointermove", onPointerMove, { passive: true });
  }
</script>
