---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FloatingContact from "../components/FloatingContact.astro";
import WeldingCursor from "../components/WeldingCursor.astro";
import Seo from "../components/Seo.astro";
import { site } from "../data/site.js";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** El Inicio pinta su propio hero a sangre bajo el header fijo. */
  flush?: boolean;
  /** Páginas que no deben aparecer en Google: /gracias y la 404. */
  noindex?: boolean;
  /** JSON-LD propio de la página, ya serializado. */
  jsonLd?: string;
}

const { title, description = site.description, flush = false, noindex = false, jsonLd } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : `${site.name} — ${site.tagline}`;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		{/* Marca que hay JavaScript ANTES del primer pintado: de esta clase cuelga
		    el estado oculto de `data-reveal`. Sin JS no existe y todo se ve. */}
		<script is:inline>
			document.documentElement.classList.add("js");
		</script>
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />
		<meta name="theme-color" content="#16120f" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		{/* Una página de agradecimiento en los resultados de Google es una mala
		    experiencia (se llega a un "gracias" sin haber enviado nada) y además
		    infla las conversiones si se miden por visitas a esa URL. */}
		{noindex && <meta name="robots" content="noindex, follow" />}
		<title>{pageTitle}</title>
		<Seo title={pageTitle} description={description}>
			{jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
		</Seo>

		{/* Las dos fuentes viven en public/fonts (ver global.css) y se precargan:
		    sin la hoja de Google, que bloqueaba el primer pintado, y sin dos
		    conexiones a terceros. `crossorigin` es obligatorio en un preload de
		    fuente aunque sea del mismo origen. */}
		<link rel="preload" href="/fonts/hanken-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
	</head>
	<body>
		<a href="#main-content" class="skip-link">Saltar al contenido</a>
		<Header />
		{/* El header es `fixed`: ya no ocupa espacio en el flujo y hay que
		    compensar su altura aquí, una sola vez, para todo el sitio. */}
		<main id="main-content" class:list={{ "main--flush": flush }}>
			<slot />
		</main>
		<Footer />
		<FloatingContact />
		<WeldingCursor />

		{/* Visor ampliado de fotos: un solo <dialog> para toda la página. Lo abre
		    cualquier enlace con `data-zoom` (ver el script de abajo). */}
		<dialog class="lightbox" data-lightbox aria-label="Foto ampliada">
			<button type="button" class="lightbox__close" data-lightbox-close aria-label="Cerrar la foto">
				<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
					<path d="M5 5l14 14M19 5 5 19" />
				</svg>
			</button>
			<img alt="" data-lenis-prevent />
		</dialog>

		<style>
			main {
				padding-top: var(--header-height);
			}

			/* El Inicio arranca con una foto a sangre que debe pasar POR DEBAJO de
			   la barra translúcida: ahí el header no se compensa, se superpone. */
			.main--flush {
				padding-top: 0;
			}
		</style>

		{/* Revelado al entrar en pantalla (ver global.css). Va en línea y al final
		    del body para que corra apenas existe el DOM, sin esperar al bundle. Si
		    el navegador no tiene IntersectionObserver, todo se muestra de una vez. */}
		<script is:inline>
			(function () {
				var items = document.querySelectorAll("[data-reveal]");
				if (!("IntersectionObserver" in window)) {
					for (var i = 0; i < items.length; i++) items[i].classList.add("is-in");
					return;
				}

				// Lo que ya está en pantalla al cargar NO se anima: nace visible. Si
				// esperara al observador, el primer bloque bajo cada encabezado
				// tardaba medio segundo en aparecer estando ya a la vista.
				var late = [];
				var limit = window.innerHeight;
				for (var k = 0; k < items.length; k++) {
					var el = items[k];
					if (el.getBoundingClientRect().top < limit) {
						el.classList.add("is-in", "is-instant");
					} else {
						late.push(el);
					}
				}
				requestAnimationFrame(function () {
					requestAnimationFrame(function () {
						var instant = document.querySelectorAll(".is-instant");
						for (var n = 0; n < instant.length; n++) instant[n].classList.remove("is-instant");
					});
				});

				var reveal = function (entries, self) {
					for (var i = 0; i < entries.length; i++) {
						if (!entries[i].isIntersecting) continue;
						entries[i].target.classList.add("is-in");
						self.unobserve(entries[i].target);
					}
				};
				// Texto, fotos y juntas: empiezan apenas asoman. Los listados que se
				// vienen a leer (`fade`) empiezan ANTES de entrar, para que al llegar
				// con un deslizamiento rápido ya estén visibles.
				var onEdge = new IntersectionObserver(reveal, { rootMargin: "0px 0px -4% 0px", threshold: 0 });
				var ahead = new IntersectionObserver(reveal, { rootMargin: "0px 0px 20% 0px", threshold: 0 });
				for (var j = 0; j < late.length; j++) {
					(late[j].getAttribute("data-reveal") === "fade" ? ahead : onEdge).observe(late[j]);
				}
			})();
		</script>

		<script>
			import Lenis from "lenis";

			// --- Scroll con inercia -------------------------------------------
			// Mejora progresiva y solo con puntero fino. En táctil el dedo ya tiene
			// su propia inercia y Lenis no la toca: cargarlo ahí solo dejaba un
			// bucle de animación corriendo sin hacer nada. Con movimiento reducido
			// tampoco se carga.
			const calm = window.matchMedia("(prefers-reduced-motion: reduce)");
			const fine = window.matchMedia("(hover: hover) and (pointer: fine)");
			let lenis: Lenis | null = null;

			if (!calm.matches && fine.matches) {
				// 0.7 s y no más: el scroll es la acción más repetida del sitio.
				// `anchors: true` sin desplazamiento propio: Lenis ya respeta el
				// `scroll-padding-top` del CSS, y sumarle otro dejaba los saltos de
				// ancla 112 px por debajo del encabezado.
				lenis = new Lenis({
					duration: 0.7,
					easing: (t: number) => 1 - Math.pow(1 - t, 3),
					anchors: true,
					autoRaf: true,
				});
				calm.addEventListener("change", (e) => {
					if (e.matches && lenis) {
						lenis.destroy();
						lenis = null;
					}
				});
			}

			// --- Menú móvil ----------------------------------------------------
			// Es un checkbox oculto con un <label> encima, para que funcione sin
			// JavaScript. Aquí se añade lo que el CSS no puede dar: teclado, estado
			// accesible y cierre al navegar. TODO pasa por `setMenu`: cambiar
			// `checked` por código no dispara el evento `change`, y cuando cada
			// camino hacía lo suyo, cerrar con Escape dejaba la página sin scroll.
			const input = document.getElementById("nav-toggle");
			const label = document.querySelector<HTMLElement>(".js-toggle-label");

			if (input instanceof HTMLInputElement && label) {
				const setMenu = (open: boolean) => {
					input.checked = open;
					label.setAttribute("aria-expanded", String(open));
					label.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
					if (lenis) open ? lenis.stop() : lenis.start();
				};

				input.addEventListener("change", () => setMenu(input.checked));

				label.addEventListener("keydown", (event) => {
					if (event.key === "Enter" || event.key === " ") {
						event.preventDefault();
						setMenu(!input.checked);
					}
				});

				document.addEventListener("keydown", (event) => {
					if (event.key === "Escape" && input.checked) {
						setMenu(false);
						label.focus();
					}
				});

				// Tocar un enlace del panel lo cierra, también si es un ancla de la
				// misma página.
				document.querySelectorAll("#site-nav a").forEach((link) => {
					link.addEventListener("click", () => setMenu(false));
				});

				// Al volver con "Atrás" el navegador restaura la página tal como
				// quedó, con el menú abierto: aquí se cierra siempre.
				window.addEventListener("pageshow", () => setMenu(false));

				setMenu(false);
			}

			// --- Visor ampliado --------------------------------------------------
			const dialog = document.querySelector("[data-lightbox]");

			if (dialog instanceof HTMLDialogElement) {
				const photo = dialog.querySelector("img");

				document.addEventListener("click", (event) => {
					const target = event.target instanceof Element ? event.target.closest("a[data-zoom]") : null;
					if (!(target instanceof HTMLAnchorElement) || !photo) return;
					// Con Ctrl, Cmd o botón central el visitante pide otra pestaña
					if (event.ctrlKey || event.metaKey || event.shiftKey) return;
					event.preventDefault();
					photo.src = target.href;
					photo.alt = target.dataset.alt || "";
					dialog.showModal();
					if (lenis) lenis.stop();
				});

				// Un clic sobre el fondo cae en el propio <dialog>; sobre la foto, no.
				dialog.addEventListener("click", (event) => {
					const target = event.target as Element;
					if (target === dialog || target.closest("[data-lightbox-close]")) dialog.close();
				});

				dialog.addEventListener("close", () => {
					if (photo) photo.removeAttribute("src");
					if (lenis) lenis.start();
				});
			}
		</script>
	</body>
</html>
